     "design": {
      "purpose": "Read the unit rate and other points from the graph of a proportional relationship.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "The graph is the third view of a proportional relationship after the table and the equation. The student reads the point where x is 1, which is the unit rate, then another point, then writes the equation. Each graph has a story on its axes, such as pages and minutes, so the unit rate has a meaning.",
      "misconceptions": [
       "Reading the unit rate from the point where y is 1 instead of where x is 1.",
       "Thinking any straight line shows a proportional relationship, even one that does not pass through (0, 0)."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Ratios and Proportional Relationships, 6-7"
      ]
