     "design": {
      "purpose": "Add two three-digit numbers with a sum under 1000, regrouping ones or tens.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "Every sum stays under 1000, within the grade 2 limit, and regroups in at least one place. The boxes above the columns give a place to record a new ten or a new hundred.",
      "misconceptions": [
       "Writes the two-digit sum of a column under that column instead of regrouping.",
       "Forgets to add the regrouped ten or hundred."
      ],
      "references": [
       "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
      ]
