     "stage": "STAGE_GUIDED",
     "design": {
      "purpose": "Locate integers on a number line that runs below zero.",
      "principles": [
       "PRINCIPLE_NUMBER_LINE"
      ],
      "rationale": "The number line runs from −10 to 10 with only every fifth number labeled. Most arrows point left of zero, so the student counts back from 0 or from −5. Counting the unlabeled ticks makes the order of negative numbers concrete.",
      "misconceptions": [
       "Counting left of zero as −0, −1 … so every negative is off by one."
      ]
     },
