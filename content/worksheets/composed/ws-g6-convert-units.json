     "design": {
      "purpose": "Use a conversion rate to change a measurement from one unit to another, both ways.",
      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "Each item gives the conversion rate, so the work is ratio reasoning, not remembering facts. Items switch between going to the smaller and to the larger unit, and the units change every item. That makes the student decide each time whether to multiply or divide.",
      "misconceptions": [
       "Multiplying when converting to a larger unit, so 36 inches becomes 432 feet."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Ratios and Proportional Relationships, 6-7"
      ]
