     "design": {
      "purpose": "Solve linear equations with the variable on both sides.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "Some equations need the distributive property or like terms combined before the variable can be collected, as 8.EE.C.7.b asks. Negative coefficients and solutions come up, so sign errors are practised where they happen. Each item has room for several lines of steps.",
      "misconceptions": [
       "Moving a term across the equals sign without changing its sign.",
       "Multiplying only the first term inside the parentheses."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Expressions and Equations"
      ]
     },
