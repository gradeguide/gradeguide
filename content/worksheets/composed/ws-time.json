     "design": {
      "purpose": "Read an analog clock to the nearest minute.",
      "principles": [
       "PRINCIPLE_PREREQUISITE_REVIEW"
      ],
      "rationale": "3.MD.A.1 asks for time to the nearest minute. The minutes are not on the hour or half hour, so students count by fives and then by ones from the nearest number.",
      "misconceptions": [
       "Reading the hour from the number the hour hand is nearest, even when it has not reached it.",
       "Reading the number the minute hand points to as the minutes: 4 for 20 minutes past."
      ]
