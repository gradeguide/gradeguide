     "fragmentId": "frag-g7-two-step-equations",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Solve equations of the form px + q = r and p(x + q) = r.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "The equations come in the forms the standard names: px + q = r and p(x + q) = r, plus x divided by a number. Some coefficients and solutions are negative, so the student must use the sign rules while solving. There is room to write each step.",
      "misconceptions": [
       "Dividing before subtracting, so only part of the equation is divided.",
       "Distributing p(x + q) to px + q."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Expressions and Equations, 6-8"
      ]
     },
     "estimatedHeight": 724
    }
   ],
   "estimatedHeight": 728
