     "fragmentId": "frag-g7-two-step-inequalities",
     "stage": "STAGE_STRETCH",
     "design": {
      "purpose": "Solve inequalities of the form px + q > r, flipping the sign when dividing by a negative.",
      "principles": [
       "PRINCIPLE_ERROR_ANALYSIS"
      ],
      "rationale": "Inequalities are solved like equations, except the sign flips when both sides are multiplied or divided by a negative. About a third of the items have a negative coefficient, so the flip comes up without being the rule every time. The student graphs each solution on a number line, as the standard asks.",
      "misconceptions": [
       "Keeping the sign the same after dividing by a negative number.",
       "Flipping the sign whenever a negative number appears anywhere.",
       "Using a filled dot for < or > on the graph."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Expressions and Equations, 6-8"
      ]
     },
