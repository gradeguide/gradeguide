     "label": "C",
     "instruction": "Write an equation or inequality. Solve it. Show your work.",
     "items": [
      {
       "label": "13",
       "nodes": [
        {
         "text": "A gym charges $25 to join and $12 a month. Leo has paid $121 in all. How many months has he been a member?"
        },
        {
         "workSpace": {
          "rows": 4,
          "field": {
           "id": "q13",
           "label": "months",
           "answer": {
            "text": "8",
            "also": [
             "8 months"
            ],
            "work": "(121 − 25) ÷ 12"
           }
          }
         }
        }
       ],
       "key": "8"
      },
      {
       "label": "14",
       "nodes": [
        {
         "text": "A rectangle has 2 long sides of 15 cm and 2 short sides. Its perimeter is 54 cm. How long is each short side?"
        },
        {
         "workSpace": {
          "rows": 5,
          "field": {
           "id": "q14",
           "label": "width",
           "answer": {
            "text": "12",
            "also": [
             "12 cm"
            ],
            "work": "(54 − 15 − 15) ÷ 2"
           }
          }
         }
        }
       ],
       "key": "12"
      },
      {
       "label": "15",
       "nodes": [
        {
         "text": "Ana buys 4 notebooks and a $3.50 pen. She spends $13.10. How much is each notebook?"
        },
        {
         "workSpace": {
          "rows": 4,
          "field": {
           "id": "q15",
           "label": "cost of each notebook",
           "answer": {
            "text": "2.40",
            "also": [
             "$2.40",
             "2.4"
            ],
            "work": "(13.10 − 3.50) ÷ 4"
           }
          }
         }
        }
       ],
       "key": "2.40"
      },
      {
       "label": "16",
       "nodes": [
        {
         "text": "Ben has $50 and saves $15 a week. He wants at least $170. Write and solve an inequality for the number of weeks, w."
        },
        {
         "workSpace": {
          "rows": 4,
          "field": {
           "id": "q16",
           "label": "weeks",
           "answer": {
            "text": "8",
            "also": [
             "w ≥ 8",
             "w >= 8",
             "8 weeks or more"
            ],
            "work": "(170 − 50) ÷ 15"
           }
          }
         }
        }
       ],
       "key": "8"
      }
     ],
     "columns": 1,
     "fragmentId": "frag-g7-equation-word-problems",
     "stage": "STAGE_APPLY",
     "design": {
      "purpose": "Write and solve two-step equations for stories, with whole numbers, fractions and decimals.",
      "principles": [
       "PRINCIPLE_INTERLEAVING"
      ],
      "rationale": "These stories turn into the two-step equations practised earlier: a joining fee plus a monthly charge, a perimeter and a total spend. The last story asks for at least an amount, so it is an inequality. The student writes the equation or inequality before solving, which is the skill the standard asks for.",
      "misconceptions": [
       "Writing the steps in the order the numbers appear instead of the order of the story.",
       "Answering an at-least question with an equation and forgetting the solution is a range."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Expressions and Equations, 6-8"
      ]
     },
