     "design": {
      "purpose": "Describe a data set by what was measured, how it was measured, its unit, and the number of values.",
      "principles": [
       "PRINCIPLE_SELF_EXPLANATION"
      ],
      "rationale": "A data summary starts by saying what the numbers are. Each study names a real attribute, a tool and a unit, and the distractors are other things the class might have counted or measured. Counting the values is the number of observations the standard asks students to report.",
      "misconceptions": [
       "Naming the people or things studied as the attribute, such as \"the students\" instead of their plank times.",
       "Leaving off the unit, so 34 could be seconds or minutes."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Statistics and Probability, 6-8"
      ]
     },
