     "stage": "STAGE_GUIDED",
     "design": {
      "purpose": "Label each mark between 0 and 1 with its fraction.",
      "principles": [
       "PRINCIPLE_NUMBER_LINE"
      ],
      "rationale": "Labelling every mark in turn builds 3/4 as three jumps of 1/4, the idea 4.NF.B.3 later uses for adding fractions. The denominator stays the same along a line, so students see the numerator count up by one.",
      "misconceptions": [
       "Writing 1/3, 1/2, 1/1 along a line cut into thirds, changing the denominator instead of the numerator."
      ]
     },
