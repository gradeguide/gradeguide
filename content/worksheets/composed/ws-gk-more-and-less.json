     "fragmentId": "frag-gk-greater-number",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Tell which of two numbers from 1 to 10 is greater.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "Students compare written numerals without pictures, after comparing groups of dots in the section before. The greater number is the one said later when counting. Pairs that differ by 1 make students think about the order of the counting sequence.",
      "misconceptions": [
       "Chooses the number that is written first or looks bigger.",
       "Thinks 10 is less than 9 because 1 is less than 9."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
      ]
     },
