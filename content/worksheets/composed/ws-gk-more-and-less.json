     "fragmentId": "frag-gk-compare-groups",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Tell whether one group has more, fewer or the same number as another.",
      "principles": [
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "The two rows of dots start at the same place and are evenly spaced, so students can match the dots one to one or count each row. About one item in five has equal rows, so same is a real answer and not a trick.",
      "misconceptions": [
       "Judges by how long a row looks rather than by how many dots it has.",
       "Thinks two groups cannot be the same and always marks A or B."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
      ]
     },
