     "stage": "STAGE_INTRODUCE",
     "design": {
      "purpose": "Tell rational numbers from irrational ones by their decimals and square roots.",
      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "The items mix square roots of perfect squares, square roots of other numbers, fractions, ending and repeating decimals, and π. Each kind comes once before any repeats, so the student tests every number against the definition instead of its look. 3.14 sits beside π so the student sees that a rounded value of π is rational.",
      "misconceptions": [
       "Thinking every square root is irrational, such as √49.",
       "Thinking a repeating decimal is irrational because it never ends.",
       "Thinking 3.14 is irrational because it stands for π.",
       "Thinking a negative number cannot be rational."
      ]
     },
     "estimatedHeight": 700
    },
    {
