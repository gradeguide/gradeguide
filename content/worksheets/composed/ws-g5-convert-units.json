            "response": [
             {
              "workSpace": {
               "rows": 3,
               "field": {
                "id": "q15a",
                "label": "grams in 6 boxes",
                "answer": {
                 "text": "2,700",
                 "also": [
                  "2700",
                  "2,700 grams"
                 ],
                 "work": "450 × 6"
                }
               }
              }
             }
            ]
           },
           {
            "label": "15b",
            "prompt": [
             {
              "text": "How many kilograms is that?"
