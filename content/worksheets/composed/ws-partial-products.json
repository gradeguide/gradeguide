     "stage": "STAGE_REVIEW",
     "design": {
      "purpose": "Multiply a one-digit number by a multiple of 10 or 100 using a basic fact.",
      "principles": [
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "Naming the unit (tens, hundreds) keeps the zeros meaningful, so the child is not just told to add zeros.",
      "misconceptions": [
       "Adding a zero for every factor of ten without knowing why, which fails for 5 × 40 = 200."
      ]
     },
