     "design": {
      "purpose": "Tell a statistical question, whose answers vary, from one with a single answer.",
      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "Some questions have answers that vary and some have one answer. The questions are about a student's own class and family, so the difference is easy to picture. This comes first because every later data sheet starts from a statistical question.",
      "misconceptions": [
       "Thinking any question with a number in the answer is statistical."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Statistics and Probability, 6-8"
      ]
