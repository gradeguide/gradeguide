     "fragmentId": "frag-gk-ten-frames",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Read numbers up to 20 from ten frames, seeing 5 and 10 without counting each counter.",
      "principles": [
       "PRINCIPLE_WORKED_EXAMPLE",
       "PRINCIPLE_CONCRETENESS_FADING",
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "A ten frame shows a number against the benchmarks 5 and 10, because each row holds 5 and a full frame holds 10. The worked example models counting on from a full frame. Numbers above 10 show a teen number as 10 and some more, which prepares for teen place value.",
      "misconceptions": [
       "Counts every counter from 1 instead of seeing a full frame as 10.",
       "Counts the empty squares as well as the counters."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
      ]
     },
