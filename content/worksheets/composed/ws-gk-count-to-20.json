     "fragmentId": "frag-gk-count-dots-to-10",
     "stage": "STAGE_INTRODUCE",
     "design": {
      "purpose": "Count up to 10 objects and write how many.",
      "principles": [
       "PRINCIPLE_WORKED_EXAMPLE",
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "Pictures come in small groups of two to five, so students can keep track of which ones they have counted. Counts stay at 10 or under, the range kindergarten expects for counting objects. Writing the numeral after counting links the count to its written form.",
      "misconceptions": [
       "Counts one picture twice or skips a picture.",
       "Says the numbers faster or slower than the pointing, so the count and the pictures do not match.",
       "Counts again from 1 when asked how many, instead of giving the last number said."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking",
       "Gelman and Gallistel (1978), The Child's Understanding of Number, Harvard University Press"
      ]
     },
