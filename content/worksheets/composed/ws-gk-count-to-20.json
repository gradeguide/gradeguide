     "columns": 1,
     "fragmentId": "frag-gk-count-dots-to-20",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Count up to 20 dots in a line or in rows, and write the number.",
      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "The dots appear in a line or in rows, the two arrangements in which kindergarten students count up to 20. A row arrangement lets students count row by row and keep their place. Numbers from 11 to 20 also practise writing the teen numerals.",
      "misconceptions": [
       "Loses track of the start in a line of dots and counts some twice.",
       "Writes a teen number in the order it is said, such as 41 for fourteen."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
      ]
     },
