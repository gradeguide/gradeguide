     "design": {
      "purpose": "Verify that rotations, reflections and translations keep lengths, angle measures and parallel lines.",
      "principles": [
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "A right trapezoid has a horizontal and a vertical side that can be counted on the grid, a right angle, and a pair of parallel sides. Students measure the figure and its image and see that each length, the angle and the parallel pair carry over. This is the evidence the standard asks for before congruence is defined.",
      "misconceptions": [
       "Thinking a side that turns from horizontal to vertical changes length.",
       "Thinking a figure that is turned or flipped is no longer the same shape."
      ]
