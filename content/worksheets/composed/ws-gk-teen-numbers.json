     "stage": "STAGE_INTRODUCE",
     "design": {
      "purpose": "Show numbers from 11 to 19 as ten ones and some more ones.",
      "principles": [
       "PRINCIPLE_WORKED_EXAMPLE",
       "PRINCIPLE_CONCRETENESS_FADING",
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "Each teen number appears as a rod of ten cubes and some single cubes, with an equation such as 14 = 10 + 4. In kindergarten the rod is ten ones joined together, not yet a unit called a ten. Half the equations give the parts and half give the whole, so students work in both directions.",
      "misconceptions": [
       "Reads 14 as 1 and 4 instead of ten and 4.",
       "Writes the teen number in the order it is said, such as 41 for fourteen."
      ],
      "references": [
       "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
      ]
     },
