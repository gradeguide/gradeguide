     "fragmentId": "frag-g1-order-three",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Order three lengths from longest to shortest.",
      "principles": [
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "The three pencils start at the same line and carry no unit marks, so students compare them directly. Finding both the longest and the shortest places all three in order.",
      "misconceptions": [
       "Marks the same pencil as longest and shortest.",
       "Compares where the pencils end without checking that they start together."
      ],
      "references": [
       "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
      ]
     },
     "estimatedHeight": 426
    },
