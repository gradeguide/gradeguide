     "columns": 1,
     "fragmentId": "frag-g1-count-units",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Measure a length by counting equal units laid end to end.",
      "principles": [
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "A row of cubes lies under each pencil, starting where the pencil starts, with no gaps and no overlaps. Students count the cubes to give the length in units. This is the model of measuring that rulers build on in grade 2.",
      "misconceptions": [
       "Counts the lines between cubes instead of the cubes.",
       "Thinks units may have gaps or overlap and still give the length."
      ],
      "references": [
       "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
      ]
     },
