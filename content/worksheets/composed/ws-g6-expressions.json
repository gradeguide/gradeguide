     "design": {
      "purpose": "Name the terms, coefficients and constant of an expression.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "The student names the coefficient, the constant and the number of terms in expressions with two or three terms. One expression has a subtraction, so the constant is negative. These words are used in every later lesson on expressions.",
      "misconceptions": [
       "Calling the variable itself the coefficient."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Expressions and Equations, 6-8"
      ]
