     "fragmentId": "frag-g6-expressions-from-words",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Turn words such as \"less than\" and \"the product of\" into an expression.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "Each phrase uses a different operation word, such as less than, product or divided by. Less than appears with the variable both first and second, because the order is the hardest part. The student writes in a blank so any correct form is accepted.",
      "misconceptions": [
       "Writing \"5 less than y\" as 5 − y."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Expressions and Equations, 6-8"
      ]
     },
