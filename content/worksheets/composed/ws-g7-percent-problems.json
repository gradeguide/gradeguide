       "label": "1",
       "nodes": [
        {
         "text": "A meal costs $48. Sam leaves a 15% tip, which is 0.15 of the cost. What is the total with the tip?"
        },
        {
         "workSpace": {
          "rows": 4,
          "field": {
           "id": "q1",
           "label": "total with tip",
           "answer": {
            "text": "55.20",
            "also": [
             "$55.20",
             "55.2"
            ],
            "work": "48 + 48 × 0.15"
           }
          }
         }
        }
       ],
       "key": "55.20"
      },
      {
       "label": "2",
       "nodes": [
        {
         "text": "A $60 jacket is on sale for 30% off, which is 0.30 of the price. What is the sale price?"
        },
        {
         "workSpace": {
          "rows": 4,
          "field": {
           "id": "q2",
           "label": "sale price",
           "answer": {
            "text": "42",
            "also": [
             "$42"
            ],
            "work": "60 − 60 × 0.30"
           }
          }
         }
        }
       ],
       "key": "42"
      },
      {
       "label": "3",
       "nodes": [
        {
         "text": "A bike costs $250. Sales tax is 8%, which is 0.08 of the price. What is the total cost?"
        },
