          "rows": 4,
          "field": {
           "id": "q3",
           "label": "total cost",
           "answer": {
            "text": "270",
            "also": [
             "$270"
            ],
            "work": "250 + 250 × 0.08"
           }
          }
         }
        }
       ],
       "key": "270"
      },
      {
       "label": "4",
       "nodes": [
        {
         "text": "A store buys a lamp for $40 and marks it up 25% (25 out of every 100). What is the selling price?"
        },
        {
         "workSpace": {
          "rows": 5,
          "field": {
           "id": "q4",
           "label": "selling price",
           "answer": {
            "text": "50",
            "also": [
             "$50"
            ],
            "work": "40 + 40 ÷ 100 × 25"
           }
          }
         }
        }
       ],
       "key": "50"
      }
