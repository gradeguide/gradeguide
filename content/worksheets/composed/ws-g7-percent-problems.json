     "stage": "STAGE_STRETCH",
     "design": {
      "purpose": "Rewrite a percent increase or decrease as a single multiplication.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "Writing p + 0.05p as 1.05p shows that a percent change is one multiplication, which the standard gives as its example. Increases and decreases are mixed, so the student must decide whether to add or subtract the percent from 1. This is the shortcut behind the percent problems earlier on the sheet.",
      "misconceptions": [
       "Writing p − 0.2p as 0.2p.",
       "Writing a 25% increase as 1.25 + p."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Expressions and Equations, 6-8"
      ]
