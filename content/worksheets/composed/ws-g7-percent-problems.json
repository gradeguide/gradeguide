 "pages": [
  {
   "sections": [
    {
     "label": "A",
     "instruction": "Solve. Show your work.",
     "items": [
      {
       "label": "1",
       "nodes": [
        {
         "text": "A meal costs $48. Sam leaves a 15% tip. What is the total with the tip?"
        },
        {
         "workSpace": {
          "rows": 4,
          "field": {
           "id": "q1",
           "label": "total with tip",
           "answer": {
            "text": "55.20",
            "also": [
             "$55.20",
             "55.2"
            ],
            "work": "48 + 48 × 0.15"
           }
          }
         }
        }
       ],
       "key": "55.20"
      },
      {
       "label": "2",
       "nodes": [
        {
         "text": "A $60 jacket is on sale for 30% off. What is the sale price?"
        },
        {
         "workSpace": {
          "rows": 4,
          "field": {
           "id": "q2",
           "label": "sale price",
           "answer": {
            "text": "42",
            "also": [
             "$42",
             "42.00",
             "$42.00"
            ],
            "work": "60 − 60 × 0.30"
           }
          }
         }
        }
       ],
       "key": "42"
      },
      {
       "label": "3",
       "nodes": [
        {
         "text": "A bike costs $250. Sales tax is 8%. What is the total cost?"
        },
        {
         "workSpace": {
          "rows": 4,
          "field": {
           "id": "q3",
           "label": "total cost",
           "answer": {
            "text": "270",
            "also": [
             "$270",
             "270.00",
             "$270.00"
            ],
            "work": "250 + 250 × 0.08"
           }
          }
         }
        }
       ],
       "key": "270"
      },
      {
       "label": "4",
       "nodes": [
        {
         "text": "A store buys a lamp for $40 and marks the price up 25%. What is the selling price?"
        },
        {
         "workSpace": {
          "rows": 4,
          "field": {
           "id": "q4",
           "label": "selling price",
           "answer": {
            "text": "50",
            "also": [
             "$50",
             "50.00",
             "$50.00"
            ],
            "work": "40 + 40 × 0.25"
           }
          }
         }
        }
       ],
       "key": "50"
      }
     ],
     "columns": 1,
     "fragmentId": "frag-g7-percent-word-problems",
     "stage": "STAGE_APPLY",
     "design": {
      "purpose": "Solve multistep percent problems: tax, tips, discounts, markups, percent change and percent error.",
      "principles": [
       "PRINCIPLE_INTERLEAVING"
      ],
      "rationale": "Each story is a kind of percent problem from the grade 7 standard: tip, discount, tax, markup, percent increase and percent error. Most need two steps, finding the percent of the amount and then adding or taking it away. The amounts are easy to multiply, so the student can concentrate on what to do with the percent.",
      "misconceptions": [
       "Finding the percent change from the new amount instead of the original.",
       "Stopping after finding the tip or discount instead of finding the new total.",
       "Taking 30% off by subtracting 30 dollars."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Ratios and Proportional Relationships, 6-7"
      ]
     },
     "estimatedHeight": 706
    }
   ],
   "estimatedHeight": 710
  },
  {
   "sections": [
    {
     "label": "A",
     "instruction": "Solve. Show your work.",
     "items": [
      {
       "label": "5",
       "nodes": [
        {
         "text": "A town grew from 800 people to 920 people. By what percent did it grow?"
        },
        {
         "workSpace": {
          "rows": 5,
          "field": {
           "id": "q5",
           "label": "percent growth",
           "answer": {
            "text": "15",
            "also": [
             "15%"
            ],
            "work": "(920 − 800) ÷ 800 × 100"
           }
          }
         }
        }
       ],
       "key": "15"
      },
      {
       "label": "6",
       "nodes": [
        {
         "text": "Jo guessed that a jar held 80 marbles. It really held 100. What was the percent error of her guess?"
        },
        {
         "workSpace": {
          "rows": 5,
          "field": {
           "id": "q6",
           "label": "percent error",
           "answer": {
            "text": "20",
            "also": [
             "20%"
            ],
            "work": "(100 − 80) ÷ 100 × 100"
           }
          }
         }
        }
       ],
       "key": "20"
      }
     ],
     "columns": 1,
