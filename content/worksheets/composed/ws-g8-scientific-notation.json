     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Write very large and very small numbers in scientific notation.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "Large and small numbers are mixed, so the student decides the sign of the power each time. The explainer ties the power of 10 to how many places the decimal point moves. First factors with up to three digits make the student place the point after the first digit.",
      "misconceptions": [
       "Using a positive power of 10 for a number smaller than 1.",
       "Leaving the front number at 10 or more, such as 12 × 10⁵.",
       "Counting the zeros instead of the places the point moves."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Expressions and Equations"
      ]
     },
     "estimatedHeight": 184
    },
