     "label": "B",
     "instruction": "Solve. Show your work.",
     "items": [
      {
       "label": "9",
       "nodes": [
        {
         "text": "Paint is mixed 2 cups of blue for every 3 cups of white. Mia wants 30 cups of paint in all. How many cups of blue does she need?"
        },
        {
         "workSpace": {
          "rows": 5,
          "field": {
           "id": "q9",
           "label": "cups of blue in 30 cups",
           "answer": {
            "text": "12",
            "also": [
             "12 cups"
            ],
            "work": "30 ÷ (2 + 3) × 2"
           }
          }
         }
        }
       ],
       "key": "12"
      },
      {
       "label": "10",
       "nodes": [
        {
         "multiPartQuestion": {
          "stem": [
           {
            "text": "A pack of 6 juice boxes costs $4.50. A pack of 10 costs $7.00."
           }
          ],
          "parts": [
           {
            "label": "10a",
            "prompt": [
             {
              "text": "How much is one box in the small pack?"
             }
            ],
            "response": [
             {
              "workSpace": {
               "rows": 3,
               "field": {
                "id": "q10a",
                "label": "cost of one box in the small pack",
                "answer": {
                 "text": "0.75",
                 "also": [
                  "$0.75"
                 ],
                 "work": "4.50 ÷ 6"
                }
               }
              }
             }
            ]
           },
           {
            "label": "10b",
            "prompt": [
             {
              "text": "How much is one box in the large pack?"
             }
            ],
            "response": [
             {
              "workSpace": {
               "rows": 3,
               "field": {
                "id": "q10b",
                "label": "cost of one box in the large pack",
                "answer": {
                 "text": "0.70",
                 "also": [
                  "$0.70",
                  "0.7"
                 ],
                 "work": "7.00 ÷ 10"
                }
               }
              }
             }
            ]
           },
           {
            "label": "10c",
            "prompt": [
             {
              "text": "How much less does one box cost in the large pack?"
             }
            ],
            "response": [
             {
              "workSpace": {
               "rows": 3,
               "field": {
                "id": "q10c",
                "label": "saving per box",
                "answer": {
                 "text": "0.05",
                 "also": [
                  "$0.05"
                 ],
                 "work": "0.75 − 0.70"
                }
               }
              }
             }
            ]
           }
          ]
         }
        }
       ],
       "key": "10a: 4.50 ÷ 6 = 0.75; 10b: 7.00 ÷ 10 = 0.70; 10c: 0.75 − 0.70 = 0.05"
      }
