     "fragmentId": "frag-g6-unit-rate",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Find a unit rate by dividing, and use it to find the amount for another number of units.",
      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "Each item splits the work into two steps: find the rate for one, then scale it. Prices, speeds and printing rates use whole-number or cents answers so the student's attention stays on the ratio, not the arithmetic. The contexts change from item to item so the student cannot copy the last answer's form.",
      "misconceptions": [
       "Dividing the smaller number by the larger whatever the question asks.",
       "Multiplying the total by the number of units instead of dividing to get the rate for one."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Ratios and Proportional Relationships, 6-7"
      ]
     },
     "estimatedHeight": 400
    },
    {
     "label": "B",
     "instruction": "Solve. Show your work.",
     "items": [
      {
       "label": "7",
       "nodes": [
        {
         "text": "A recipe uses 3 cups of flour for every 2 cups of sugar. How many cups of sugar go with 12 cups of flour?"
        },
        {
         "workSpace": {
          "rows": 4,
          "field": {
           "id": "q7",
           "label": "cups of sugar for 12 cups of flour",
           "answer": {
            "text": "8",
            "also": [
             "8 cups"
            ],
            "work": "12 ÷ 3 × 2"
           }
          }
         }
        }
       ],
       "key": "8"
      },
      {
       "label": "8",
       "nodes": [
        {
         "text": "A car goes 150 miles on 5 gallons of gas. How far can it go on 8 gallons?"
        },
        {
         "workSpace": {
          "rows": 4,
          "field": {
           "id": "q8",
           "label": "miles on 8 gallons",
           "answer": {
            "text": "240",
            "also": [
             "240 miles"
            ],
            "work": "150 ÷ 5 × 8"
           }
          }
         }
        }
       ],
       "key": "240"
      }
     ],
     "columns": 1,
     "fragmentId": "frag-g6-ratio-word-problems",
     "stage": "STAGE_APPLY",
     "design": {
      "purpose": "Solve ratio and rate problems from stories.",
      "principles": [
       "PRINCIPLE_INTERLEAVING"
      ],
      "rationale": "These stories mix three kinds of ratio problem: scaling a recipe, using a rate, and splitting a total in a given ratio. The last problem compares two unit prices, the everyday use of a unit rate. Plain working space lets the student choose a table, a double number line or division.",
      "misconceptions": [
       "Adding the difference instead of scaling: 3 cups to 2 becomes 12 cups to 11.",
       "Treating a part-to-part ratio as part-to-whole: 2 blue for every 3 white read as 2 out of 3."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Ratios and Proportional Relationships, 6-7"
      ]
     },
     "estimatedHeight": 390
    }
