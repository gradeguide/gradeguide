     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Use the fact that adding in either order gives the same sum.",
      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "Each equation shows the same two numbers on both sides in a different order, with one number missing. Students can answer without computing the sum, which draws attention to the property. Doubles are left out because both orders look the same.",
      "misconceptions": [
       "Writes the sum in the box instead of the missing addend.",
       "Thinks the = sign must be followed by the answer, so an equation with sums on both sides seems wrong."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
      ]
