     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Add three numbers by first adding two that make 10.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "Every item contains two numbers that make 10, and the pair is not always side by side. Students choose which two to add first, which uses the associative and commutative properties without naming them. Adding 10 and a one-digit number is easier than adding the numbers in order.",
      "misconceptions": [
       "Adds only from left to right and misses the ten.",
       "Adds one of the numbers twice after reordering."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
      ]
     },
