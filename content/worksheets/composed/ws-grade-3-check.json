     "fragmentId": "frag-fraction-at-arrow",
     "stage": "STAGE_REVIEW",
     "design": {
      "purpose": "Read a fraction as a distance from 0 on a number line.",
      "principles": [
       "PRINCIPLE_NUMBER_LINE",
       "PRINCIPLE_WORKED_EXAMPLE"
      ],
      "rationale": "The number line shows a fraction as one number with a size, which an area model does not. Students count the spaces between marks, not the marks, so the fraction is a distance from 0. The IES fractions guide recommends the number line as a central representation from grade 3.",
      "misconceptions": [
       "Counting tick marks instead of the spaces between them.",
       "Counting the 0 mark as the first jump."
      ],
      "references": [
       "Siegler et al. (2010), IES practice guide, Developing Effective Fractions Instruction for Kindergarten Through 8th Grade, rec. 2",
       "Common Core Standards Writing Team (2013), Progressions for the Common Core State Standards in Mathematics, Number and Operations—Fractions, 3-5"
      ]
     },
     "estimatedHeight": 180
    },
