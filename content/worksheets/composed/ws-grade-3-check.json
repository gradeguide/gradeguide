     "stage": "STAGE_REVIEW",
     "design": {
      "purpose": "Find an unknown number in a multiplication or division equation.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "The unknown sits in different places, so students treat multiplication and division as one fact family. 3.OA.A.4 lists exactly these forms: 8 × ? = 48, 5 = ? ÷ 3 and 6 × 6 = ?.",
      "misconceptions": [
       "Multiplying the two numbers shown whatever the position of the box: 8 × ? = 24 answered 192.",
       "Reading the equal sign as a signal to write the answer, so a box on the left looks wrong."
      ]
     },
