     "columns": 4,
     "fragmentId": "frag-multiplication-facts",
     "stage": "STAGE_REVIEW",
     "design": {
      "purpose": "Recall multiplication facts with factors from 2 to 9.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "Short, untimed recall strengthens facts more than re-reading them. Facts are drawn from the whole table in random order, so the set shows which facts are not yet automatic.",
      "misconceptions": [
       "Adding instead of multiplying when the facts are mixed with addition elsewhere: 6 × 3 = 9.",
       "Confusing nearby facts, such as 7 × 8 = 54."
      ],
      "references": [
       "Roediger and Karpicke (2006), Psychological Science 17"
      ]
     },
     "estimatedHeight": 190
    },
