         "multiPartQuestion": {
          "stem": [
           {
            "text": "Omar shares $12.60 equally among 4 friends."
           }
          ],
          "parts": [
           {
            "label": "7a",
            "prompt": [
             {
              "text": "How much does each friend get?"
             }
            ],
            "response": [
             {
              "workSpace": {
               "rows": 3,
               "field": {
                "id": "q7a",
                "label": "each friend's share",
                "answer": {
                 "text": "3.15",
                 "also": [
                  "$3.15"
                 ],
                 "work": "12.60 ÷ 4"
                }
               }
              }
             }
            ]
           },
           {
            "label": "7b",
            "prompt": [
             {
              "text": "Each friend spends $1.75. How much does each have left?"
             }
            ],
            "response": [
             {
              "workSpace": {
               "rows": 3,
               "field": {
                "id": "q7b",
                "label": "money left for each friend",
                "answer": {
                 "text": "1.40",
                 "also": [
                  "1.4",
                  "$1.40"
                 ],
                 "work": "3.15 − 1.75"
                }
               }
              }
             }
            ]
           }
          ]
         }
        }
       ],
       "key": "7a: 12.60 ÷ 4 = 3.15; 7b: 3.15 − 1.75 = 1.40"
      }
