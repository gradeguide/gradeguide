     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Multiply and divide signed fractions, where −(p/q) = (−p)/q = p/(−q).",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "Signed fractions use the same sign rules as integers. The fractions are proper and in lowest terms, so the student practises the rule and simplifying the answer, not tidying the question. Division by a fraction is done by multiplying by its reciprocal, as in grade 6.",
      "misconceptions": [
       "Flipping the first fraction instead of the second when dividing.",
       "Thinking −(1/2) and (−1)/2 are different numbers."
      ]
     },
     "estimatedHeight": 178
    },
