     "design": {
      "purpose": "Multiply and divide integers using the sign rules.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "The sign rules for multiplying and dividing are practised on small facts the student already knows, so only the sign is new. Multiplication and division are mixed so the student sees the same rules hold for both. No item multiplies by 1 or −1, so every item requires a computation.",
      "misconceptions": [
       "Thinking two negatives multiply to a negative.",
       "Applying the addition rule and keeping the sign of the larger number."
      ]
     },
