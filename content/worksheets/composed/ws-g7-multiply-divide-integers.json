     "design": {
      "purpose": "Multiply and divide signed decimals.",
      "principles": [
       "PRINCIPLE_INTERLEAVING"
      ],
      "rationale": "Signed decimals finish the set of rational numbers. One factor is a decimal and the other a whole number from 2 to 9, so the place value stays simple and the focus is the sign rule.",
      "misconceptions": [
       "Putting the decimal point in the wrong place after multiplying.",
       "Forgetting that a negative divided by a negative is positive."
      ]
