     "stage": "STAGE_INTRODUCE",
     "design": {
      "purpose": "Describe where a graph is increasing, decreasing or constant, and where it changes fastest.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "The graphs have no numbers, so students read the shape and not the values. Each piece is lettered so students describe one stretch at a time. Asking where the quantity changes fastest connects steepness with rate.",
      "misconceptions": [
       "Reading a graph of distance from home as a picture of the path walked.",
       "Calling a level piece decreasing because it is lower than the piece before it."
      ]
     },
