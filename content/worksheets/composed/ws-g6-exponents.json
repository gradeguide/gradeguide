     "design": {
      "purpose": "Write a repeated product as a base and an exponent.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "Writing a repeated product as a power shows what the exponent counts. The bases and exponents are small so the student sees the pattern, not large numbers.",
      "misconceptions": [
       "Writing the number of times as the base, such as 3 × 3 × 3 × 3 as 4³."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Expressions and Equations, 6-8"
      ]
