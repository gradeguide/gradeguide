     "fragmentId": "frag-g6-evaluate-powers",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Evaluate powers and expressions that contain them, in the right order.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "The items cycle through six forms: a single power, a sum with a power, a power of a sum, a difference, two squares added, and a division by a square. Each form puts the power in a different place, so the student has to apply the order of operations each time. Whole-number answers let the student check their work.",
      "misconceptions": [
       "Reading 5² as 5 × 2.",
       "Working left to right, so 4 + 3 × 2² is 28."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Expressions and Equations, 6-8"
      ]
     },
