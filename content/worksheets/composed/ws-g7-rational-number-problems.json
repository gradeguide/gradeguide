       "label": "2",
       "nodes": [
        {
         "text": "A diver is 30 feet below the surface. She rises 2 1/2 feet each minute. How many minutes until she reaches the surface?"
        },
        {
         "workSpace": {
          "rows": 4,
          "field": {
           "id": "q2",
