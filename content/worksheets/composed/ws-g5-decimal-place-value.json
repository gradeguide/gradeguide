     "columns": 1,
     "fragmentId": "frag-g5-ten-times",
     "stage": "STAGE_INTRODUCE",
     "design": {
      "purpose": "Recognize that a digit is worth 10 times as much as the same digit one place to its right, and 1/10 as much as the same digit one place to its left.",
      "principles": [
       "PRINCIPLE_WORKED_EXAMPLE",
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "Each number has the same digit twice, so the two values differ only by place. Most pairs are one place apart and some are two, which gives 10 times and 100 times. The comparison is asked both ways, as times as much and as a fraction of, because the standard names both.",
      "misconceptions": [
       "Thinking places after the decimal point grow to the right, as tens and hundreds do on the left.",
       "Thinking the digit further right is worth more because it comes later."
      ],
      "references": [
       "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
      ]
     },
     "estimatedHeight": 785
    }
