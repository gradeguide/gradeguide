     "columns": 2,
     "fragmentId": "frag-g5-volume-layers",
     "stage": "STAGE_REVIEW",
     "design": {
      "purpose": "Find volume as the number of cubes in one layer times the number of layers.",
      "principles": [
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "The bottom layer is shaded darker, so students can count one layer. Every layer has the same number of cubes. Multiplying by the number of layers gives the volume, which is the base area times the height.",
      "misconceptions": [
       "Counting the bottom layer as only the front row of cubes."
      ],
      "references": [
       "Common Core Standards Writing Team (2012), Progressions for Geometric Measurement, 3-5"
      ]
     },
     "estimatedHeight": 311
    },
