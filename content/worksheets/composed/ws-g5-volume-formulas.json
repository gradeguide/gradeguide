     "fragmentId": "frag-g5-volume-combined",
     "stage": "STAGE_STRETCH",
     "design": {
      "purpose": "Find the volume of a figure made of two rectangular prisms by adding their volumes.",
      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "Each figure is two prisms of the same width standing side by side. The answer lines ask for each prism and then the whole figure. Volume is additive, so the two volumes add to the total.",
      "misconceptions": [
       "Multiplying the total length by the taller height, as if the figure were one prism."
      ],
      "references": [
       "Common Core Standards Writing Team (2012), Progressions for Geometric Measurement, 3-5"
      ]
     },
     "estimatedHeight": 322
    },
