     "fragmentId": "frag-g5-volume-formula",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Find the volume of a rectangular prism from its edge lengths or its base area.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "Most prisms give three edge lengths. Some give the area of the base and the height, which uses the second formula. The prisms are drawn in proportion to their edge lengths.",
      "misconceptions": [
       "Adding the edge lengths instead of multiplying them.",
       "Multiplying the base area by another edge of the base instead of the height."
      ],
      "references": [
       "Common Core Standards Writing Team (2012), Progressions for Geometric Measurement, 3-5"
      ]
     },
     "estimatedHeight": 460
    }
