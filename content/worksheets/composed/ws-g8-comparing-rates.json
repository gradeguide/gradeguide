        {
         "text": "Car A's distance is d = 55t miles after t hours. Car B goes 186 miles in 3 hours. How many more miles an hour does car B go?"
        },
        {
         "workSpace": {
          "rows": 4,
          "field": {
           "id": "q4",
           "label": "how much faster car B goes",
           "answer": {
            "text": "7",
            "also": [
             "7 miles per hour"
            ],
            "work": "186 ÷ 3 − 55"
           }
          }
         }
        }
       ],
       "key": "7"
      },
      {
       "label": "5",
       "nodes": [
        {
         "text": "Store A sells 6 pounds of rice for $9. Store B's cost is c = 1.40p for p pounds. How much less per pound is store B?"
