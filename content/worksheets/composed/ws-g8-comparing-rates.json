        {
         "workSpace": {
          "rows": 4,
          "field": {
           "id": "q5",
           "label": "how much less per pound at store B",
           "answer": {
            "text": "0.10",
            "also": [
             "$0.10",
             "0.1"
            ],
            "work": "9 ÷ 6 − 1.40"
           }
          }
         }
        }
       ],
