     "fragmentId": "frag-g2-array-sums",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Find the total in an array of up to 5 rows and 5 columns by adding equal rows.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "Each array is matched to a sum of equal addends, one for each row. Arrays stay within 5 by 5, the size grade 2 uses. Repeated addition in arrays prepares for multiplication in grade 3.",
      "misconceptions": [
       "Adds the number of rows and the number of columns.",
       "Writes one addend for each column when the sum is by rows."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
      ]
