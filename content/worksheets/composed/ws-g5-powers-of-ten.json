     "stage": "STAGE_GUIDED",
     "design": {
      "purpose": "Multiply and divide decimals by 10, 100 and 1,000 by moving digits between places.",
      "principles": [
       "PRINCIPLE_CONCRETENESS_FADING",
       "PRINCIPLE_WORKED_EXAMPLE"
      ],
      "rationale": "The chart shows the digits moving while the decimal point stays fixed. The column headings show each place as a power of 10 and as its value. Students write each digit in its new place, including zeros that hold a place.",
      "misconceptions": [
       "Moving the digits the wrong way: to the right to multiply.",
       "Leaving out the zero in the ones place, writing .28 for 2.8 ÷ 10 with no 0 before the point."
      ],
      "references": [
       "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
      ]
