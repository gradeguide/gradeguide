     "columns": 2,
     "fragmentId": "frag-g5-powers-of-ten",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Write powers of 10 with exponents, and multiply and divide whole numbers by powers of 10.",
      "principles": [
       "PRINCIPLE_WORKED_EXAMPLE",
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "Items mix three forms: a power of 10 alone, a number times a power of 10, and a number divided by one. Each form shows the pattern in the number of zeros. The exponent runs from 2 to 5 so the pattern holds beyond 1,000.",
      "misconceptions": [
       "Reading 10³ as 10 × 3 = 30.",
       "Writing one zero too many or too few when the exponent is large."
      ],
      "references": [
       "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
      ]
     },
     "estimatedHeight": 376
    },
