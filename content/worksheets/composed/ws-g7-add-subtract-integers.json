     "stage": "STAGE_GUIDED",
     "design": {
      "purpose": "Add integers by moving along a number line.",
      "principles": [
       "PRINCIPLE_NUMBER_LINE",
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "Grade 7 starts adding negative numbers on a number line, where adding a negative moves left. Each item names the start and the move in words, then asks for the sum, so the student sees that −6 + 7 is a move of 7 to the right from −6. Some moves cross zero, which is where students most often slip.",
      "misconceptions": [
       "Moving right for every addition, even when adding a negative.",
       "Counting the starting tick as the first step of the move."
      ]
     },
     "estimatedHeight": 668
    },
