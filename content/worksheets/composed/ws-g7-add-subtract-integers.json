     "design": {
      "purpose": "Rewrite subtraction as adding the opposite, then add.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "Subtracting a negative number is the hardest sign case, so the student rewrites each subtraction as adding the opposite before working it out. The first box asks only for the opposite, which makes the rewrite a step of its own. After this the student can add using the number line rules from the section before.",
      "misconceptions": [
       "Thinking 3 − (−5) is −2.",
       "Changing the sign of the first number as well as the second."
      ]
