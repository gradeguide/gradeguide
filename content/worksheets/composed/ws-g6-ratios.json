     "columns": 3,
     "fragmentId": "frag-g6-ratio-language",
     "stage": "STAGE_INTRODUCE",
     "design": {
      "purpose": "Write a ratio of two amounts, or of a part to the whole, in the order asked.",
      "principles": [
       "PRINCIPLE_WORKED_EXAMPLE",
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "Ratios start with words before tables or graphs, so this section only asks for the two numbers in the right order. Each story names two kinds of thing, and some ask for a part to the whole, so the student has to read which amounts the question wants. The worked example shows a part-to-whole ratio, the form students most often get wrong.",
      "misconceptions": [
       "Writing the amounts in the order they appear instead of the order asked.",
       "Using a part where the whole is asked for."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Ratios and Proportional Relationships, 6-7"
      ]
     },
     "estimatedHeight": 502
    },
