     "label": "A",
     "instruction": "Write each ratio.",
     "explainer": "A ratio compares two amounts. The order matters: the ratio of cats to dogs is the cats first.",
     "example": {
      "nodes": [
       {
        "text": "There are 7 pencils and 8 pens in the box. Write the ratio of pencils to all the pencils and pens."
       },
       {
        "math": {
         "atoms": [
          {
           "blank": {
            "label": "pencils in the ratio",
            "answer": {
             "text": "7"
            }
           }
          },
          {
           "text": ":"
          },
          {
           "blank": {
            "label": "all the pencils and pens in the ratio",
            "answer": {
             "text": "15"
            }
           }
          }
         ]
        }
       }
      ],
      "text": "The amounts go in the order the sentence names them."
     },
