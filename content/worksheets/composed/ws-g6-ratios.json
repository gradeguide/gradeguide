     "fragmentId": "frag-g6-ratio-table",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Complete a table of equivalent ratios by multiplying both amounts by the same number.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "A ratio table makes equivalent ratios visible as rows that are all the same multiple of the first row. The rows grow by 2, 3 and then larger jumps, so the student must find the multiplier rather than count on. Blanks switch columns so both directions of the ratio are used.",
      "misconceptions": [
       "Adding the same number to both amounts instead of multiplying.",
       "Finding one missing number by adding the gap between rows instead of using the multiplier."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Ratios and Proportional Relationships, 6-7"
      ]
     },
