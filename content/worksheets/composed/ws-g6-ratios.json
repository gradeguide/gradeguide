     "label": "A",
     "instruction": "Write each ratio.",
     "explainer": "A ratio compares two amounts in order. The ratio of cats to dogs has the number of cats first.",
     "example": {
      "nodes": [
       {
        "text": "There are 5 tulips and 7 roses in the garden. Write the ratio of tulips to all the tulips and roses."
       },
       {
        "math": {
         "atoms": [
          {
           "blank": {
            "label": "tulips in the ratio",
            "answer": {
             "text": "5"
            }
           }
          },
          {
           "text": ":"
          },
          {
           "blank": {
            "label": "all the tulips and roses in the ratio",
            "answer": {
             "text": "12"
            }
           }
          }
         ]
        }
       }
      ]
     },
