     "design": {
      "purpose": "Find equivalent ratios on a double number line.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS",
       "PRINCIPLE_NUMBER_LINE"
      ],
      "rationale": "The double number line is the model the standards name for ratio reasoning in grade 6. Equal spacing shows that each tick is one more copy of the first pair. It comes before the table so the student sees the two quantities growing together before working with columns of numbers.",
      "misconceptions": [
       "Counting up by the same amount on both lines instead of by each line's own step."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Ratios and Proportional Relationships, 6-7"
      ]
