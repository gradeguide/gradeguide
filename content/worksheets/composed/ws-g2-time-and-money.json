     "fragmentId": "frag-g2-clock-five-minutes",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Tell time to the nearest five minutes.",
      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "Students count by 5s from 12 to the long hand to find the minutes. Times late in the hour, where the short hand is close to the next number, test whether students read the hour correctly.",
      "misconceptions": [
       "Reads the number the long hand points to as the minutes, such as 4 for 20 minutes.",
       "Late in the hour, reads the hour from the next number."
      ],
      "references": [
       "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
      ]
     },
