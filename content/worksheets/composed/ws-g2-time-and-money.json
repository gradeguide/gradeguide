     "fragmentId": "frag-g2-money-word-problems",
     "stage": "STAGE_APPLY",
     "design": {
      "purpose": "Solve stories about coins and dollar bills.",
      "principles": [
       "PRINCIPLE_INTERLEAVING"
      ],
      "rationale": "Each story states the coin values it uses, so the task is to combine values rather than recall them. Recall is practised in the coin-counting section. The stories include finding a total, finding change and working in whole dollars. Students should write ¢ or $ with the answer.",
      "misconceptions": [
       "Counts each coin as 1 instead of by its value.",
       "Mixes cents and dollars in one answer."
      ],
      "references": [
       "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
      ]
     },
     "estimatedHeight": 234
    }
