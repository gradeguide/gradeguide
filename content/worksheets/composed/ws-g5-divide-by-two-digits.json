     "stage": "STAGE_GUIDED",
     "design": {
      "purpose": "Divide a three-digit number by a two-digit number, estimating each quotient digit from a list of multiples.",
      "principles": [
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "Choosing each quotient digit is the hard step with a two-digit divisor. A short list of 1, 2, 5 and 10 times the divisor turns that choice into a comparison. The list is a place-value strategy the standard names, and it is dropped in the next section.",
      "misconceptions": [
       "Keeping a first estimate that is too big or too small instead of adjusting it.",
       "Writing the first quotient digit over the wrong place of the dividend."
      ],
      "references": [
       "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
      ]
     },
