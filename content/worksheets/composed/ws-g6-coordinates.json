     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Reflect a point across an axis by changing the sign of one coordinate.",
      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "The student plots the reflection on the grid and then writes its coordinates. Seeing the point flip over the axis shows which sign changes. Reflections across both axes are mixed so the student cannot use one rule for all.",
      "misconceptions": [
       "Changing the sign of the coordinate named by the axis: across the x-axis, changing x."
      ]
     },
