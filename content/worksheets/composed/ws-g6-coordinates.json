     "fragmentId": "frag-g6-quadrants",
     "stage": "STAGE_INTRODUCE",
     "design": {
      "purpose": "Name the quadrant of a point from the signs of its coordinates.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "Each point is in a different quadrant, so all four sign patterns appear. The student writes the coordinates before naming the quadrant, so the signs come from reading the grid. The explainer gives the sign pattern for each quadrant to check against.",
      "misconceptions": [
       "Reading the y coordinate first."
      ]
     },
