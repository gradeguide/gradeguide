     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Divide fractions and whole numbers by fractions.",
      "principles": [
       "PRINCIPLE_WORKED_EXAMPLE",
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "The items include a fraction divided by a fraction, a whole number by a fraction, and a fraction by a whole number. All fractions in the questions are in simplest form so the only new skill is the division. The worked example shows the reciprocal step and then reads the answer as how many thirds fit in 5/6, which keeps the meaning of division in view.",
      "misconceptions": [
       "Flipping the first fraction instead of the second.",
       "Expecting a quotient always to be smaller than the number divided."
      ]
     },
