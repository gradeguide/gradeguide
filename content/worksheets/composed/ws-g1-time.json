     "design": {
      "purpose": "Tell time to the hour on an analog clock.",
      "principles": [
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "On the hour, the long hand points to 12 and the short hand points to the hour. Twelve o'clock is left out because the hands lie on top of each other. Students may write 5:00 or 5 o'clock.",
      "misconceptions": [
       "Reads the long hand as the hour.",
       "Writes 12:5 for 5 o'clock, reading both hands as numbers."
      ],
      "references": [
       "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
      ]
