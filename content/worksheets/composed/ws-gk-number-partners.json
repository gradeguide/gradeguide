     "fragmentId": "frag-gk-break-apart",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Break a number up to 10 into two parts in more than one way.",
      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "A number bond shows the whole at the top and its two parts below. The same whole appears with different parts, so students see that a number can be split in several ways. The equation under each bond records the split with the whole first, as in 7 = 3 + 4.",
      "misconceptions": [
       "Adds the whole and the part shown instead of finding the missing part.",
       "Reads 7 = 3 + 4 as wrong because the answer is on the left."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
      ]
     },
     "estimatedHeight": 410
