     "design": {
      "purpose": "Find the number that makes 10 with a number from 1 to 9.",
      "principles": [
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "In a ten frame, the empty squares are the missing part, so students can count them. Pairs that make 10 are the basis of the make-ten strategy for adding within 20 in grade 1.",
      "misconceptions": [
       "Writes the number of counters instead of the number of empty squares.",
       "Counts all ten squares and writes 10."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
      ]
