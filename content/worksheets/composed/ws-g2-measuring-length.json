     "design": {
      "purpose": "Measure a length in inches with a ruler.",
      "principles": [
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "Each bar starts at 0 on the ruler. Students read the length as the number of inch spaces the bar covers, which connects the ruler to the unit cubes of grade 1.",
      "misconceptions": [
       "Starts measuring from 1 instead of 0.",
       "Counts the tick marks instead of the spaces between them."
      ],
      "references": [
       "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
      ]
     },
