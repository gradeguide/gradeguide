     "design": {
      "purpose": "Measure two lengths and find how much longer one is.",
      "principles": [
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "Students record both measurements before finding the difference. The two bars sit on rulers that line up, so the difference can also be seen as the part of bar A that extends past bar B.",
      "misconceptions": [
       "Adds the two lengths instead of finding the difference.",
       "Writes the length of the longer bar as the answer."
      ],
      "references": [
       "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
      ]
