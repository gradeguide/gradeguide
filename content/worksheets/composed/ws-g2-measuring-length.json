     "fragmentId": "frag-g2-two-units",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Understand that measuring with smaller units takes more of them.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "The same length is cut into big units and into small units. Students count both and see that the smaller unit gives the larger number, which explains why 12 inches and 1 foot are the same length.",
      "misconceptions": [
       "Thinks the strip with more units is longer.",
       "Thinks the number of units does not depend on the size of the unit."
      ],
      "references": [
       "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
      ]
     },
