     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Find the least common multiple of two numbers up to 12.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "Both numbers are 12 or less, as the standard asks. Most pairs share a factor, so multiplying the two numbers gives a common multiple that is too big. Pairs where one number divides the other are left out because they are too easy at this grade.",
      "misconceptions": [
       "Multiplying the two numbers, which gives a common multiple but not always the least."
      ]
     },
     "estimatedHeight": 190
    },
