     "design": {
      "purpose": "Expand expressions with negative numbers.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "Expanding with a negative number outside the parentheses is where most sign errors start in algebra. The items mix positive and negative multipliers so the student cannot assume the signs. The worked example in the explainer shows the hardest case, a negative times a subtraction.",
      "misconceptions": [
       "Not multiplying the second term's sign: −2(x − 5) = −2x − 10.",
       "Multiplying only the first term inside: 4(x − 9) = 4x − 9."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Expressions and Equations, 6-8"
      ]
     },
     "estimatedHeight": 216
