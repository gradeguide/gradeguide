      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "Factoring undoes expanding, so it comes after the two sections that build expressions. Each expression has a common factor from 2 to 9, and some have a subtraction inside. Checking by expanding the answer is quick, so the student can catch their own mistakes.",
      "misconceptions": [
       "Taking out a factor that does not divide both terms.",
       "Leaving a 1 out: 6x − 6 = 6(x)."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Expressions and Equations, 6-8"
      ]
