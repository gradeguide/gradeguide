     "fragmentId": "frag-g7-combine-like-terms",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Collect like terms in linear expressions with negative coefficients.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "Each expression has two x terms and two numbers, some negative, so the student must pair terms by kind and carry each sign with its term. The answers are short, so a wrong pairing shows clearly.",
      "misconceptions": [
       "Adding a constant to a coefficient: 3x + 2 = 5x.",
       "Dropping the minus sign in front of a term when moving it next to its like term."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Expressions and Equations, 6-8"
      ]
     },
