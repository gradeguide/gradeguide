     "stage": "STAGE_INTRODUCE",
     "design": {
      "purpose": "Read a multiplication equation as a comparison: 35 = 5 × 7 means 35 is 5 times as many as 7.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "Each item pairs the sentence with its equation, and the unknown moves between the product and each factor, so the child cannot get by matching words to positions.",
      "misconceptions": [
       "Reading \"times as many\" as adding: 3 times as many as 5 is 8."
      ]
     },
