     "fragmentId": "frag-g7-can-it-be-a-triangle",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Decide whether three side lengths make a triangle.",
      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "The rule that the two shorter sides must add to more than the longest is printed on the sheet, so the student practises applying it. Some sets fail by a lot and some only just, so the student must add carefully rather than guess from the look of the numbers.",
      "misconceptions": [
       "Checking that any two sides add to more than the third, but using the two longest.",
       "Thinking sides that add to exactly the longest side make a flat triangle that counts."
      ]
     },
