     "fragmentId": "frag-g7-scale-drawings",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Find real lengths from a scale drawing, and drawing lengths from real ones.",
      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "Half the items go from the drawing to the real length and half go back, so the student cannot just multiply every time. Maps use centimeters for kilometers and floor plans use inches for feet, two scales a student has seen. Some lengths are halves, so the reverse direction needs a division that does not come out whole.",
      "misconceptions": [
       "Multiplying when going from real length to the drawing.",
       "Writing the answer in the drawing's units when the real length is asked for."
      ]
     },
     "estimatedHeight": 502
    },
