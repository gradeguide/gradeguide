     "fragmentId": "frag-g8-exponent-rules",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Use the properties of integer exponents.",
      "principles": [
       "PRINCIPLE_INTERLEAVING"
      ],
      "rationale": "Products, quotients and powers of powers are mixed, so the student picks the rule each time instead of repeating one. Negative and zero exponents come up inside the same items, as 8.EE.A.1 asks. The explainer states the rules in words the student can check each answer against.",
      "misconceptions": [
       "Multiplying the exponents when multiplying powers: 3² × 3⁴ = 3⁸.",
       "Reading 2⁻³ as a negative number.",
       "Thinking a power with exponent 0 is 0."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Expressions and Equations"
      ]
     },
     "estimatedHeight": 380
    },
