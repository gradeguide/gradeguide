     "fragmentId": "frag-g8-roots",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Find square and cube roots of perfect squares and cubes, and solve x² = p and x³ = p.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "Square and cube roots of perfect squares and cubes are mixed with x² = p and x³ = p. Seeing them together shows the student that solving these equations means taking a root. The condition x > 0 keeps to one answer, as grade 8 expects.",
      "misconceptions": [
       "Dividing by 2 or 3 instead of taking the root, so √16 = 8.",
       "Mixing up the square root and the cube root of 64."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Expressions and Equations"
      ]
     },
