     "fragmentId": "frag-g5-decimal-chart",
     "stage": "STAGE_GUIDED",
     "design": {
      "purpose": "Read a decimal to thousandths from a place-value chart and give the value of one digit.",
      "principles": [
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "The chart names each place, so the value of a digit can be read from its column. Some numbers have a zero in a place, which students must keep when they write the number. The chart comes before names and expanded form because it shows the places directly.",
      "misconceptions": [
       "Reading the digit in the tenths place as tens.",
       "Leaving out a zero that holds a place: 0.024 written as 0.24."
      ],
      "references": [
       "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
      ]
     },
     "estimatedHeight": 376
    },
