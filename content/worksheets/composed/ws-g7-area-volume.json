     "stage": "STAGE_APPLY",
     "design": {
      "purpose": "Solve real-world area, surface area and volume problems with composite shapes and prisms.",
      "principles": [
       "PRINCIPLE_INTERLEAVING"
      ],
      "rationale": "The standard asks for real-world problems with shapes made of simpler ones. A room made of two rectangles, a tent shaped like a triangular prism, a box to wrap and a garden bed to fill each need the student to split a shape or pick the right measure. The last story adds a step after the volume, dividing it into bags.",
      "misconceptions": [
       "Adding the two rectangles' lengths instead of their areas.",
       "Not working out an unlabeled side from the labeled ones, such as 8 − 5 = 3.",
       "Using surface area when the question asks how much a shape holds.",
       "Finding a triangular prism's volume as base times height times length without halving."
      ]
     },
