      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "These items practise finding a percent of a number once the meaning is clear. The percents are friendly ones, such as 10%, 25% and 50%, and the wholes make whole-number answers, so the student can reason as well as calculate.",
      "misconceptions": [
       "Dividing by the percent: 20% of 80 written as 80 ÷ 20."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Ratios and Proportional Relationships, 6-7"
      ]
     },
