     "fragmentId": "frag-g6-percent-double-number-line",
     "stage": "STAGE_GUIDED",
     "design": {
      "purpose": "Find a percent of a quantity on a double number line from 0% to 100%.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS",
       "PRINCIPLE_NUMBER_LINE"
      ],
      "rationale": "A percent is a rate per 100, and the double number line shows the whole as 100% with equal steps below it. The student fills one box by counting equal steps, such as tenths or quarters of the whole. This builds the meaning of percent before the shortcut of multiplying by a fraction.",
      "misconceptions": [
       "Putting 100% at the part instead of at the whole."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Ratios and Proportional Relationships, 6-7"
      ]
     },
     "estimatedHeight": 472
    },
