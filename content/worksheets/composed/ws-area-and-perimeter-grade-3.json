     "design": {
      "purpose": "Measure the area of a rectangle by counting unit squares.",
      "principles": [
       "PRINCIPLE_WORKED_EXAMPLE",
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "Students count squares before they are given a formula, so length times width later describes a count they have already made. The example counts by rows, which is the step from counting one by one to multiplying. Side lengths stay at 6 or less so the squares can be counted without losing track.",
      "misconceptions": [
       "Counting the squares along the edges only, which gives a length around the shape instead of an area.",
       "Counting a square twice where a row and a column meet."
      ],
      "references": [
       "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K-5, Geometric Measurement"
      ]
     },
