     "instruction": "Use the tape diagram to solve. Write the answer in the box.",
     "example": {
      "nodes": [
       {
        "text": "Ben has 4 shells. Kai has 3 times as many. How many shells does Kai have?"
       },
       {
        "tapeDiagram": {
         "tapes": [
          {
           "name": "Ben",
           "units": 1,
           "unitText": "4"
          },
          {
           "name": "Kai",
           "units": 3,
           "unitText": "4",
           "totalField": {
            "label": "shells Kai has",
            "answer": {
             "text": "12"
            }
           }
          }
         ]
        }
       }
      ],
      "text": "**3 times as many** is 3 tapes the same length as Ben's: 4 + 4 + 4 = 3 × 4 = 12."
     },
