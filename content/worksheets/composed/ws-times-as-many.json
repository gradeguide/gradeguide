     "design": {
      "purpose": "Solve multiplicative comparison problems with a tape diagram.",
      "principles": [
       "PRINCIPLE_WORKED_EXAMPLE",
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "Tape diagrams separate times as many from more than, which students often solve by adding. The larger tape is drawn as copies of the smaller one, so the multiplication is visible before it is written.",
