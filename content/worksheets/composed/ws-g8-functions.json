     "fragmentId": "frag-g8-function-or-not",
     "stage": "STAGE_INTRODUCE",
     "design": {
      "purpose": "Decide whether a table is a function.",
      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "Tables are the simplest place to check that each input has only one output. Some tables have a repeated output and are still functions, which tests the definition directly. The inputs are not in order, so the student must look for a repeated x.",
      "misconceptions": [
       "Thinking a repeated output means it is not a function.",
       "Thinking the x-values must go up in order."
      ],
      "references": [
       "Common Core Standards Writing Team (2013), Progressions for the Common Core State Standards in Mathematics, Grade 8, High School, Functions"
      ]
     },
     "estimatedHeight": 468
    },
