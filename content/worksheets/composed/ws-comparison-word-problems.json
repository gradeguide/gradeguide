     "design": {
      "purpose": "Read a multiplication equation as a comparison: 35 = 5 × 7 means 35 is 5 times as many as 7.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "Each item pairs a sentence with its equation, and the unknown moves between the product and each factor. Students cannot answer by matching words to positions, so they read what the comparison says. 4.OA.A.1 asks for both directions: sentence to equation and equation to sentence.",
      "misconceptions": [
       "Reading times as many as adding: 3 times as many as 5 is 8.",
       "Reversing the comparison: writing 5 = 3 × 15 for 15 is 3 times as many as 5."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K-5, Operations and Algebraic Thinking"
      ]
     },
