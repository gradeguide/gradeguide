     "design": {
      "purpose": "Solve word problems that compare two amounts by multiplying or dividing.",
      "principles": [
       "PRINCIPLE_INTERLEAVING"
      ],
      "rationale": "The problems ask for the larger amount, the smaller amount, and how many times as many, so students decide between multiplying and dividing from the story. The last problem asks for both a times-as-many and a how-many-more answer, which separates multiplicative from additive comparison. A tape diagram is a useful drawing for each problem.",
      "misconceptions": [
       "Using addition for times as many: 9 times as much as 7 pounds is 16 pounds.",
       "Multiplying whenever the word times appears, including when the larger amount is given: 48 × 6 for the blue ribbon."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K-5, Operations and Algebraic Thinking"
      ]
