     "design": {
      "purpose": "Complete a two-way table and find relative frequencies in a row or column.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "The student fills in the totals first, so the row and column totals are there to divide by. The two fraction questions use different totals: one a column, one a row. The last question asks whether the shares differ, which is how a two-way table shows an association.",
      "misconceptions": [
       "Dividing by the grand total when the question is about one row or column.",
       "Comparing counts instead of fractions when the groups are different sizes."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Statistics and Probability"
      ]
