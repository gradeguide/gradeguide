     "columns": 2,
     "fragmentId": "frag-g5-parentheses",
     "stage": "STAGE_REVIEW",
     "design": {
      "purpose": "Evaluate expressions that contain parentheses.",
      "principles": [
       "PRINCIPLE_WORKED_EXAMPLE",
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "Each expression has one pair of parentheses and two operations, so the only decision is which operation comes first. The parentheses sit at the front in some items and at the end in others. Students who always work left to right get some items wrong, which shows them the parentheses matter.",
      "misconceptions": [
       "Working left to right and ignoring the parentheses: 2 × (3 + 4) worked as 2 × 3 + 4 = 10.",
       "Treating parentheses as a sign to multiply only, and adding first in an expression such as 76 − (4 × 4)."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Operations and Algebraic Thinking, K-5"
      ]
     },
     "estimatedHeight": 138
    },
    {
     "label": "B",
     "instruction": "Write an expression for each calculation. Do not solve.",
     "example": {
      "nodes": [
       {
        "text": "Add 7 and 4, then multiply by 4."
       },
       {
        "math": {
         "atoms": [
          {
           "blank": {
            "label": "the expression",
            "answer": {
             "text": "(7 + 4) × 4",
             "also": [
              "4 × (7 + 4)"
             ]
            }
           }
          }
         ]
        }
       }
      ],
      "text": "The **parentheses** show which part to do first."
     },
     "items": [
