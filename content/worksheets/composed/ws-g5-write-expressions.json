     "columns": 2,
     "fragmentId": "frag-g5-write-expressions",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Write a calculation described in words as a numerical expression.",
      "principles": [
       "PRINCIPLE_WORKED_EXAMPLE",
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "The words give the order of the steps, and the expression must show the same order with symbols. The four forms take turns, so students meet adding first, multiplying first, subtracting then dividing, and doubling a sum. Leaving the expression unsolved keeps attention on its structure.",
      "misconceptions": [
       "Leaving out the parentheses: \"add 8 and 7, then multiply by 2\" written as 8 + 7 × 2.",
       "Writing the numbers in the order they are read for \"subtract 4 from 10\", giving 4 − 10."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Operations and Algebraic Thinking, K-5"
      ]
     },
     "estimatedHeight": 452
    },
