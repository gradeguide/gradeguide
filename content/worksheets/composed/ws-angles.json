     "stage": "STAGE_INTRODUCE",
     "design": {
      "purpose": "Classify angles as acute, right or obtuse by comparing them with a right angle.",
      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "Angles are drawn at different turns and with rays of different lengths, so students judge the opening, not whether one ray is horizontal. A right angle is the benchmark, and students can check it with the corner of a sheet of paper.",
      "misconceptions": [
       "Longer rays make a bigger angle.",
       "An angle is right only when one ray is horizontal."
      ],
      "references": [
       "Common Core Standards Writing Team (2013), Progressions for the Common Core State Standards in Mathematics, K-6, Geometry"
      ]
     },
     "estimatedHeight": 543
    },
