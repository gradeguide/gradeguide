     "design": {
      "purpose": "Use angle addition to find an unknown angle measure.",
      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "4.MD.C.7 treats angle measure as additive. Right and straight angles are wholes students know, so each item is a subtraction from 90 or 180.",
      "misconceptions": [
       "Subtracting from 180 when the whole is a right angle, or from 90 when it is a straight angle.",
       "Measuring the given angle again instead of using the whole."
      ]
