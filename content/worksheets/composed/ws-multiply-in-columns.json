     "design": {
      "purpose": "Multiply a two-digit number by a one-digit number with an area model.",
      "principles": [
       "PRINCIPLE_WORKED_EXAMPLE",
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "The area model shows the distributive property, which the standard algorithm hides. Splitting by place value gives one tens product and one ones product, and 4.NBT.B.5 names the area model as a way to explain the calculation.",
      "misconceptions": [
       "Multiplying only the ones, or treating the tens digit as ones: 28 × 2 = 2 × 2 + 8 × 2.",
       "Writing the two partial products side by side instead of adding them: 40 and 16 give 4016."
      ],
      "references": [
       "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, Number and Operations in Base Ten, K-5"
      ]
     },
