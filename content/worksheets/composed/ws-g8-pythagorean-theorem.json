     "fragmentId": "frag-g8-pythagorean-proof",
     "stage": "STAGE_INTRODUCE",
     "design": {
      "purpose": "Explain the Pythagorean theorem by finding the area of the square on the hypotenuse in two ways.",
      "principles": [
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "This is the area proof found in most grade 8 programs. Students find the large square's area, take away four triangles, and compare what is left with a² + b². Small whole-number legs keep the grid countable, so the result is seen before it is used as a formula.",
      "misconceptions": [
       "Taking the tilted square's side as a + b or as a whole number of grid units.",
       "Subtracting only one triangle from the large square."
      ]
     },
     "estimatedHeight": 588
    }
   ],
   "estimatedHeight": 592
