     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Find the hypotenuse of a right triangle.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "Whole-number triples such as 3, 4, 5 and 8, 15, 17 keep the arithmetic to squares a student can check. Triangles are turned different ways, so the student finds the hypotenuse across from the right angle and not by where it sits. No triangle comes twice.",
      "misconceptions": [
       "Adding the legs instead of their squares.",
       "Forgetting to take the square root at the end."
      ]
     },
