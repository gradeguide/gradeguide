     "stage": "STAGE_APPLY",
     "design": {
      "purpose": "Use an equation to fill in a table, and tell the dependent from the independent variable.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "A story with an equation leads to a table of values. The student fills the table from the equation and then picks the variable that depends on the other. This connects an equation, a table and a situation for the same relationship.",
      "misconceptions": [
       "Choosing the independent variable as the one that depends, because it comes first in the table."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Expressions and Equations, 6-8"
      ]
