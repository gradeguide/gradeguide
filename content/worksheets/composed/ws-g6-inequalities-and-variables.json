   "sections": [
    {
     "label": "A",
     "instruction": "Write an inequality for each situation.",
     "explainer": "\"At least\" means ≥. \"At most\" means ≤. \"More than\" means >. \"Fewer than\" means <.",
     "items": [
      {
       "label": "1",
       "nodes": [
        {
         "text": "Fewer than 25 people fit in the room. Use p for people."
        },
        {
         "math": {
          "atoms": [
           {
            "blank": {
             "id": "q1",
             "label": "Fewer than 25 people fit in the room. Use p for people.",
             "answer": {
              "text": "p < 25",
              "also": [
               "p<25",
               "25 > p",
               "25>p"
              ]
             }
            }
           }
          ]
         }
        }
       ],
       "key": "p < 25"
      },
      {
       "label": "2",
       "nodes": [
        {
         "text": "A bag can hold at most 55 pounds. Use w for weight."
        },
        {
         "math": {
          "atoms": [
           {
            "blank": {
             "id": "q2",
             "label": "A bag can hold at most 55 pounds. Use w for weight.",
             "answer": {
              "text": "w ≤ 55",
              "also": [
               "w≤55",
               "w <= 55",
               "w<=55",
               "55 ≥ w",
               "55≥w"
              ]
             }
            }
           }
          ]
         }
        }
       ],
       "key": "w ≤ 55"
      },
      {
       "label": "3",
       "nodes": [
        {
         "text": "More than 25 students signed up. Use s for students."
        },
        {
         "math": {
          "atoms": [
           {
            "blank": {
             "id": "q3",
             "label": "More than 25 students signed up. Use s for students.",
             "answer": {
              "text": "s > 25",
              "also": [
               "s>25",
               "25 < s",
               "25<s"
              ]
             }
            }
           }
          ]
         }
        }
       ],
       "key": "s > 25"
      },
      {
       "label": "4",
       "nodes": [
        {
         "text": "Riders must be at least 40 inches tall. Use h for height."
        },
        {
         "math": {
          "atoms": [
           {
            "blank": {
             "id": "q4",
             "label": "Riders must be at least 40 inches tall. Use h for height.",
             "answer": {
              "text": "h ≥ 40",
              "also": [
               "h≥40",
               "h >= 40",
               "h>=40",
               "40 ≤ h",
               "40≤h"
              ]
             }
            }
           }
          ]
         }
        }
       ],
       "key": "h ≥ 40"
      },
      {
       "label": "5",
       "nodes": [
        {
         "text": "The temperature stayed above −7°F all night. Use t for temperature."
        },
        {
         "math": {
          "atoms": [
           {
            "blank": {
             "id": "q5",
             "label": "The temperature stayed above −7°F all night. Use t for temperature.",
             "answer": {
              "text": "t > −7",
              "also": [
               "t > -7",
               "t>−7",
               "t>-7"
              ]
             }
            }
           }
          ]
         }
        }
       ],
       "key": "t > −7"
      }
     ],
     "columns": 1,
     "fragmentId": "frag-g6-write-inequalities",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Write an inequality for a limit in a story, and see it has many solutions.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "Each story uses a different limit word: at least, at most, more than, fewer than, above. The explainer pairs each word with its symbol. One story has a negative temperature to link with the integer sheets.",
      "misconceptions": [
       "Using > for \"at least\".",
       "Writing the variable on the wrong side, so p > 35 for fewer than 35."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Expressions and Equations, 6-8"
      ]
     },
     "estimatedHeight": 450
    },
