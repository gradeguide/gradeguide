     "columns": 3,
     "fragmentId": "frag-halves-thirds-fourths",
     "stage": "STAGE_INTRODUCE",
     "design": {
      "purpose": "Name the shaded part of a rectangle cut into halves, thirds or fourths as a fraction.",
      "principles": [
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "Each bar is cut into 2, 3 or 4 equal parts, the denominators grade 3 starts with. The bottom number names the parts in the whole and the top number counts the shaded parts. Keeping the denominators small lets students attend to that meaning before the parts get thin.",
      "misconceptions": [
       "Writing shaded parts over unshaded parts: 1 of 3 shaded is written 1/2.",
       "Naming a part by its count without checking that the parts are equal."
      ],
      "references": [
       "Common Core Standards Writing Team (2013), Progressions for the Common Core State Standards in Mathematics, Number and Operations—Fractions, 3-5"
      ]
     },
     "estimatedHeight": 266
    },
