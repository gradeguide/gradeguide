     "fragmentId": "frag-circle-fractions",
     "stage": "STAGE_GUIDED",
     "design": {
      "purpose": "Name the shaded part of a circle cut into halves, thirds or fourths as a fraction.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "A circle gives the same fractions a second shape, so students attach the fraction to equal parts of a whole rather than to bars. Thirds of a circle look different from thirds of a bar, which shows that equal parts are equal in area, not in shape.",
      "misconceptions": [
       "Treating any three pieces of a circle as thirds, whether or not they are the same size."
      ]
     },
