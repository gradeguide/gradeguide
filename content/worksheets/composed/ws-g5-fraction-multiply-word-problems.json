          }
         }
        }
       ],
       "key": "3/8"
      },
      {
       "label": "4",
       "nodes": [
        {
         "text": "There are 24 students in a class. 5/8 of them walk to school. How many students walk?"
        },
        {
         "workSpace": {
          "rows": 3,
          "field": {
           "id": "q4",
           "label": "students who walk",
           "answer": {
            "text": "15",
            "also": [
             "15 students"
            ],
            "work": "5/8 × 24"
           }
          }
         }
        }
       ],
       "key": "15"
      },
      {
       "label": "5",
       "nodes": [
        {
         "text": "Kai runs 3 times around a track that is 2/5 of a mile long. How far does he run?"
        },
        {
