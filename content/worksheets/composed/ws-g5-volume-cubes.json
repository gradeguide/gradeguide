     "design": {
      "purpose": "Find the volume of a rectangular prism by counting unit cubes.",
      "principles": [
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "Each prism is drawn with its unit cubes on three faces. The top and side faces are shaded differently so the cubes read as solid. Students must count the cubes that are hidden inside, which leads to counting by layers.",
      "misconceptions": [
       "Counting only the cube faces that show.",
       "Counting the edge cubes twice, once on each face."
      ],
      "references": [
       "Common Core Standards Writing Team (2012), Progressions for Geometric Measurement, 3-5"
      ]
     },
