     "instruction": "Write two equations and solve. Show your work.",
     "items": [
      {
       "label": "5",
       "nodes": [
        {
         "multiPartQuestion": {
          "stem": [
           {
            "text": "Adult tickets cost $8 and child tickets $5. A group buys 10 tickets for $65."
           }
          ],
          "parts": [
           {
            "label": "5a",
            "prompt": [
             {
              "text": "How many adult tickets did they buy?"
             }
            ],
            "response": [
             {
              "workSpace": {
               "rows": 6,
               "field": {
                "id": "q5a",
                "label": "adult tickets",
                "answer": {
                 "text": "5",
                 "also": [
                  "5 tickets"
                 ],
                 "work": "(65 − 5 × 10) ÷ (8 − 5)"
                }
               }
              }
             }
            ]
           },
           {
            "label": "5b",
            "prompt": [
             {
              "text": "How many child tickets?"
             }
            ],
            "response": [
             {
              "workSpace": {
               "rows": 3,
               "field": {
                "id": "q5b",
                "label": "child tickets",
                "answer": {
                 "text": "5",
                 "also": [
                  "5 tickets"
                 ],
                 "work": "10 − 5"
                }
               }
              }
             }
            ]
           }
          ]
         }
        }
       ],
       "key": "5a: (65 − 5 × 10) ÷ (8 − 5) = 5; 5b: 10 − 5 = 5"
      },
