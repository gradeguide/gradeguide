     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Solve systems of two linear equations by substitution or elimination.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "Two forms come up: both equations as y = …, solved by setting them equal, and x + y with x − y, solved by adding. These are the simple cases 8.EE.C.8.b expects by inspection or a few steps. The room between the equations and the answers is for those steps.",
      "misconceptions": [
       "Finding x and stopping without finding y.",
       "Adding the equations without lining up like terms."
      ]
