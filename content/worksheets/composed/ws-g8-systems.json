     "label": "C",
     "instruction": "Write a system of equations. Solve it. Show your work.",
     "items": [
      {
       "label": "7",
       "nodes": [
        {
         "multiPartQuestion": {
          "stem": [
           {
            "text": "Adult tickets cost $8 and child tickets $5. A group buys 10 tickets for $65."
           }
          ],
          "parts": [
           {
            "label": "7a",
            "prompt": [
             {
              "text": "How many adult tickets did they buy?"
             }
            ],
            "response": [
             {
              "workSpace": {
               "rows": 4,
               "field": {
                "id": "q7a",
                "label": "adult tickets",
                "answer": {
                 "text": "5",
                 "also": [
                  "5 tickets"
                 ],
                 "work": "(65 − 5 × 10) ÷ (8 − 5)"
                }
               }
              }
             }
            ]
           },
           {
            "label": "7b",
            "prompt": [
             {
              "text": "How many child tickets?"
             }
            ],
            "response": [
             {
              "workSpace": {
               "rows": 2,
               "field": {
                "id": "q7b",
                "label": "child tickets",
                "answer": {
                 "text": "5",
                 "also": [
                  "5 tickets"
                 ],
                 "work": "10 − 5"
                }
               }
              }
             }
            ]
           }
          ]
         }
        }
       ],
       "key": "7a: (65 − 5 × 10) ÷ (8 − 5) = 5; 7b: 10 − 5 = 5"
      },
      {
