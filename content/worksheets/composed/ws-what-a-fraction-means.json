     "design": {
      "purpose": "Name the shaded part of a whole as a fraction.",
      "principles": [
       "PRINCIPLE_WORKED_EXAMPLE",
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "Bars come before number lines because a part of a shape is easier to see than a distance. The denominator changes from item to item, so students read the number of equal parts every time instead of assuming fourths. The worked example names both numbers of the fraction in words.",
      "misconceptions": [
       "Writing shaded parts over unshaded parts: 2 of 6 shaded is written 2/4.",
       "Writing the number of unshaded parts on top."
      ],
      "references": [
       "Siegler et al. (2010), IES practice guide, Developing Effective Fractions Instruction for Kindergarten Through 8th Grade, rec. 2"
      ]
     },
