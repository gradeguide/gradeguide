            "blank": {
             "id": "q1",
             "label": "outcomes: Toss two coins. Find the probability of two heads.",
             "answer": {
              "text": "4"
             }
            }
           }
          ]
         }
        },
        {
         "math": {
          "atoms": [
           {
            "text": "P ="
           },
           {
            "fractionBlank": {
             "id": "q1-2",
             "label": "probability: Toss two coins. Find the probability of two heads.",
             "answer": {
              "text": "1/4"
             }
            }
           }
          ]
         }
        }
       ],
       "key": "Outcomes in the sample space: 4; P = 1/4"
      },
