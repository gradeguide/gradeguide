     "design": {
      "purpose": "Find probabilities of compound events from a sample space.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "Compound events are found by listing the whole sample space. Two number cubes come with a 6-by-6 table to fill in, the model teachers use, and coin events have room for a list or tree. The student counts the outcomes before finding the probability, so the size of the sample space is never guessed.",
      "misconceptions": [
       "Counting heads-tails and tails-heads as one outcome.",
       "Thinking there are 11 equally likely sums for two number cubes.",
       "Adding the probabilities of the two parts instead of counting outcomes."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Statistics and Probability, 6-8"
      ]
     },
