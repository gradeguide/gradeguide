     "label": "A",
     "instruction": "Find the number of outcomes. Then find the probability.",
     "explainer": "Use a list, table or tree diagram to show every outcome.",
     "items": [
      {
       "label": "1",
       "nodes": [
        {
         "text": "Toss two coins. Find the probability of two heads."
        },
        {
         "workSpace": {
          "rows": 3
         }
        },
        {
         "math": {
          "atoms": [
           {
            "text": "Outcomes in the sample space:"
