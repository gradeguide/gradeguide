     "stage": "STAGE_REVIEW",
     "design": {
      "purpose": "Read a number to the thousands from base-ten blocks.",
      "principles": [
       "PRINCIPLE_PREREQUISITE_REVIEW",
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "Blocks show 10 of one unit making the next unit as a size. This is the 2.NBT.A.1 idea that grade 4 place value extends to larger numbers.",
      "misconceptions": [
       "Writing 3 hundreds, 0 tens and 4 ones as 34.",
       "Counting each block as 1 whatever its size."
      ],
      "references": [
       "Fuson and Briars (1990), Journal for Research in Mathematics Education 21"
      ]
     },
