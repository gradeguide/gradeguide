     "fragmentId": "frag-g8-slope-triangles",
     "stage": "STAGE_INTRODUCE",
     "design": {
      "purpose": "Find the slope of a line from the rise and run of a slope triangle.",
      "principles": [
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "A slope triangle on a grid shows the rise and the run as lengths the student can count. Falling lines make the rise negative, so the sign of the slope is seen, not told. This prepares for the formula in the next section.",
      "misconceptions": [
       "Writing run over rise.",
       "Giving a falling line a positive slope.",
       "Counting grid lines instead of the spaces between them."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Expressions and Equations"
      ]
     },
