     "columns": 2,
     "fragmentId": "frag-g5-multiply-by-2-digits",
     "stage": "STAGE_GUIDED",
     "design": {
      "purpose": "Multiply two-digit numbers with the standard algorithm.",
      "principles": [
       "PRINCIPLE_WORKED_EXAMPLE",
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "Each partial product has its own row, labelled with what it stands for, such as 60 × 59. The labels link the algorithm to the place-value strategies from grade 4. Small boxes above the top number hold the regrouped digits.",
      "misconceptions": [
       "Forgetting the zero in the tens row: 23 × 14 with 23 written for 10 × 23.",
       "Adding a regrouped digit from the ones row into the tens row."
      ],
      "references": [
       "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
      ]
     },
