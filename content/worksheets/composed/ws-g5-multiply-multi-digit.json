     "fragmentId": "frag-g5-multiply-3-by-2-digits",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Multiply a three-digit number by a two-digit number with the standard algorithm.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "The steps are the same as for two-digit numbers, with one more digit in each row. Some top numbers contain a zero, which produces a zero in the partial product. The row labels stay, so a wrong row can be traced to its step.",
      "misconceptions": [
       "Skipping a zero digit in the top number and shifting the rest of the row left."
      ],
      "references": [
       "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
      ]
     },
