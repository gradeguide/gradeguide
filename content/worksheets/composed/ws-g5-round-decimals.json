     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Round decimals to the nearest whole number, tenth or hundredth.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE",
       "PRINCIPLE_INTERLEAVING"
      ],
      "rationale": "The three places are mixed, so students read which place each item names before rounding. Some numbers have two more digits than the place they round to. Only the digit right after the rounding place decides the answer.",
      "misconceptions": [
       "Rounding 3.46 to the nearest tenth as 3.4 by dropping the last digit.",
       "Rounding in two steps, 2.449 to 2.45 and then to 2.5, instead of once to 2.4."
      ],
      "references": [
       "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
