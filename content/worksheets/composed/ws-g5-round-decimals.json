     "fragmentId": "frag-g5-round-decimals-line",
     "stage": "STAGE_GUIDED",
     "design": {
      "purpose": "Round a decimal using a number line between the two possible answers.",
      "principles": [
       "PRINCIPLE_NUMBER_LINE",
       "PRINCIPLE_WORKED_EXAMPLE"
      ],
      "rationale": "The number line shows the two possible answers at its ends and the halfway point between them. Students see which end the number is closer to before they apply a rule. The arrow marks the number on the line.",
      "misconceptions": [
       "Rounding by dropping digits, so 3.46 to the nearest tenth becomes 3.4.",
       "Labelling the ends of the line with the wrong place, such as tenths when rounding to hundredths."
      ],
      "references": [
       "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
      ]
     },
     "estimatedHeight": 518
