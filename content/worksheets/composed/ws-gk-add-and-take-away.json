     "design": {
      "purpose": "Add two groups of pictures with a total up to 10.",
      "principles": [
       "PRINCIPLE_WORKED_EXAMPLE",
       "PRINCIPLE_MULTIPLE_REPRESENTATIONS"
      ],
      "rationale": "Each group sits in its own frame, so the two addends stay visible as two parts of the whole. The equation under the pictures connects putting groups together with the + sign. Students may count all the pictures or count on from the first group.",
      "misconceptions": [
       "Counts only one group and writes that number as the total.",
       "Writes one of the two numbers in the equation instead of the total."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
      ]
