     "fragmentId": "frag-g7-unit-rate-fractions",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Find unit rates from ratios of fractions.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "Grade 7 extends unit rates to quantities given as fractions, such as 1/2 mile in 1/4 hour. Every item is a distance or a part of a job in a fraction of an hour, so the student always divides the amount by the time. The answers are whole numbers or simple fractions, so the effort goes into the division of fractions, not into messy arithmetic.",
      "misconceptions": [
       "Dividing the time by the distance, which gives hours per mile.",
       "Multiplying 1/2 by 1/4 because both are fractions, which gives a rate smaller than the distance."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Ratios and Proportional Relationships, 6-7"
      ]
     },
     "estimatedHeight": 504
    },
