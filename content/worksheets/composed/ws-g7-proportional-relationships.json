     "columns": 2,
     "fragmentId": "frag-g7-proportional-or-not",
     "stage": "STAGE_INTRODUCE",
     "design": {
      "purpose": "Decide whether a table shows a proportional relationship.",
      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "A table is the first place grade 7 meets the test for a proportional relationship. Half the tables follow y = kx and half follow y = kx + b, so a table that grows steadily is not enough to say yes. The explainer names the test, y ÷ x in every row, so the student has one test to apply.",
      "misconceptions": [
       "Calling any table that goes up by the same amount proportional, even y = 2x + 3.",
       "Checking only the first row instead of every row."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Ratios and Proportional Relationships, 6-7"
      ]
     },
     "estimatedHeight": 264
    }
