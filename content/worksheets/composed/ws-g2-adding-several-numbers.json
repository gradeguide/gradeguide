     "design": {
      "purpose": "Add four two-digit numbers in columns.",
      "principles": [
       "PRINCIPLE_SYSTEMATIC_VARIATION"
      ],
      "rationale": "Four addends is the most grade 2 asks for. The ones often make 20 or more, so students record 2 tens, not 1.",
      "misconceptions": [
       "Records only 1 ten when the ones make 20 or more.",
       "Loses track of which numbers in a column have been added."
      ],
      "references": [
       "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
      ]
