     "columns": 2,
     "fragmentId": "frag-add-fractions",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Add fractions with the same denominator.",
      "principles": [
       "PRINCIPLE_WORKED_EXAMPLE",
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "Students add counts of the same unit fraction, as the decomposing section prepared. Some sums are greater than 1, so students see that an answer such as 7/6 is a correct fraction. Answers may be left as fractions greater than 1 or written as mixed numbers.",
      "misconceptions": [
       "Adding the denominators too: 2/5 + 1/5 = 3/10."
      ],
      "references": [
       "Common Core Standards Writing Team (2013), Progressions for the Common Core State Standards in Mathematics, Number and Operations—Fractions, 3-5"
      ]
     },
     "estimatedHeight": 178
