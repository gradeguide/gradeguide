     "fragmentId": "frag-compare-any",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Compare two fractions with different numerators and denominators.",
      "principles": [
       "PRINCIPLE_INTERLEAVING"
      ],
      "rationale": "Mixing same-denominator, same-numerator and unlike pairs makes students choose a strategy for each pair, which a set of one type never asks for. Some pairs are equal, so = is a possible answer.",
      "misconceptions": [
       "Comparing only the numerators, or only the denominators.",
       "Judging by the difference between numerator and denominator: 3/4 and 5/6 are equal because each is one part short."
      ],
      "references": [
       "Rohrer and Taylor (2007), Instructional Science 35"
      ]
     },
