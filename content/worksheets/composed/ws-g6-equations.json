     "fragmentId": "frag-g6-expressions-in-stories",
     "stage": "STAGE_APPLY",
     "design": {
      "purpose": "Write an expression with a variable for an amount in a story.",
      "principles": [
       "PRINCIPLE_CONCRETENESS_FADING"
      ],
      "rationale": "Each story uses a variable for an unknown amount: cost, age, equal pieces or growth over time. The stories differ so the student decides which operation the words call for. The answer is an expression, not a number.",
      "misconceptions": [
       "Writing a number instead of an expression with the variable."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Expressions and Equations, 6-8"
      ]
     },
