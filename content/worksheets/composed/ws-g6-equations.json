     "fragmentId": "frag-g6-one-step-equations",
     "stage": "STAGE_PRACTICE",
     "design": {
      "purpose": "Solve one-step equations by doing the inverse operation.",
      "principles": [
       "PRINCIPLE_RETRIEVAL_PRACTICE"
      ],
      "rationale": "The four kinds of one-step equation are mixed: adding, subtracting, multiplying and dividing. All numbers are 0 or more, as the grade 6 standard asks. The explainer names the inverse for each operation.",
      "misconceptions": [
       "Doing the operation shown instead of its inverse: x + 4 = 10 gives x = 14."
      ],
      "references": [
       "Common Core Standards Writing Team (2011), Progressions for Expressions and Equations, 6-8"
      ]
     },
