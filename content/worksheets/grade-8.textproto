# proto-file: worksheet/proto/v1/worksheet.proto
# proto-message: gradeguide.worksheet.v1.Library
#
# Grade 8 sheets: irrational numbers, exponents and scientific notation,
# linear equations and systems, functions, transformations, angles, the
# Pythagorean theorem, volume, and scatter plots and two-way tables.

# The number system.

fragments {
  id: "frag-g8-rational-or-irrational"
  instruction: "Is the number rational or irrational? Check one."
  stage: STAGE_INTRODUCE
  explainer: "A rational number can be written as a fraction of whole numbers. Its decimal ends or repeats."
  items { kind { classify { topic: TOPIC_RATIONAL } } count: 8 min_count: 6 }
  max_columns: 2
  design {
    purpose: "Tell rational numbers from irrational ones by their decimals and square roots."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "The items mix square roots of perfect squares, square roots of other numbers, fractions, ending and repeating decimals, and π. Each kind comes once before any repeats, so the student tests every number against the definition instead of its look. 3.14 sits beside π so the student sees that a rounded value of π is rational."
    misconceptions: "Thinking every square root is irrational, such as √49."
    misconceptions: "Thinking a repeating decimal is irrational because it never ends."
    misconceptions: "Thinking 3.14 is irrational because it stands for π."
    misconceptions: "Thinking a negative number cannot be rational."
  }
}

fragments {
  id: "frag-g8-estimate-roots"
  instruction: "Write the two whole numbers the square root lies between."
  stage: STAGE_PRACTICE
  explainer: "Find the perfect squares on either side: 36 < 40 < 49, so √40 is between 6 and 7."
  items { kind { exponents { mode: MODE_ESTIMATE_ROOT } } count: 6 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Place a square root between two whole numbers to estimate it."
    principles: [PRINCIPLE_NUMBER_LINE]
    rationale: "Placing a square root between two whole numbers depends on knowing the perfect squares up to 144. The explainer shows the root squeezed between two perfect squares, which is how grade 8 estimates irrational numbers. Numbers up to 150 keep to squares a student knows."
    misconceptions: "Halving the number instead of taking its square root, so √40 is near 20."
    misconceptions: "Writing the perfect squares, 36 and 49, instead of their roots, 6 and 7."
  }
}

# Exponents and scientific notation.

fragments {
  id: "frag-g8-exponent-rules"
  instruction: "Write as a single power, or as a fraction."
  stage: STAGE_PRACTICE
  explainer: "Multiplying adds exponents, dividing subtracts them, and a power of a power multiplies them. A negative exponent means the reciprocal: 2⁻³ = 1/2³."
  items { kind { exponents { mode: MODE_RULES } } count: 10 min_count: 6 }
  max_columns: 2
  design {
    purpose: "Use the properties of integer exponents."
    principles: [PRINCIPLE_INTERLEAVING]
    rationale: "Products, quotients and powers of powers are mixed, so the student picks the rule each time instead of repeating one. Negative and zero exponents come up inside the same items, as 8.EE.A.1 asks. The explainer states the rules in words the student can check each answer against."
    misconceptions: "Multiplying the exponents when multiplying powers: 3² × 3⁴ = 3⁸."
    misconceptions: "Reading 2⁻³ as a negative number."
    misconceptions: "Thinking a power with exponent 0 is 0."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Expressions and Equations"
  }
}

fragments {
  id: "frag-g8-roots"
  instruction: "Find the root, or solve."
  stage: STAGE_PRACTICE
  items { kind { exponents { mode: MODE_ROOTS } } count: 8 min_count: 6 }
  max_columns: 2
  design {
    purpose: "Find square and cube roots of perfect squares and cubes, and solve x² = p and x³ = p."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Square and cube roots of perfect squares and cubes are mixed with x² = p and x³ = p. Seeing them together shows the student that solving these equations means taking a root. The condition x > 0 keeps to one answer, as grade 8 expects."
    misconceptions: "Dividing by 2 or 3 instead of taking the root, so √16 = 8."
    misconceptions: "Mixing up the square root and the cube root of 64."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Expressions and Equations"
  }
}

fragments {
  id: "frag-g8-scientific-notation"
  instruction: "Write in scientific notation."
  stage: STAGE_PRACTICE
  explainer: "Move the decimal point until one nonzero digit is to its left. The exponent of 10 is the number of places moved."
  items { kind { scientific_notation { mode: MODE_TO_SCIENTIFIC } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Write very large and very small numbers in scientific notation."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Large and small numbers are mixed, so the student decides the sign of the power each time. The explainer ties the power of 10 to how many places the decimal point moves. First factors with up to three digits make the student place the point after the first digit."
    misconceptions: "Using a positive power of 10 for a number smaller than 1."
    misconceptions: "Leaving the front number at 10 or more, such as 12 × 10⁵."
    misconceptions: "Counting the zeros instead of the places the point moves."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Expressions and Equations"
  }
}

fragments {
  id: "frag-g8-standard-form"
  instruction: "Write in standard form."
  stage: STAGE_PRACTICE
  items { kind { scientific_notation { mode: MODE_TO_STANDARD } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Write a number in scientific notation out in full."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Writing a number out in full reverses the section before, so the student checks the meaning of the power of 10 both ways. Negative powers come up, so the student places zeros after the decimal point."
    misconceptions: "Adding as many zeros as the power instead of moving the point."
    misconceptions: "Moving the point the wrong way for a negative power."
  }
}

fragments {
  id: "frag-g8-how-many-times"
  instruction: "Compare the two numbers."
  stage: STAGE_APPLY
  items { kind { scientific_notation { mode: MODE_COMPARE } } count: 3 min_count: 2 }
  max_columns: 1
  design {
    purpose: "Estimate how many times as large one quantity is as another, using powers of 10."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "8.EE.A.3 asks how many times as large one quantity is as another, each written as a single digit times a power of 10. Each item gives two quantities from one context, such as a town and a country, so the sizes mean something. The student divides the first factors and subtracts the exponents."
    misconceptions: "Subtracting the two numbers instead of dividing them."
    misconceptions: "Answering with the difference of the powers, such as 2, instead of 10²."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Expressions and Equations"
  }
}

fragments {
  id: "frag-g8-operations-scientific"
  instruction: "Multiply or divide. Write the answer in scientific notation."
  stage: STAGE_PRACTICE
  explainer: "Multiply or divide the first factors. Then multiply or divide the powers of 10. Rewrite the answer if the first factor is not between 1 and 10."
  items { kind { scientific_notation { mode: MODE_MULTIPLY } } count: 3 min_count: 2 }
  max_columns: 1
  design {
    purpose: "Multiply numbers written in scientific notation."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Multiplying in scientific notation uses the exponent rule from earlier on the sheet. Some products have a first factor of 10 or more, so the student must rewrite it and adjust the exponent. Three items keep the focus on the method."
    misconceptions: "Multiplying the exponents of 10 instead of adding them."
    misconceptions: "Leaving a front number of 10 or more, such as 12 × 10⁸."
  }
}

fragments {
  id: "frag-g8-divide-scientific"
  instruction: "Divide. Write the answer in scientific notation."
  stage: STAGE_PRACTICE
  items { kind { scientific_notation { mode: MODE_DIVIDE } } count: 3 min_count: 2 }
  max_columns: 1
  design {
    purpose: "Divide numbers written in scientific notation."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Division follows multiplication so the student can compare the two rules. Some quotients have a first factor below 1, so the student must move the point and lower the power by one."
    misconceptions: "Dividing the exponents instead of subtracting them."
    misconceptions: "Subtracting a negative exponent as if it were positive."
  }
}

# Linear relationships.

fragments {
  id: "frag-g8-slope-triangles"
  instruction: "Use the slope triangle to find the slope."
  stage: STAGE_INTRODUCE
  explainer: "Slope is rise over run. Going down is a negative rise. Any slope triangle on the same line gives the same slope."
  items { kind { linear_relation { mode: MODE_SLOPE_TRIANGLE } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Find the slope of a line from the rise and run of a slope triangle."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "A slope triangle on a grid shows the rise and the run as lengths the student can count. Falling lines make the rise negative, so the sign of the slope is seen, not told. This prepares for the formula in the next section."
    misconceptions: "Writing run over rise."
    misconceptions: "Giving a falling line a positive slope."
    misconceptions: "Counting grid lines instead of the spaces between them."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Expressions and Equations"
  }
}

fragments {
  id: "frag-g8-slope-from-points"
  instruction: "Find the slope of the line through the two points."
  stage: STAGE_PRACTICE
  explainer: "Slope = (change in y) ÷ (change in x). Subtract in the same order in both."
  items { kind { linear_relation { mode: MODE_SLOPE } } count: 6 min_count: 4 }
  max_columns: 1
  design {
    purpose: "Find the slope between two points."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "With coordinates and no grid, the student uses the change in y over the change in x. Negative coordinates come up, so subtracting a negative is practised. A line of room under each item is for the two differences."
    misconceptions: "Subtracting the x-values in one order and the y-values in the other."
    misconceptions: "Putting the change in x on top."
  }
}

fragments {
  id: "frag-g8-compare-rates"
  instruction: "Compare the two functions."
  stage: STAGE_PRACTICE
  items { kind { linear_relation { mode: MODE_COMPARE } } count: 3 min_count: 3 }
  max_columns: 1
  design {
    purpose: "Compare the rates of change of two functions given in different forms."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "One function is a table or a graph and the other an equation, as 8.F.A.2 asks. Some tables step x by 2 or start past 0, so the student must divide the change in y by the change in x. Which function changes faster varies from item to item."
    misconceptions: "Taking the step between y-values as the rate when x goes up by 2."
    misconceptions: "Comparing the starting values instead of the rates."
    references: "Common Core Standards Writing Team (2013), Progressions for the Common Core State Standards in Mathematics, Grade 8, High School, Functions"
  }
}

fragments {
  id: "frag-g8-compare-rate-problems"
  instruction: "Solve. Show your work."
  stage: STAGE_APPLY
  max_columns: 1
  design {
    purpose: "Compare two proportional relationships given in different ways."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Each story gives one rate as an equation and the other as a total for an amount, as 8.EE.B.5 asks. The student finds both unit rates before comparing them. Plain working space leaves room for both steps."
    misconceptions: "Comparing a total, such as 186 miles, with a rate, such as 55 miles an hour."
    misconceptions: "Dividing the wrong way, such as hours per mile."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Expressions and Equations"
  }
  items {
    count: 2
    authored {
      items {
        nodes { text: "Car A's distance is d = 55t miles after t hours. Car B goes 186 miles in 3 hours. How many more miles an hour does car B go?" }
        nodes { work_space { field { label: "how much faster car B goes" answer { text: "7" work: "186 ÷ 3 − 55" also: "7 miles per hour" } } } }
      }
      items {
        nodes { text: "Store A sells 6 pounds of rice for $9. Store B's cost is c = 1.40p for p pounds. How much less per pound is store B?" }
        nodes { work_space { field { label: "how much less per pound at store B" answer { text: "0.10" work: "9 ÷ 6 − 1.40" also: "$0.10" also: "0.1" } } } }
      }
    }
  }
}

fragments {
  id: "frag-g8-equations-both-sides"
  instruction: "Solve."
  stage: STAGE_PRACTICE
  explainer: "Move the variable terms to one side and the constants to the other."
  items { kind { solve_equation { form: FORM_BOTH_SIDES negatives: true } } count: 6 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Solve linear equations with the variable on both sides."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Some equations need the distributive property or like terms combined before the variable can be collected, as 8.EE.C.7.b asks. Negative coefficients and solutions come up, so sign errors are practised where they happen. Each item has room for several lines of steps."
    misconceptions: "Moving a term across the equals sign without changing its sign."
    misconceptions: "Multiplying only the first term inside the parentheses."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Expressions and Equations"
  }
}

fragments {
  id: "frag-g8-how-many-solutions"
  instruction: "How many solutions does the equation have? Check one."
  stage: STAGE_STRETCH
  explainer: "Simplify both sides. Different x-terms: one solution. Same x-terms, different numbers: none. Both sides the same: infinitely many."
  items { kind { classify { topic: TOPIC_SOLUTIONS } } count: 4 min_count: 3 }
  max_columns: 1
  design {
    purpose: "Tell whether a linear equation has one solution, no solution or infinitely many."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Six equation shapes, two for each answer, are mixed so the student cannot answer from how the equation looks. The student simplifies both sides and compares the x-terms and the numbers. This is the reasoning 8.EE.C.7.a asks for."
    misconceptions: "Thinking that x-terms cancelling means x = 0."
    misconceptions: "Thinking every equation has exactly one solution."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Expressions and Equations"
  }
}

fragments {
  id: "frag-g8-systems-graph"
  instruction: "Write the point where the lines intersect."
  explainer: "The point of intersection is the solution of the system."
  stage: STAGE_INTRODUCE
  items { kind { linear_relation { mode: MODE_SYSTEM_GRAPH } } count: 2 min_count: 1 }
  max_columns: 2
  design {
    purpose: "Solve a system of two linear equations by reading where their graphs cross."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Reading where two lines cross shows what the solution of a system means before any algebra. The crossing points are whole numbers inside the grid, so the reading is exact. Each line is also given as an equation, so the student can check the point in both."
    misconceptions: "Reading where a line crosses an axis instead of where the lines cross."
    misconceptions: "Writing the coordinates in the wrong order."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Expressions and Equations"
  }
}

fragments {
  id: "frag-g8-systems"
  instruction: "Solve the system."
  stage: STAGE_PRACTICE
  explainer: "If both equations are solved for y, set the expressions equal. If the y-terms are opposites, add the equations."
  items { kind { linear_relation { mode: MODE_SYSTEM } } count: 4 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Solve systems of two linear equations by substitution or elimination."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Two forms come up: both equations as y = …, solved by setting them equal, and x + y with x − y, solved by adding. These are the simple cases 8.EE.C.8.b expects by inspection or a few steps. The room between the equations and the answers is for those steps."
    misconceptions: "Finding x and stopping without finding y."
    misconceptions: "Adding the equations without lining up like terms."
  }
}

fragments {
  id: "frag-g8-system-word-problems"
  instruction: "Write a system of equations. Solve it. Show your work."
  stage: STAGE_APPLY
  max_columns: 1
  design {
    purpose: "Write and solve a system of equations for a story."
    principles: [PRINCIPLE_INTERLEAVING]
    rationale: "Tickets and sharing stickers are stories a grade 8 student knows. Each has two unknowns and two facts, so two equations are the natural model. The parts ask for one unknown at a time, so the student can use the first answer to find the second."
    misconceptions: "Writing one equation with two unknowns and guessing."
    misconceptions: "Using one ticket price for every ticket."
  }
  items {
    count: 2
    authored {
      items {
        nodes {
          multi_part_question {
            stem { text: "Adult tickets cost $8 and child tickets $5. A group buys 10 tickets for $65." }
            parts {
              prompt { text: "How many adult tickets did they buy?" }
              response { work_space { rows: 4 field { label: "adult tickets" answer { text: "5" work: "(65 − 5 × 10) ÷ (8 − 5)" also: "5 tickets" } } } }
            }
            parts {
              prompt { text: "How many child tickets?" }
              response { work_space { rows: 2 field { label: "child tickets" answer { text: "5" work: "10 − 5" also: "5 tickets" } } } }
            }
          }
        }
      }
      items {
        nodes {
          multi_part_question {
            stem { text: "Mia and Leo share 47 stickers between the 2 of them. Mia gets 9 more than Leo." }
            parts {
              prompt { text: "How many stickers does Leo get?" }
              response { work_space { rows: 4 field { label: "Leo's stickers" answer { text: "19" work: "(47 − 9) ÷ 2" } } } }
            }
            parts {
              prompt { text: "How many does Mia get?" }
              response { work_space { rows: 2 field { label: "Mia's stickers" answer { text: "28" work: "19 + 9" } } } }
            }
          }
        }
      }
    }
  }
}

# Functions.

fragments {
  id: "frag-g8-function-or-not"
  instruction: "Is the relation a function? Check one."
  explainer: "A function has exactly one output for each input."
  stage: STAGE_INTRODUCE
  items { kind { classify { topic: TOPIC_FUNCTION } } count: 4 min_count: 2 }
  max_columns: 4
  design {
    purpose: "Decide whether a table is a function."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Tables are the simplest place to check that each input has only one output. Some tables have a repeated output and are still functions, which tests the definition directly. The inputs are not in order, so the student must look for a repeated x."
    misconceptions: "Thinking a repeated output means it is not a function."
    misconceptions: "Thinking the x-values must go up in order."
    references: "Common Core Standards Writing Team (2013), Progressions for the Common Core State Standards in Mathematics, Grade 8, High School, Functions"
  }
}

fragments {
  id: "frag-g8-linear-or-not"
  instruction: "Is the function linear? Check one."
  stage: STAGE_PRACTICE
  explainer: "A linear function can be written y = mx + b. Its graph is a straight line."
  items { kind { classify { topic: TOPIC_LINEAR } } count: 6 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Tell linear functions from nonlinear ones by their equations."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Nine equation forms each appear once before any repeats, including y = a number and y = x divided by a number plus a number. The student decides whether the equation can be written as y = mx + b, not just whether it has an x. Squares, cubes, x times itself and x in the denominator are the nonlinear cases 8.F.A.3 contrasts."
    misconceptions: "Thinking y = 5 is not linear because it has no x."
    misconceptions: "Thinking y = 3/x is linear because x has no power."
    references: "Common Core Standards Writing Team (2013), Progressions for the Common Core State Standards in Mathematics, Grade 8, High School, Functions"
  }
}

fragments {
  id: "frag-g8-line-through-points"
  instruction: "Write the equation of the line."
  stage: STAGE_PRACTICE
  explainer: "Find the slope m first. Then put one point into y = mx + b to find b."
  items { kind { linear_relation { mode: MODE_EQUATION } } count: 4 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Write the equation of a line through two points."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Finding the slope first and then b from one point is the method 8.F.B.4 builds. Points include negative coordinates, and when one has x = 0 the student can read b straight off. Room under each item is for both steps."
    misconceptions: "Using the y of the first point as b when its x is not 0."
    misconceptions: "Finding the slope upside down, as change in x over change in y."
    references: "Common Core Standards Writing Team (2013), Progressions for the Common Core State Standards in Mathematics, Grade 8, High School, Functions"
  }
}

fragments {
  id: "frag-g8-rule-from-table"
  instruction: "Write the rule as y = mx + b."
  stage: STAGE_PRACTICE
  items { kind { rule_table { mode: MODE_FIND_RULE } } count: 3 min_count: 3 }
  max_columns: 4
  design {
    purpose: "Find the rate of change and initial value of a linear function from a table."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Each table comes from a linear rule and sometimes starts at x = 0 and sometimes not. The student reads the rate of change from the steps in y, then works back to b. Negative slopes come up."
    misconceptions: "Taking the first y in the table as b when the table does not start at x = 0."
    misconceptions: "Using the step in y as b."
    references: "Common Core Standards Writing Team (2013), Progressions for the Common Core State Standards in Mathematics, Grade 8, High School, Functions"
  }
}

fragments {
  id: "frag-g8-describe-graph"
  instruction: "Describe each piece of the graph. Check one."
  stage: STAGE_INTRODUCE
  items { kind { sketch_graph { mode: MODE_DESCRIBE } } count: 2 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Describe where a graph is increasing, decreasing or constant, and where it changes fastest."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "The graphs have no numbers, so students read the shape and not the values. Each piece is lettered so students describe one stretch at a time. Asking where the quantity changes fastest connects steepness with rate."
    misconceptions: "Reading a graph of distance from home as a picture of the path walked."
    misconceptions: "Calling a level piece decreasing because it is lower than the piece before it."
  }
}

fragments {
  id: "frag-g8-sketch-graph"
  instruction: "Sketch a graph of the story."
  stage: STAGE_APPLY
  items { kind { sketch_graph { mode: MODE_SKETCH } } count: 4 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Sketch a graph that shows the qualities of a function described in words."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Each story has three or four parts: rising, falling or staying the same, at different speeds. Students choose the direction and steepness of each piece. The axes have no scale, so the sketch shows how the quantity changes and not exact values. The answer key shows one correct sketch."
    misconceptions: "Drawing a level piece as a gap or a point instead of a flat segment."
    misconceptions: "Drawing a faster change with a longer piece instead of a steeper one."
    misconceptions: "Letting the graph go back in time, to the left."
  }
}

# Geometry.

fragments {
  id: "frag-g8-transformations"
  instruction: "Draw the image of triangle ABC. Write the coordinates of A′."
  stage: STAGE_PRACTICE
  items { kind { transformation { mode: MODE_DRAW } } count: 4 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Draw the image of a figure after a translation, reflection, rotation or dilation, and give its coordinates."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Students move each vertex on the grid and join the new points, which is how the move is done by hand before any rule is used. The moves vary from item to item, and the image never overlaps the figure, so each one is seen whole. Writing the coordinates of A′ links the drawing to the coordinate rule for that move."
    misconceptions: "Rotating 90° by swapping x and y without changing a sign."
    misconceptions: "Reflecting across the x-axis by changing the sign of x."
    misconceptions: "Moving the figure the right distance in the wrong direction."
  }
}

fragments {
  id: "frag-g8-name-the-move"
  instruction: "Triangle A′B′C′ is the image of triangle ABC after one move. Name the move."
  stage: STAGE_PRACTICE
  items { kind { transformation { mode: MODE_NAME_MOVE } } count: 4 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Identify a translation, reflection or rotation from a figure and its image."
    principles: [PRINCIPLE_SELF_EXPLANATION]
    rationale: "Working back from an image is the reverse of drawing one. Students first decide whether the figure slid, flipped or turned, then give the detail: the rule for a translation, the axis for a reflection, the angle for a rotation. Matching labels A and A′ show which vertex went where."
    misconceptions: "Calling a 180° rotation a reflection because the figure looks upside down."
    misconceptions: "Reading the translation from A to A′ backwards, giving the opposite signs."
  }
}

fragments {
  id: "frag-g8-transformation-properties"
  instruction: "Count the lengths on the grid. Answer the questions."
  stage: STAGE_INTRODUCE
  explainer: "Rotations, reflections and translations keep lengths and angle measures the same. Parallel lines stay parallel."
  items { kind { transformation { mode: MODE_PROPERTIES } } count: 2 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Verify that rotations, reflections and translations keep lengths, angle measures and parallel lines."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "A right trapezoid has a horizontal and a vertical side that can be counted on the grid, a right angle, and a pair of parallel sides. Students measure the figure and its image and see that each length, the angle and the parallel pair carry over. This is the evidence the standard asks for before congruence is defined."
    misconceptions: "Thinking a side that turns from horizontal to vertical changes length."
    misconceptions: "Thinking a figure that is turned or flipped is no longer the same shape."
  }
}

fragments {
  id: "frag-g8-transformation-sequences"
  instruction: "Do both moves in order. Draw the final image."
  stage: STAGE_PRACTICE
  items { kind { transformation { mode: MODE_DRAW_SEQUENCE } } count: 2 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Carry out a sequence of two moves on a figure."
    principles: [PRINCIPLE_WORKED_EXAMPLE]
    rationale: "Each item is a reflection or rotation followed by a translation. Students draw the first image lightly and move it again, so the second move acts on the image and not on the original. The answer key shows the first image dashed and the final image solid."
    misconceptions: "Applying the second move to the original figure."
    misconceptions: "Doing the moves in the wrong order."
  }
}

fragments {
  id: "frag-g8-name-the-sequence"
  instruction: "Complete the moves that take triangle ABC to triangle A″B″C″."
  stage: STAGE_PRACTICE
  items { kind { transformation { mode: MODE_NAME_SEQUENCE } } count: 2 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Describe a sequence of a reflection and a translation that maps one figure onto another."
    principles: [PRINCIPLE_SELF_EXPLANATION]
    rationale: "Two figures are congruent when a sequence of moves takes one onto the other. Here the sequence is a reflection and then a translation, so students first find which axis gives the right orientation, then find the slide from the reflected A to A″."
    misconceptions: "Finding the translation from A to A″ without reflecting first."
    misconceptions: "Choosing the axis by where the image sits instead of by which way it faces."
  }
}

fragments {
  id: "frag-g8-congruent-or-similar"
  instruction: "Is triangle A′B′C′ congruent or similar to triangle ABC?"
  stage: STAGE_APPLY
  explainer: "Congruent figures have the same shape and size. Similar figures have the same shape; one may be a dilation of the other."
  items { kind { transformation { mode: MODE_CONGRUENT_OR_SIMILAR } } count: 2 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Decide whether two figures are congruent or similar, find the scale factor, and describe a sequence of moves between them."
    principles: [PRINCIPLE_INTERLEAVING]
    rationale: "Congruent and similar pairs are mixed, so students compare side lengths before deciding. A scale factor of 2 or 1/2 keeps every vertex on the grid. Writing the sequence of moves in words is the description the standard asks for, and the answer key gives one correct sequence."
    misconceptions: "Calling a dilated figure congruent because it has the same shape."
    misconceptions: "Giving the scale factor from the image back to the figure, such as 2 for a reduction."
  }
}

fragments {
  id: "frag-g8-triangle-angles"
  instruction: "Find the angle in the box."
  stage: STAGE_PRACTICE
  explainer: "The angles of a triangle add to 180°."
  items { kind { angle_facts { mode: MODE_TRIANGLE_SUM } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Use the triangle angle sum."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Each triangle is drawn to scale, with two angles given and one in a box. The missing angle moves from corner to corner. The drawing lets the student see whether the answer is about the right size."
    misconceptions: "Subtracting only one of the given angles from 180°."
    misconceptions: "Thinking the angles of a triangle add to 360°."
  }
}

fragments {
  id: "frag-g8-exterior-angles"
  instruction: "Find the exterior angle in the box."
  stage: STAGE_PRACTICE
  explainer: "An exterior angle equals the two interior angles across from it, added."
  items { kind { angle_facts { mode: MODE_EXTERIOR } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Find an exterior angle of a triangle from the two interior angles across from it."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "The base runs on past one corner, so the exterior angle is drawn and not just named. The two far angles are given and the angle beside it is not, so the student uses the exterior angle fact. A student can check the answer by finding the third angle and subtracting it from 180°."
    misconceptions: "Adding all three interior angles."
    misconceptions: "Taking the interior angle beside it as the exterior angle."
  }
}

fragments {
  id: "frag-g8-transversals"
  instruction: "The arrows mark parallel lines. Find the angles in the boxes."
  stage: STAGE_PRACTICE
  explainer: "Corresponding and alternate angles are equal. Angles beside each other on a line add to 180°."
  items { kind { angle_facts { mode: MODE_TRANSVERSAL } } count: 4 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Find angles made when a transversal cuts parallel lines."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Each diagram gives one angle and asks for two others, one at each crossing. The student uses vertical, corresponding and alternate angles, and angles on a line. Different slants make the given angle sometimes acute and sometimes obtuse."
    misconceptions: "Thinking all eight angles are equal."
    misconceptions: "Subtracting from 90° instead of 180° for angles on a line."
  }
}

fragments {
  id: "frag-g8-pythagorean-proof"
  instruction: "Find each area. Show your work."
  stage: STAGE_INTRODUCE
  explainer: "Four copies of a right triangle sit inside a large square. The space left over is a square on the hypotenuse."
  items { kind { pythagorean { mode: MODE_SQUARE_AREAS } } count: 2 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Explain the Pythagorean theorem by finding the area of the square on the hypotenuse in two ways."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "This is the area proof found in most grade 8 programs. Students find the large square's area, take away four triangles, and compare what is left with a² + b². Small whole-number legs keep the grid countable, so the result is seen before it is used as a formula."
    misconceptions: "Taking the tilted square's side as a + b or as a whole number of grid units."
    misconceptions: "Subtracting only one triangle from the large square."
  }
}

fragments {
  id: "frag-g8-hypotenuse"
  instruction: "Find the length of the hypotenuse. Use a² + b² = c²."
  stage: STAGE_PRACTICE
  items { kind { pythagorean { mode: MODE_HYPOTENUSE } } count: 4 min_count: 4 }
  max_columns: 3
  design {
    purpose: "Find the hypotenuse of a right triangle."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Whole-number triples such as 3, 4, 5 and 8, 15, 17 keep the arithmetic to squares a student can check. Triangles are turned different ways, so the student finds the hypotenuse across from the right angle and not by where it sits. No triangle comes twice."
    misconceptions: "Adding the legs instead of their squares."
    misconceptions: "Forgetting to take the square root at the end."
  }
}

fragments {
  id: "frag-g8-missing-leg"
  instruction: "Find the missing leg."
  stage: STAGE_PRACTICE
  explainer: "Subtract: b² = c² − a²."
  items { kind { pythagorean { mode: MODE_LEG } } count: 2 min_count: 2 }
  max_columns: 3
  design {
    purpose: "Find a leg of a right triangle from the other leg and the hypotenuse."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Finding a leg reverses the hypotenuse items, so the student subtracts squares instead of adding them. The hypotenuse is labeled in each diagram, so the student must first find which side it is."
    misconceptions: "Adding the squares instead of subtracting them."
    misconceptions: "Subtracting the side lengths instead of their squares."
  }
}

fragments {
  id: "frag-g8-distance-on-grid"
  instruction: "Find the distance between A and B. Draw a right triangle."
  stage: STAGE_APPLY
  items { kind { pythagorean { mode: MODE_DISTANCE } } count: 2 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Use the Pythagorean theorem to find the distance between two points."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Two points on a grid with the segment between them invite the student to draw a right triangle under it. The leg lengths come from counting squares or subtracting coordinates. This joins the theorem to coordinates, as 8.G.B.8 asks."
    misconceptions: "Counting the squares the segment passes through."
    misconceptions: "Adding the leg lengths."
  }
}

fragments {
  id: "frag-g8-volume"
  instruction: "Find the volume. Use 3.14 for π."
  stage: STAGE_PRACTICE
  explainer: "Cylinder: π × r × r × h. Cone: one third of that. Sphere: 4/3 × π × r × r × r."
  items { kind { round_measure { asks: [ASK_CYLINDER, ASK_CONE, ASK_SPHERE] } } count: 6 min_count: 6 }
  max_columns: 2
  design {
    purpose: "Find the volume of cylinders, cones and spheres."
    principles: [PRINCIPLE_INTERLEAVING]
    rationale: "Cylinders, cones and spheres are mixed, so the student chooses the formula from the shape. Cone heights are multiples of 3 and sphere radii are 3 or 6, so the thirds come out exactly with 3.14. Room under each figure is for the multiplications."
    misconceptions: "Forgetting the one third for a cone."
    misconceptions: "Using the diameter as the radius."
    misconceptions: "Squaring the height instead of the radius."
  }
}

# Statistics.

fragments {
  id: "frag-g8-scatter-association"
  instruction: "Check the association the scatter plot shows."
  stage: STAGE_INTRODUCE
  items { kind { linear_relation { mode: MODE_SCATTER } } count: 3 min_count: 2 }
  max_columns: 3
  design {
    purpose: "Describe the association in a scatter plot as positive, negative or none."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Each plot shows one association: positive, negative or none, each once. The axes suit the association, such as days absent against test score. The points scatter around a trend, as real data does."
    misconceptions: "Thinking a negative association means the values are below zero."
    misconceptions: "Thinking the points must lie on a line for there to be an association."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Statistics and Probability"
  }
}

fragments {
  id: "frag-g8-line-of-fit"
  instruction: "Use the line of fit to answer the questions."
  stage: STAGE_PRACTICE
  items { kind { linear_relation { mode: MODE_LINE_OF_FIT } } count: 2 min_count: 1 }
  max_columns: 2
  design {
    purpose: "Find the slope of a line of fit and use it to predict."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "The line of fit is drawn and two points on it are named, so its slope can be found exactly. The student reads the slope as points per hour and uses the line to predict. This is the use of a linear model 8.SP.A.2 and 8.SP.A.3 ask for."
    misconceptions: "Predicting from the nearest data point instead of the line."
    misconceptions: "Reading the slope as the score where the line starts."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Statistics and Probability"
  }
}

fragments {
  id: "frag-g8-linear-models"
  instruction: "Use the linear model to answer the questions."
  stage: STAGE_APPLY
  items { kind { linear_relation { mode: MODE_PREDICT } } count: 3 min_count: 2 }
  max_columns: 1
  design {
    purpose: "Use a linear model to predict, and say what its slope means."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Each model is a short story with an equation. The student predicts a value, then says what the slope and the starting value mean in the story, as 8.SP.A.3 asks. Decimal slopes keep the numbers close to real data."
    misconceptions: "Mixing up the slope and the starting value."
    misconceptions: "Putting the y-value in for x."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Statistics and Probability"
  }
}

fragments {
  id: "frag-g8-two-way-tables"
  instruction: "Complete the totals. Then answer the questions."
  stage: STAGE_PRACTICE
  items { kind { two_way_table {} } count: 2 min_count: 1 }
  max_columns: 1
  design {
    purpose: "Complete a two-way table and find relative frequencies in a row or column."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "The student fills in the totals first, so the row and column totals are there to divide by. The two fraction questions use different totals: one a column, one a row. The last question asks whether the shares differ, which is how a two-way table shows an association."
    misconceptions: "Dividing by the grand total when the question is about one row or column."
    misconceptions: "Comparing counts instead of fractions when the groups are different sizes."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, 6–8, Statistics and Probability"
  }
}

