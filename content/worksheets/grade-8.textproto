# proto-file: worksheet/proto/v1/worksheet.proto
# proto-message: gradeguide.worksheet.v1.Library
#
# Grade 8 sheets: irrational numbers, exponents and scientific notation,
# linear equations and systems, functions, transformations, angles, the
# Pythagorean theorem, volume, and scatter plots and two-way tables.

# The number system.

fragments {
  id: "frag-g8-rational-or-irrational"
  instruction: "Is the number rational or irrational?"
  stage: STAGE_INTRODUCE
  explainer: "A rational number can be written as a fraction of whole numbers. Its decimal ends or repeats."
  items { kind { classify { topic: TOPIC_RATIONAL } } count: 8 min_count: 6 }
  max_columns: 2
  design {
    purpose: "Tell rational numbers from irrational ones by their decimals and square roots."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    misconceptions: "Thinking every square root is irrational, such as √49."
  }
}

fragments {
  id: "frag-g8-estimate-roots"
  instruction: "Between which two whole numbers is the square root?"
  stage: STAGE_PRACTICE
  explainer: "Find the perfect squares on either side: 36 < 40 < 49, so √40 is between 6 and 7."
  items { kind { exponents { mode: MODE_ESTIMATE_ROOT } } count: 6 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Place a square root between two whole numbers to estimate it."
    principles: [PRINCIPLE_NUMBER_LINE]
  }
}

# Exponents and scientific notation.

fragments {
  id: "frag-g8-exponent-rules"
  instruction: "Write as a single power, or as a fraction."
  stage: STAGE_PRACTICE
  explainer: "Multiplying adds exponents, dividing subtracts them, and a power of a power multiplies them. A negative exponent means one over."
  items { kind { exponents { mode: MODE_RULES } } count: 10 min_count: 6 }
  max_columns: 2
  design {
    purpose: "Use the properties of integer exponents."
    principles: [PRINCIPLE_INTERLEAVING]
    misconceptions: "Multiplying the exponents when multiplying powers: 3² × 3⁴ = 3⁸."
    misconceptions: "Reading 2⁻³ as a negative number."
  }
}

fragments {
  id: "frag-g8-roots"
  instruction: "Find the root, or solve."
  stage: STAGE_PRACTICE
  items { kind { exponents { mode: MODE_ROOTS } } count: 8 min_count: 6 }
  max_columns: 2
  design {
    purpose: "Find square and cube roots of perfect squares and cubes, and solve x² = p and x³ = p."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

fragments {
  id: "frag-g8-scientific-notation"
  instruction: "Write in scientific notation."
  stage: STAGE_PRACTICE
  explainer: "Move the decimal point until one nonzero digit is in front of it. The power of 10 counts the moves."
  items { kind { scientific_notation { mode: MODE_TO_SCIENTIFIC } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Write very large and very small numbers in scientific notation."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    misconceptions: "Using a positive power of 10 for a number smaller than 1."
  }
}

fragments {
  id: "frag-g8-standard-form"
  instruction: "Write in standard form."
  stage: STAGE_PRACTICE
  items { kind { scientific_notation { mode: MODE_TO_STANDARD } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Write a number in scientific notation out in full."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

fragments {
  id: "frag-g8-how-many-times"
  instruction: "Compare the two numbers."
  stage: STAGE_APPLY
  items { kind { scientific_notation { mode: MODE_COMPARE } } count: 3 min_count: 2 }
  max_columns: 1
  design {
    purpose: "Estimate how many times as large one quantity is as another, using powers of 10."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
}

fragments {
  id: "frag-g8-operations-scientific"
  instruction: "Multiply or divide. Write the answer in scientific notation."
  stage: STAGE_PRACTICE
  explainer: "Multiply or divide the numbers in front, then the powers of 10. Adjust if the front number is not between 1 and 10."
  items { kind { scientific_notation { mode: MODE_MULTIPLY } } count: 3 min_count: 2 }
  max_columns: 1
  design {
    purpose: "Multiply numbers written in scientific notation."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

fragments {
  id: "frag-g8-divide-scientific"
  instruction: "Divide. Write the answer in scientific notation."
  stage: STAGE_PRACTICE
  items { kind { scientific_notation { mode: MODE_DIVIDE } } count: 3 min_count: 2 }
  max_columns: 1
  design {
    purpose: "Divide numbers written in scientific notation."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

# Linear relationships.

fragments {
  id: "frag-g8-slope-triangles"
  instruction: "Use the slope triangle to find the slope."
  stage: STAGE_INTRODUCE
  explainer: "Slope is rise over run. Going down is a negative rise. Any slope triangle on the same line gives the same slope."
  items { kind { linear_relation { mode: MODE_SLOPE_TRIANGLE } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Find the slope of a line from the rise and run of a slope triangle."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    misconceptions: "Writing run over rise."
  }
}

fragments {
  id: "frag-g8-slope-from-points"
  instruction: "Find the slope of the line through the two points."
  stage: STAGE_PRACTICE
  explainer: "Slope = (change in y) ÷ (change in x). Subtract in the same order in both."
  items { kind { linear_relation { mode: MODE_SLOPE } } count: 6 min_count: 4 }
  max_columns: 1
  design {
    purpose: "Find the slope between two points."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

fragments {
  id: "frag-g8-compare-rates"
  instruction: "Compare the two functions."
  stage: STAGE_PRACTICE
  items { kind { linear_relation { mode: MODE_COMPARE } } count: 2 min_count: 1 }
  max_columns: 1
  design {
    purpose: "Compare the rates of change of two functions given in different forms."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
}

fragments {
  id: "frag-g8-compare-rate-problems"
  instruction: "Solve. Show your work."
  stage: STAGE_APPLY
  max_columns: 1
  design {
    purpose: "Compare two proportional relationships given in different ways."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
  items {
    count: 2
    authored {
      items {
        nodes { text: "Car A's distance is d = 55t miles after t hours. Car B goes 186 miles in 3 hours. How many more miles an hour does car B go?" }
        nodes { work_space { field { label: "how much faster car B goes" answer { text: "7" work: "186 ÷ 3 − 55" also: "7 miles per hour" } } } }
      }
      items {
        nodes { text: "Store A sells 6 pounds of rice for $9. Store B's cost is c = 1.40p for p pounds. How much less per pound is store B?" }
        nodes { work_space { field { label: "how much less per pound at store B" answer { text: "0.10" work: "9 ÷ 6 − 1.40" also: "$0.10" also: "0.1" } } } }
      }
    }
  }
}

fragments {
  id: "frag-g8-equations-both-sides"
  instruction: "Solve."
  stage: STAGE_PRACTICE
  explainer: "Collect the variable on one side and the numbers on the other."
  items { kind { solve_equation { form: FORM_BOTH_SIDES negatives: true } } count: 6 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Solve linear equations with the variable on both sides."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

fragments {
  id: "frag-g8-how-many-solutions"
  instruction: "How many solutions does it have?"
  stage: STAGE_STRETCH
  explainer: "Simplify both sides. Different x-terms: one solution. Same x-terms, different numbers: none. Both sides the same: infinitely many."
  items { kind { classify { topic: TOPIC_SOLUTIONS } } count: 4 min_count: 3 }
  max_columns: 1
  design {
    purpose: "Tell whether a linear equation has one solution, no solution or infinitely many."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
  }
}

fragments {
  id: "frag-g8-systems-graph"
  instruction: "Where do the lines cross? That point solves both equations."
  stage: STAGE_INTRODUCE
  items { kind { linear_relation { mode: MODE_SYSTEM_GRAPH } } count: 2 min_count: 1 }
  max_columns: 2
  design {
    purpose: "Solve a system of two linear equations by reading where their graphs cross."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
}

fragments {
  id: "frag-g8-systems"
  instruction: "Solve the system."
  stage: STAGE_PRACTICE
  explainer: "If both equations say y = …, set them equal. If one adds x and y and the other subtracts, add the equations."
  items { kind { linear_relation { mode: MODE_SYSTEM } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Solve systems of two linear equations by substitution or elimination."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

fragments {
  id: "frag-g8-system-word-problems"
  instruction: "Write two equations and solve. Show your work."
  stage: STAGE_APPLY
  max_columns: 1
  design {
    purpose: "Write and solve a system of equations for a story."
    principles: [PRINCIPLE_INTERLEAVING]
  }
  items {
    count: 2
    authored {
      items {
        nodes {
          multi_part_question {
            stem { text: "Adult tickets cost $8 and child tickets $5. A group buys 10 tickets for $65." }
            parts {
              prompt { text: "How many adult tickets did they buy?" }
              response { work_space { field { label: "adult tickets" answer { text: "5" work: "(65 − 5 × 10) ÷ (8 − 5)" also: "5 tickets" } } } }
            }
            parts {
              prompt { text: "How many child tickets?" }
              response { work_space { field { label: "child tickets" answer { text: "5" work: "10 − 5" also: "5 tickets" } } } }
            }
          }
        }
      }
      items {
        nodes {
          multi_part_question {
            stem { text: "Mia and Leo share 47 stickers between the 2 of them. Mia gets 9 more than Leo." }
            parts {
              prompt { text: "How many stickers does Leo get?" }
              response { work_space { field { label: "Leo's stickers" answer { text: "19" work: "(47 − 9) ÷ 2" } } } }
            }
            parts {
              prompt { text: "How many does Mia get?" }
              response { work_space { field { label: "Mia's stickers" answer { text: "28" work: "19 + 9" } } } }
            }
          }
        }
      }
    }
  }
}

# Functions.

fragments {
  id: "frag-g8-function-or-not"
  instruction: "Is it a function? Each input may have only one output."
  stage: STAGE_INTRODUCE
  items { kind { classify { topic: TOPIC_FUNCTION } } count: 4 min_count: 2 }
  max_columns: 4
  design {
    purpose: "Decide whether a table is a function."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    misconceptions: "Thinking a repeated output means it is not a function."
  }
}

fragments {
  id: "frag-g8-linear-or-not"
  instruction: "Is the function linear?"
  stage: STAGE_PRACTICE
  explainer: "A linear function can be written y = mx + b. Its graph is a straight line."
  items { kind { classify { topic: TOPIC_LINEAR } } count: 6 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Tell linear functions from nonlinear ones by their equations."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
  }
}

fragments {
  id: "frag-g8-line-through-points"
  instruction: "Write the equation of the line."
  stage: STAGE_PRACTICE
  explainer: "Find the slope m first. Then put one point into y = mx + b to find b."
  items { kind { linear_relation { mode: MODE_EQUATION } } count: 4 min_count: 2 }
  max_columns: 1
  design {
    purpose: "Write the equation of a line through two points."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

fragments {
  id: "frag-g8-rule-from-table"
  instruction: "Write the rule as y = mx + b."
  stage: STAGE_PRACTICE
  items { kind { rule_table { mode: MODE_FIND_RULE } } count: 4 min_count: 2 }
  max_columns: 4
  design {
    purpose: "Find the rate of change and initial value of a linear function from a table."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    misconceptions: "Taking the first y in the table as b when the table does not start at x = 0."
  }
}

# Geometry.

fragments {
  id: "frag-g8-transformations"
  instruction: "Draw the image, then write the coordinates of A′."
  stage: STAGE_PRACTICE
  items { kind { coordinate_points { mode: MODE_TRANSFORM } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Find the effect of translations, reflections, rotations and dilations on coordinates."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    misconceptions: "Rotating 90° by swapping x and y without changing a sign."
  }
}

fragments {
  id: "frag-g8-triangle-angles"
  instruction: "Find the angle."
  stage: STAGE_PRACTICE
  explainer: "The angles of a triangle add to 180°. An exterior angle equals the two far interior angles added."
  items { kind { angle_facts { mode: MODE_TRIANGLE_SUM } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Use the triangle angle sum."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

fragments {
  id: "frag-g8-exterior-angles"
  instruction: "Find the exterior angle."
  stage: STAGE_PRACTICE
  items { kind { angle_facts { mode: MODE_EXTERIOR } } count: 4 min_count: 2 }
  max_columns: 1
  design {
    purpose: "Find an exterior angle of a triangle from the two interior angles across from it."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

fragments {
  id: "frag-g8-transversals"
  instruction: "The arrows mark parallel lines. Find the angles in the boxes."
  stage: STAGE_PRACTICE
  explainer: "Corresponding and alternate angles are equal. Angles beside each other on a line add to 180°."
  items { kind { angle_facts { mode: MODE_TRANSVERSAL } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Find angles made when a transversal cuts parallel lines."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
}

fragments {
  id: "frag-g8-hypotenuse"
  instruction: "Find the hypotenuse. a² + b² = c²."
  stage: STAGE_PRACTICE
  items { kind { pythagorean { mode: MODE_HYPOTENUSE } } count: 4 min_count: 2 }
  max_columns: 3
  design {
    purpose: "Find the hypotenuse of a right triangle."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    misconceptions: "Adding the legs instead of their squares."
  }
}

fragments {
  id: "frag-g8-missing-leg"
  instruction: "Find the missing leg."
  stage: STAGE_PRACTICE
  explainer: "Subtract: b² = c² − a²."
  items { kind { pythagorean { mode: MODE_LEG } } count: 3 min_count: 2 }
  max_columns: 3
  design {
    purpose: "Find a leg of a right triangle from the other leg and the hypotenuse."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

fragments {
  id: "frag-g8-distance-on-grid"
  instruction: "Find the distance between A and B. Draw a right triangle to help."
  stage: STAGE_APPLY
  items { kind { pythagorean { mode: MODE_DISTANCE } } count: 2 min_count: 1 }
  max_columns: 2
  design {
    purpose: "Use the Pythagorean theorem to find the distance between two points."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
}

fragments {
  id: "frag-g8-volume"
  instruction: "Find the volume. Use 3.14 for π."
  stage: STAGE_PRACTICE
  explainer: "Cylinder: π × r × r × h. Cone: one third of that. Sphere: 4/3 × π × r × r × r."
  items { kind { round_measure { asks: [ASK_CYLINDER, ASK_CONE, ASK_SPHERE] } } count: 6 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Find the volume of cylinders, cones and spheres."
    principles: [PRINCIPLE_INTERLEAVING]
    misconceptions: "Forgetting the one third for a cone."
  }
}

# Statistics.

fragments {
  id: "frag-g8-scatter-association"
  instruction: "What association does the scatter plot show?"
  stage: STAGE_INTRODUCE
  items { kind { linear_relation { mode: MODE_SCATTER } } count: 3 min_count: 2 }
  max_columns: 3
  design {
    purpose: "Describe the association in a scatter plot as positive, negative or none."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
}

fragments {
  id: "frag-g8-line-of-fit"
  instruction: "Use the line of fit."
  stage: STAGE_PRACTICE
  items { kind { linear_relation { mode: MODE_LINE_OF_FIT } } count: 2 min_count: 1 }
  max_columns: 2
  design {
    purpose: "Find the slope of a line of fit and use it to predict."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
}

fragments {
  id: "frag-g8-linear-models"
  instruction: "Use the model."
  stage: STAGE_APPLY
  items { kind { linear_relation { mode: MODE_PREDICT } } count: 3 min_count: 2 }
  max_columns: 1
  design {
    purpose: "Use a linear model to predict, and say what its slope means."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
  }
}

fragments {
  id: "frag-g8-two-way-tables"
  instruction: "Fill in the totals, then answer."
  stage: STAGE_PRACTICE
  items { kind { two_way_table {} } count: 2 min_count: 1 }
  max_columns: 1
  design {
    purpose: "Complete a two-way table and find relative frequencies in a row or column."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    misconceptions: "Dividing by the grand total when the question is about one row."
  }
}

