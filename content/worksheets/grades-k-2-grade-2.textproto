# proto-file: worksheet/proto/v1/worksheet.proto
# proto-message: gradeguide.worksheet.v1.Library
#
# Grade 2 sheets for the skills grades-2-and-3.textproto does not cover.

# Operations and algebraic thinking.

fragments {
  id: "frag-g2-word-problems-within-100"
  instruction: "Solve. Show your work."
  stage: STAGE_APPLY
  max_columns: 1
  design {
    purpose: "Solve one- and two-step adding and subtracting stories within 100."
    principles: [PRINCIPLE_INTERLEAVING]
    rationale: "The stories mix adding, subtracting, comparing and two steps, so students decide what each one needs. Numbers need regrouping in most stories, which practises grade 2 addition and subtraction in context. The two-step story is split into parts so the first result is recorded before it is used."
    misconceptions: "Adds whenever a story says more, and subtracts whenever it says fewer, without reading what is asked."
    misconceptions: "In a two-step story, stops after the first step."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
    references: "Carpenter, Fennema, Franke, Levi and Empson (1999), Children's Mathematics: Cognitively Guided Instruction, Heinemann"
  }
  items {
    count: 5
    authored {
      items {
        nodes { text: "A class has 27 crayons. The teacher buys 45 more. How many crayons does the class have now?" }
        nodes { work_space { field { label: "crayons the class has" answer { text: "72" work: "27 + 45" also: "72 crayons" } } } }
      }
      items {
        nodes { text: "There are 63 apples in a basket. 28 apples are eaten. How many apples are left?" }
        nodes { work_space { field { label: "apples left" answer { text: "35" work: "63 − 28" also: "35 apples" } } } }
      }
      items {
        nodes { text: "Lena scored 46 points. Omar scored 19 fewer points than Lena. How many points did Omar score?" }
        nodes { work_space { field { label: "points Omar scored" answer { text: "27" work: "46 − 19" also: "27 points" } } } }
      }
      items {
        nodes {
          multi_part_question {
            stem { text: "Kai has 34 cards. He gets 18 more cards. Then he gives 25 cards to his sister." }
            parts {
              prompt { text: "How many cards does Kai have after he gets more?" }
              response { work_space { field { label: "cards after Kai gets more" answer { text: "52" work: "34 + 18" also: "52 cards" } } } }
            }
            parts {
              prompt { text: "How many cards does Kai have at the end?" }
              response { work_space { field { label: "cards Kai has at the end" answer { text: "27" work: "52 − 25" also: "27 cards" } } } }
            }
          }
        }
      }
      items {
        nodes { text: "A bus has 52 seats. 24 children and 9 adults get on. How many seats are empty?" }
        nodes { work_space { field { label: "empty seats" answer { text: "19" work: "52 − 24 − 9" also: "19 seats" } } } }
      }
    }
  }
}

fragments {
  id: "frag-g2-facts-within-20"
  instruction: "Add or subtract."
  max_columns: 3
  stage: STAGE_PRACTICE
  items { kind { add_subtract_fact { max: 20 op: OP_MIXED } } count: 18 }
  design {
    purpose: "Add and subtract within 20 fluently, using mental strategies."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE, PRINCIPLE_INTERLEAVING]
    rationale: "Grade 2 expects fluency with sums and differences within 20. Adding and subtracting are mixed so students read each sign and choose a strategy, such as making ten, doubles or a related addition fact."
    misconceptions: "Counts on or back by ones for every fact instead of using known facts."
    misconceptions: "Counts the starting number when counting back, giving one more than the difference."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-g2-odd-even"
  instruction: "Circle pairs of dots. Mark odd or even."
  stage: STAGE_INTRODUCE
  items { kind { pairs_and_arrays { size { min: 4 max: 20 } mode: MODE_ODD_EVEN } } count: 6 }
  design {
    purpose: "Tell whether a number up to 20 is odd or even by pairing, and write an even number as a sum of two equal addends."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Circling pairs shows whether one dot is left over, which is what makes a number odd. For an even number, students also write it as a double such as 12 = 6 + 6. The doubles link evenness to equal groups, which leads to multiplication in grade 3."
    misconceptions: "Decides odd or even from the size of the number rather than from pairing."
    misconceptions: "Pairs dots across a gap and miscounts the one left over."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-g2-array-sums"
  instruction: "Write the total."
  stage: STAGE_PRACTICE
  items { kind { pairs_and_arrays { size { min: 2 max: 5 } mode: MODE_ARRAY_SUM } } count: 4 }
  design {
    purpose: "Find the total in an array of up to 5 rows and 5 columns by adding equal rows."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Each array is matched to a sum of equal addends, one for each row. Arrays stay within 5 by 5, the size grade 2 uses. Repeated addition in arrays prepares for multiplication in grade 3."
    misconceptions: "Adds the number of rows and the number of columns."
    misconceptions: "Writes one addend for each column when the sum is by rows."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

# Number and operations in base ten.

fragments {
  id: "frag-g2-read-hundreds-blocks"
  instruction: "Write the hundreds, tens and ones. Then write the number."
  stage: STAGE_PRACTICE
  items { kind { place_value_blocks { number { min: 101 max: 499 } mode: MODE_READ_BLOCKS } } count: 3 }
  design {
    purpose: "Read a three-digit number from its hundreds, tens and ones."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Students count the flats, the rods and the cubes, then write the number. Recording each place first shows that each digit counts one kind of block."
    misconceptions: "Writes 2 hundreds, 3 tens and 5 ones as 20035."
    misconceptions: "Counts a flat as 10 because it looks like a row of rods."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g2-hundreds-units"
  instruction: "Write the missing number."
  stage: STAGE_INTRODUCE
  items { kind { place_value_blocks { number { min: 100 max: 900 } mode: MODE_UNITS } } count: 8 }
  design {
    purpose: "Understand 100 as ten tens, and 100, 200 up to 900 as that many hundreds."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "The equations move between tens, hundreds and numbers, such as 10 tens = 1 hundred and 400 = 4 hundreds. This extends the grade 1 idea of a ten as a unit to a hundred as a unit. The item that names 10 tens as a hundred appears only once."
    misconceptions: "Writes 400 hundreds for 400."
    misconceptions: "Thinks 10 tens is 1000."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g2-skip-count"
  instruction: "Skip count. Write the missing numbers."
  stage: STAGE_PRACTICE
  items { kind { count_sequence { start { min: 5 max: 400 } steps: [5, 10, 100] } } count: 8 }
  design {
    purpose: "Skip count by 5s, 10s and 100s within 1000."
    principles: [PRINCIPLE_INTERLEAVING]
    rationale: "The step changes from item to item, so students find it from the numbers shown. Starting numbers are not always multiples of 100, so counts by 10s and 5s cross a hundred."
    misconceptions: "Goes from 195 to 1100 instead of 200."
    misconceptions: "Changes the wrong digit when counting by 10s or 100s."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g2-count-on-to-1000"
  instruction: "Write the missing numbers."
  stage: STAGE_PRACTICE
  items { kind { count_sequence { start { min: 150 max: 950 } steps: [1] cross_hundred: true } } count: 4 }
  design {
    purpose: "Count on by ones across a hundred, up to 1000."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Every sequence starts two to four numbers before a hundred, so the missing numbers cross it, as in 298, 299, 300. Crossing a hundred is where counting errors are most common."
    misconceptions: "Writes 2910 or 2100 after 299."
    misconceptions: "Changes the hundreds digit but not the tens digit, writing 390 after 299."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g2-expanded-to-number"
  instruction: "Write the number."
  stage: STAGE_PRACTICE
  items { kind { number_forms { mode: MODE_EXPANDED_TO_NUMBER } } count: 4 }
  design {
    purpose: "Write a number from its expanded form."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Some expanded forms leave out a place, such as 800 + 50, so students must write a 0 to hold the place."
    misconceptions: "Writes 400 + 6 as 46."
    misconceptions: "Writes the parts side by side, such as 800501 for 800 + 50 + 1."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g2-number-to-expanded"
  instruction: "Write the number in expanded form."
  stage: STAGE_PRACTICE
  items { kind { number_forms { mode: MODE_NUMBER_TO_EXPANDED } } count: 4 }
  design {
    purpose: "Write a three-digit number as hundreds plus tens plus ones."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Writing each digit as the value it stands for, such as 400 for the 4 in 473, makes the value of each place explicit."
    misconceptions: "Writes the digits, such as 4 + 7 + 3, instead of their values."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g2-words-to-number"
  instruction: "Write the number."
  stage: STAGE_PRACTICE
  items { kind { number_forms { mode: MODE_WORDS_TO_NUMBER } } count: 4 }
  design {
    purpose: "Read a number written in words and write it in digits."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Number names include ones with a zero place, such as five hundred one, where the spoken name gives no word for the missing tens."
    misconceptions: "Writes five hundred one as 51 or 5001."
    misconceptions: "Writes the teen part in spoken order, such as 571 for five hundred seventeen."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g2-compare-three-digit"
  instruction: "Compare. Write <, > or =."
  stage: STAGE_PRACTICE
  items { kind { compare_numbers { numbers { min: 100 max: 999 } symbols: true } } count: 10 }
  design {
    purpose: "Compare three-digit numbers with <, > and =."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Students compare the hundreds first, then the tens, then the ones. Pairs such as 593 and 600 have larger tens and ones in the smaller number, which tests whether students compare by place."
    misconceptions: "Thinks 289 is greater than 312 because 8 and 9 are large digits."
    misconceptions: "Reverses the symbols."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g2-add-3-digit"
  instruction: "Add."
  stage: STAGE_PRACTICE
  items { kind { add_in_columns { addends: 2 digits: 3 } } count: 6 }
  design {
    purpose: "Add two three-digit numbers with a sum under 1000, regrouping ones or tens."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Every sum stays under 1000, within the grade 2 limit, and regroups in at least one place. The boxes above the columns give a place to record a new ten or a new hundred."
    misconceptions: "Writes the two-digit sum of a column under that column instead of regrouping."
    misconceptions: "Forgets to add the regrouped ten or hundred."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g2-subtract-3-digit"
  instruction: "Subtract."
  stage: STAGE_PRACTICE
  items { kind { column_add_subtract { digits: 3 subtract: true regroup: true } } count: 6 }
  design {
    purpose: "Subtract three-digit numbers, exchanging a hundred for tens or a ten for ones."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Each item needs at least one exchange. Some have a zero in the top number, such as 605 − 309, where students must exchange across the zero."
    misconceptions: "Subtracts the smaller digit from the larger in each column, whichever is on top."
    misconceptions: "Exchanges a ten but does not reduce the tens digit."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g2-ten-hundred-more-less"
  instruction: "Write the number."
  stage: STAGE_PRACTICE
  items { kind { mental_math { mode: MODE_HUNDRED_MORE_LESS } } count: 8 }
  design {
    purpose: "Find 10 more, 10 less, 100 more or 100 less than a number from 100 to 900 without counting."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Adding or subtracting 10 or 100 changes one digit, so students can answer mentally. This warms up the place-value thinking used in the column addition and subtraction that follows."
    misconceptions: "Changes the ones digit for 10 more."
    misconceptions: "Changes the tens digit for 100 more."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g2-add-several"
  instruction: "Add."
  stage: STAGE_PRACTICE
  items { kind { add_in_columns { addends: 3 } } count: 4 }
  design {
    purpose: "Add three two-digit numbers in columns."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "With three addends, the ones column can make more than one ten, so the regrouped number may be 2. Students can look for pairs that make 10 within the ones column."
    misconceptions: "Records only 1 ten when the ones make 20 or more."
    misconceptions: "Skips one addend in a column."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g2-add-four"
  instruction: "Add."
  stage: STAGE_PRACTICE
  items { kind { add_in_columns { addends: 4 } } count: 3 }
  design {
    purpose: "Add four two-digit numbers in columns."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Four addends is the most grade 2 asks for. The ones often make 20 or more, so students record 2 tens, not 1."
    misconceptions: "Records only 1 ten when the ones make 20 or more."
    misconceptions: "Loses track of which numbers in a column have been added."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g2-explain-regrouping"
  instruction: "Add. Then explain."
  stage: STAGE_STRETCH
  items { kind { add_in_columns { explain: true } } count: 2 }
  design {
    purpose: "Explain why adding in columns works, using tens and ones."
    principles: [PRINCIPLE_SELF_EXPLANATION]
    rationale: "Students explain in words why a 1 is written above the tens column. A complete answer says that the ones made a new ten, and the ten belongs with the other tens."
    misconceptions: "Writes 13 under the ones instead of 3 and a new ten."
    misconceptions: "Describes the steps without saying that the 1 is a ten."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

# Measurement and data.

fragments {
  id: "frag-g2-ruler-inches"
  instruction: "Measure the bar. Write the length in inches."
  stage: STAGE_PRACTICE
  items { kind { length_measure { mode: MODE_RULER_INCHES } } count: 3 }
  design {
    purpose: "Measure a length in inches with a ruler."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Each bar starts at 0 on the ruler. Students read the length as the number of inch spaces the bar covers, which connects the ruler to the unit cubes of grade 1."
    misconceptions: "Starts measuring from 1 instead of 0."
    misconceptions: "Counts the tick marks instead of the spaces between them."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
  }
}

fragments {
  id: "frag-g2-two-units"
  instruction: "Both strips are the same length. Write how many units in each."
  stage: STAGE_PRACTICE
  items { kind { length_measure { mode: MODE_TWO_UNITS } } count: 2 }
  design {
    purpose: "Understand that measuring with smaller units takes more of them."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "The same length is cut into big units and into small units. Students count both and see that the smaller unit gives the larger number, which explains why 12 inches and 1 foot are the same length."
    misconceptions: "Thinks the strip with more units is longer."
    misconceptions: "Thinks the number of units does not depend on the size of the unit."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
  }
}

fragments {
  id: "frag-g2-estimate-length"
  instruction: "Mark the better estimate."
  stage: STAGE_PRACTICE
  items { kind { length_measure { mode: MODE_ESTIMATE } } count: 6 }
  design {
    purpose: "Estimate lengths in inches, feet, centimeters and meters."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Both choices use the same number with different units, so students must judge the size of the unit. The objects are everyday ones, such as a pencil, a door and a bus."
    misconceptions: "Chooses by the number alone, without thinking about the unit."
    misconceptions: "Confuses inches with feet, or centimeters with meters."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
  }
}

fragments {
  id: "frag-g2-how-much-longer"
  instruction: "Measure both bars. Write how much longer bar A is."
  stage: STAGE_PRACTICE
  items { kind { length_measure { mode: MODE_HOW_MUCH_LONGER } } count: 1 }
  design {
    purpose: "Measure two lengths and find how much longer one is."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Students record both measurements before finding the difference. The two bars sit on rulers that line up, so the difference can also be seen as the part of bar A that extends past bar B."
    misconceptions: "Adds the two lengths instead of finding the difference."
    misconceptions: "Writes the length of the longer bar as the answer."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
  }
}

fragments {
  id: "frag-g2-length-word-problems"
  instruction: "Solve. Show your work."
  stage: STAGE_APPLY
  max_columns: 1
  design {
    purpose: "Solve adding and subtracting stories about lengths in the same unit."
    principles: [PRINCIPLE_INTERLEAVING]
    rationale: "The stories use inches, feet and centimeters, with both lengths in the same unit. They mix comparing, joining and removing, so students decide whether to add or subtract. Students should write the unit with the answer."
    misconceptions: "Adds the two lengths in a how-much-longer story."
    misconceptions: "Leaves out the unit, or writes the wrong one."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
  }
  items {
    count: 4
    authored {
      items {
        nodes { text: "A red ribbon is 35 inches long. A blue ribbon is 18 inches long. How much longer is the red ribbon?" }
        nodes { work_space { field { label: "how much longer the red ribbon is" answer { text: "17" work: "35 − 18" also: "17 inches" } } } }
      }
      items {
        nodes { text: "Zoe jumps 46 centimeters. Then she jumps 38 centimeters. How far does she jump in all?" }
        nodes { work_space { field { label: "how far Zoe jumps" answer { text: "84" work: "46 + 38" also: "84 centimeters" also: "84 cm" } } } }
      }
      items {
        nodes { text: "A rope is 90 feet long. Raj cuts off 25 feet. How long is the rope now?" }
        nodes { work_space { field { label: "length of the rope now" answer { text: "65" work: "90 − 25" also: "65 feet" } } } }
      }
      items {
        nodes { text: "A plant was 17 centimeters tall. It grew 8 centimeters. How tall is it now?" }
        nodes { work_space { field { label: "height of the plant now" answer { text: "25" work: "17 + 8" also: "25 centimeters" also: "25 cm" } } } }
      }
    }
  }
}

fragments {
  id: "frag-g2-number-line-tens"
  instruction: "Count the jumps of 10. Write the sum."
  stage: STAGE_GUIDED
  items { kind { number_line_jumps { step: 10 end: 100 } } count: 2 }
  design {
    purpose: "Show adding tens as jumps on a number line from 0 to 100."
    principles: [PRINCIPLE_NUMBER_LINE]
    rationale: "The number line is marked in tens, so each jump is one length of 10. This represents a sum as a length from 0, the model grade 2 uses for addition on a number line."
    misconceptions: "Counts each jump as 1 instead of 10."
    misconceptions: "Counts the starting mark as a jump."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
  }
}

fragments {
  id: "frag-g2-number-line-back"
  instruction: "Count the jumps back. Write the difference."
  stage: STAGE_GUIDED
  items { kind { number_line_jumps { step: 10 end: 100 subtract: true } } count: 2 }
  design {
    purpose: "Show subtracting tens as jumps back on a number line."
    principles: [PRINCIPLE_NUMBER_LINE]
    rationale: "Jumps to the left show subtraction as moving back along the line. Placed after the adding items, they show both operations on the same model."
    misconceptions: "Counts the starting mark as the first jump back."
    misconceptions: "Jumps to the right, as in the adding items."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
  }
}

fragments {
  id: "frag-g2-clock-five-minutes"
  instruction: "Write the time."
  stage: STAGE_PRACTICE
  items { kind { clock_nearest { step: 5 } } count: 6 }
  design {
    purpose: "Tell time to the nearest five minutes."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Students count by 5s from 12 to the long hand to find the minutes. Times late in the hour, where the short hand is close to the next number, test whether students read the hour correctly."
    misconceptions: "Reads the number the long hand points to as the minutes, such as 4 for 20 minutes."
    misconceptions: "Late in the hour, reads the hour from the next number."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
  }
}

fragments {
  id: "frag-g2-count-coins"
  instruction: "Count the money. Write the total."
  stage: STAGE_PRACTICE
  items { kind { count_objects { count { min: 10 max: 99 } mode: MODE_COINS } } count: 4 }
  design {
    purpose: "Find the value of a group of quarters, dimes, nickels and pennies."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "The coins are drawn at their true relative sizes, with the penny copper and ridges on the dime and quarter, and each is named but not valued. Students must know each coin's value. The coins are ordered from greatest value to least, so students can count on: 25, 35, 40, 41."
    misconceptions: "Counts each coin as 1."
    misconceptions: "Thinks a bigger coin is worth more, so a nickel is worth more than a dime."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
  }
}

fragments {
  id: "frag-g2-money-word-problems"
  instruction: "Solve. Show your work."
  stage: STAGE_APPLY
  max_columns: 1
  design {
    purpose: "Solve stories about coins and dollar bills."
    principles: [PRINCIPLE_INTERLEAVING]
    rationale: "Each story states the coin values it uses, so the task is to combine values rather than recall them. Recall is practised in the coin-counting section. The stories include finding a total, finding change and working in whole dollars. Students should write ¢ or $ with the answer."
    misconceptions: "Counts each coin as 1 instead of by its value."
    misconceptions: "Mixes cents and dollars in one answer."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
  }
  items {
    count: 5
    authored {
      items {
        nodes { text: "Ana has 3 dimes and 1 nickel. A dime is 10¢. A nickel is 5¢. How many cents does Ana have?" }
        nodes { work_space { field { label: "cents Ana has" answer { text: "35" work: "10 + 10 + 10 + 5" also: "35¢" } } } }
      }
      items {
        nodes { text: "Ben has 2 quarters and 4 pennies. A quarter is 25¢. A penny is 1¢. How many cents does Ben have?" }
        nodes { work_space { field { label: "cents Ben has" answer { text: "54" work: "25 + 25 + 1 + 1 + 1 + 1" also: "54¢" } } } }
      }
      items {
        nodes { text: "Mia has $5. She buys a book for $3. How many dollars does she have left?" }
        nodes { work_space { field { label: "dollars Mia has left" answer { text: "2" work: "5 − 3" also: "$2" } } } }
      }
      items {
        nodes { text: "A pencil costs 45¢. Kai pays with 2 quarters. A quarter is 25¢. How much change does he get?" }
        nodes { work_space { field { label: "change Kai gets" answer { text: "5" work: "25 + 25 − 45" also: "5¢" } } } }
      }
      items {
        nodes { text: "Omar has one $10 bill and two $1 bills. How many dollars does he have?" }
        nodes { work_space { field { label: "dollars Omar has" answer { text: "12" work: "10 + 1 + 1" also: "$12" } } } }
      }
    }
  }
}

fragments {
  id: "frag-g2-line-plot"
  instruction: "Use the line plot. Answer the questions."
  stage: STAGE_PRACTICE
  items { kind { data_chart { mode: MODE_LINE_PLOT } } count: 2 }
  design {
    purpose: "Read a line plot of lengths measured to the nearest inch."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Each × stands for one object at its measured length. The questions ask for one count, the total number of objects, and the difference between the longest and shortest, which uses the scale as a number line."
    misconceptions: "Counts the numbers on the scale instead of the ×s."
    misconceptions: "Gives the number of objects at the longest length instead of the difference in length."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K–3, Categorical Data; Grades 2–5, Measurement Data"
  }
}

fragments {
  id: "frag-g2-bar-graph"
  instruction: "Use the bar graph. Answer the questions."
  stage: STAGE_PRACTICE
  items { kind { bar_graph_questions { values { min: 1 max: 10 } step: 1 } } count: 2 }
  design {
    purpose: "Read a bar graph with four groups and answer put-together, take-apart and compare questions."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "The scale counts by ones, so each bar's height can be read directly. The questions ask for a value, a difference and a total, the three kinds grade 2 asks of a bar graph."
    misconceptions: "Reads the height from the wrong gridline."
    misconceptions: "Answers how many more with the larger value instead of the difference."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K–3, Categorical Data; Grades 2–5, Measurement Data"
  }
}

# Geometry.

fragments {
  id: "frag-g2-shape-features"
  instruction: "Count the sides and corners. Mark the name."
  stage: STAGE_PRACTICE
  items { kind { shape_attributes { mode: MODE_SIDES_CORNERS } } count: 4 }
  design {
    purpose: "Name triangles, quadrilaterals, pentagons and hexagons by their sides and corners."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Regular and irregular shapes appear in different turns. Students name each by counting sides and corners, which are the defining attributes, rather than by its overall look."
    misconceptions: "Thinks only a regular shape counts, so a hexagon must look like a honeycomb cell."
    misconceptions: "Calls any four-sided shape a square or a rectangle."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–6, Geometry"
  }
}

fragments {
  id: "frag-g2-draw-by-sides"
  instruction: "Draw the shape. Mark its name."
  stage: STAGE_APPLY
  items { kind { shape_attributes { mode: MODE_DRAW_BY_SIDES } } count: 2 }
  design {
    purpose: "Draw a shape with a given number of sides and corners, and name it."
    principles: [PRINCIPLE_SELF_EXPLANATION]
    rationale: "Students draw from a description of the attributes rather than copy a picture. Any closed shape with the right number of straight sides is correct, which shows that many different shapes share one name."
    misconceptions: "Draws a shape that is not closed."
    misconceptions: "Draws one more or one fewer corner than sides."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–6, Geometry"
  }
}

fragments {
  id: "frag-g2-rows-of-squares"
  instruction: "Write the number of rows, columns and squares."
  stage: STAGE_PRACTICE
  items { kind { pairs_and_arrays { size { min: 2 max: 5 } mode: MODE_SQUARES } } count: 4 }
  design {
    purpose: "Count the squares in a rectangle cut into rows and columns."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Students count rows and columns before the total, which links the rectangle to repeated addition and later to area. Rectangles stay within 5 by 5."
    misconceptions: "Swaps rows and columns."
    misconceptions: "Counts the squares around the edge only."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–6, Geometry"
  }
}

fragments {
  id: "frag-g2-equal-shares"
  instruction: "Mark equal shares or not equal shares."
  stage: STAGE_PRACTICE
  items { kind { equal_shares { denominators: [2, 3, 4] unequal: true } } count: 2 }
  design {
    purpose: "Tell equal shares from parts that are not equal, in halves, thirds and fourths."
    principles: [PRINCIPLE_ERROR_ANALYSIS]
    rationale: "Bars are cut into two, three or four parts, some equal and some not. Students check the size of each part before deciding, which is required before naming thirds or fourths."
    misconceptions: "Calls any cut into three parts thirds."
    misconceptions: "Thinks the shaded part must be bigger or smaller than the others."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–6, Geometry"
  }
}

worksheets {
  id: "ws-g2-word-problems"
