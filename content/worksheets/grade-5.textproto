# ── Measurement and data ───────────────────────────────────────────────────

fragments {
  id: "frag-g5-convert-measure"
  instruction: "Convert."
  stage: STAGE_PRACTICE
  explainer: "1 m = 100 cm, 1 km = 1,000 m, 1 cm = 10 mm, 1 kg = 1,000 g, 1 L = 1,000 mL. 1 ft = 12 in, 1 yd = 3 ft, 1 gal = 4 qt, 1 lb = 16 oz, 1 hr = 60 min."
  items { kind { convert_measure {} } count: 12 min_count: 6 }
  max_columns: 2
  design {
    purpose: "Convert between larger and smaller units of one system, including decimals."
    principles: [PRINCIPLE_INTERLEAVING]
    misconceptions: "Dividing when going to a smaller unit: 3 m = 0.03 cm."
  }
}

fragments {
  id: "frag-g5-line-plot-share"
  instruction: "Use the line plot."
  stage: STAGE_APPLY
  explainer: "Each X is one amount. To share the total equally, divide it by how many there are."
  items { kind { line_plot_share {} } count: 2 min_count: 1 }
  max_columns: 1
  design {
    purpose: "Read a line plot of fractions and use fraction operations to find a total and an equal share."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
}

fragments {
  id: "frag-g5-volume-count"
  instruction: "Count the cubes to find the volume."
  stage: STAGE_INTRODUCE
  explainer: "Each small cube is 1 cubic unit. Volume is how many cubes fill the box, including the ones you cannot see."
  items { kind { prism_volume { mode: MODE_COUNT } } count: 6 min_count: 3 }
  max_columns: 3
  design {
    purpose: "Find the volume of a box by counting unit cubes."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    misconceptions: "Counting only the cubes that show on the outside."
  }
}

fragments {
  id: "frag-g5-volume-layers"
  instruction: "Find the volume by layers."
  stage: STAGE_GUIDED
  explainer: "Count the cubes in the bottom layer. Every layer is the same, so multiply by the number of layers."
  items { kind { prism_volume { mode: MODE_LAYERS } } count: 3 min_count: 2 }
  max_columns: 3
  design {
    purpose: "See that volume is the cubes in one layer times the number of layers."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
  }
}

fragments {
  id: "frag-g5-volume-formula"
  instruction: "Find the volume."
  stage: STAGE_PRACTICE
  explainer: "Volume = length × width × height, or the area of the base × height."
  items { kind { prism_volume { mode: MODE_FORMULA } } count: 6 min_count: 3 }
  max_columns: 2
  design {
    purpose: "Find the volume of a box from its edge lengths."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

fragments {
  id: "frag-g5-volume-combined"
  instruction: "The shape is made of two boxes. Find its volume."
  stage: STAGE_STRETCH
  explainer: "Find the volume of each box, then add them."
  items { kind { prism_volume { mode: MODE_COMBINED } } count: 3 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Find the volume of a shape made of two boxes by adding their volumes."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
  }
}

