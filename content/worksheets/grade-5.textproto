# ── Fractions: adding and subtracting ──────────────────────────────────────

fragments {
  id: "frag-g5-unlike-fractions-model"
  instruction: "Use the grids to add."
  stage: STAGE_INTRODUCE
  items { kind { unlike_fractions { model: true denominators: [2, 3, 4, 5] } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Add fractions with different denominators by rewriting them with a common denominator."
    principles: [PRINCIPLE_CONCRETENESS_FADING, PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Each grid is one whole cut into columns for one denominator and rows for the other. The cuts make both fractions countable in the same small parts. Students count the parts, write the equivalent fractions, and then add."
    misconceptions: "Adding numerators and denominators: 1/3 + 1/4 = 2/7."
    misconceptions: "Counting the parts in a grid without checking that both grids are cut the same way."
    references: "Common Core Standards Writing Team (2013), Progressions for Number and Operations—Fractions, 3-5"
    references: "Siegler et al. (2010), IES practice guide, Developing Effective Fractions Instruction, rec. 2"
  }
}

fragments {
  id: "frag-g5-add-unlike-fractions"
  instruction: "Add. Write the answer in simplest form."
  stage: STAGE_PRACTICE
  explainer: "Example: 1/3 + 1/4 = 4/12 + 3/12 = 7/12"
  items { kind { unlike_fractions {} } count: 8 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Add fractions with different denominators."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Some pairs of denominators share a factor, such as 4 and 6, and some do not, such as 3 and 4. When they share a factor, the product of the denominators works but is not the least. Some sums are more than 1 or can be simplified, so students check the answer's form."
    misconceptions: "Adding numerators and denominators: 1/3 + 1/4 = 2/7."
    misconceptions: "Changing the denominator without changing the numerator: 1/3 written as 1/12."
    references: "Common Core Standards Writing Team (2013), Progressions for Number and Operations—Fractions, 3-5"
  }
}

fragments {
  id: "frag-g5-subtract-unlike-fractions"
  instruction: "Subtract. Write the answer in simplest form."
  stage: STAGE_PRACTICE
  items { kind { unlike_fractions { subtract: true } } count: 8 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Subtract fractions with different denominators."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Subtraction uses the same common-denominator step as addition. Every first fraction is larger than the second, so each difference is positive. Some pairs look close in size, so students rewrite them before deciding which is larger."
    misconceptions: "Subtracting numerators and denominators: 3/4 − 1/3 = 2/1."
    references: "Common Core Standards Writing Team (2013), Progressions for Number and Operations—Fractions, 3-5"
  }
}

fragments {
  id: "frag-g5-add-unlike-mixed"
  instruction: "Add. Write the answer in simplest form."
  stage: STAGE_PRACTICE
  explainer: "Example: 2 1/2 + 1 2/3 = 2 3/6 + 1 4/6 = 3 7/6 = 4 1/6"
  items { kind { unlike_fractions { mixed: true denominators: [2, 3, 4, 5, 6, 8] } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Add mixed numbers with different denominators."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Students add the whole numbers and the fractions separately after rewriting the fractions. Many fraction parts add to more than 1, so the sum must be regrouped. The worked line shows the regrouping step."
    misconceptions: "Leaving an answer such as 3 7/6 without regrouping to 4 1/6."
    references: "Common Core Standards Writing Team (2013), Progressions for Number and Operations—Fractions, 3-5"
  }
}

fragments {
  id: "frag-g5-subtract-unlike-mixed"
  instruction: "Subtract. Write the answer in simplest form."
  stage: STAGE_STRETCH
  explainer: "Example: 3 1/4 − 1 1/2 = 2 5/4 − 1 2/4 = 1 3/4"
  items { kind { unlike_fractions { mixed: true subtract: true denominators: [2, 3, 4, 5, 6, 8] } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Subtract mixed numbers with different denominators, regrouping a whole when needed."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "In some items the second fraction part is larger than the first. Students then trade one whole for fraction parts, as in the worked line. Items with and without regrouping are mixed so students check every time."
    misconceptions: "Subtracting the smaller fraction from the larger, whichever number it belongs to: 3 1/4 − 1 1/2 = 2 1/4."
    references: "Common Core Standards Writing Team (2013), Progressions for Number and Operations—Fractions, 3-5"
  }
}

worksheets {
  id: "ws-g5-unlike-fractions"
