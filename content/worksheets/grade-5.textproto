  title: "Line plots with fractions"
  seed: 562
  max_pages: 1
  placements { fragment_id: "frag-g5-line-plot-share" }
  design {
    purpose: "Answer questions from a line plot using fraction operations."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Each plot is read, totalled and then shared equally."
  }
  home_tip: "Measure several pencils to the nearest 1/8 inch and make a line plot of the lengths."
}

worksheets {
  id: "ws-g5-volume-cubes"
  title: "Volume with unit cubes"
  seed: 563
  max_pages: 2
  placements { fragment_id: "frag-g5-volume-count" }
  placements { fragment_id: "frag-g5-volume-layers" }
  design {
    purpose: "Find volume by counting cubes, then by layers."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Counting every cube comes first. Counting one layer and multiplying is the faster method that leads to the formula."
  }
  home_tip: "Build a box from sugar cubes or blocks, count the cubes, and then count them by layers."
}

worksheets {
  id: "ws-g5-volume-formulas"
  title: "Volume formulas"
  seed: 564
  max_pages: 3
  placements { fragment_id: "frag-g5-volume-layers" count: 2 stage: STAGE_REVIEW }
  placements { fragment_id: "frag-g5-volume-formula" count: 4 }
  placements { fragment_id: "frag-g5-volume-combined" count: 2 }
  placements { fragment_id: "frag-g5-volume-word-problems" }
  design {
    purpose: "Use the volume formulas, and add the volumes of joined prisms."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Layers of cubes come first, so the formula is a count students have already made."
  }
  home_tip: "Measure a cereal box in inches and find its volume."
}

# ── Geometry ───────────────────────────────────────────────────────────────

fragments {
  id: "frag-g5-read-points"
  instruction: "Write the ordered pair for each point."
  stage: STAGE_INTRODUCE
  explainer: "(3, 5): start at 0, move 3 along the x-axis, then 5 up."
  items { kind { coordinate_points { mode: MODE_READ } } count: 2 min_count: 1 }
  max_columns: 2
  design {
    purpose: "Read the coordinates of points on a coordinate grid."
    principles: [PRINCIPLE_NUMBER_LINE]
    rationale: "The axes are labelled x and y, as the standard names them. Some points lie on an axis, so one coordinate is 0. No grid shows both (a, b) and (b, a), so a swapped pair is always wrong."
    misconceptions: "Swapping the coordinates: writing (5, 3) for 3 along and 5 up."
    misconceptions: "Counting gridlines from 1 instead of from 0."
    references: "Common Core Standards Writing Team (2012), Progressions for Geometry, K-6"
  }
}

fragments {
  id: "frag-g5-plot-points"
  instruction: "Plot and label each point."
  stage: STAGE_PRACTICE
  items { kind { coordinate_points { mode: MODE_PLOT } } count: 2 min_count: 1 }
  max_columns: 2
  design {
    purpose: "Plot points on a coordinate grid from their coordinates."
    principles: [PRINCIPLE_NUMBER_LINE]
    rationale: "Plotting reverses reading: students start from the ordered pair and find the point. Some points lie on an axis. Each point is labelled so it can be checked against the answer key."
    misconceptions: "Plotting (0, 4) on the x-axis."
    references: "Common Core Standards Writing Team (2012), Progressions for Geometry, K-6"
  }
}

fragments {
  id: "frag-g5-name-quadrilaterals"
  instruction: "Check the most specific name for each shape."
  stage: STAGE_PRACTICE
  example {
    item { shape_hierarchy { mode: MODE_NAME } }
    seed: 7
    text: "A square is also a rectangle and a rhombus. **Square** is its most specific name."
  }
  items { kind { shape_hierarchy { mode: MODE_NAME } } count: 6 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Classify quadrilaterals by their sides and angles."
    principles: [PRINCIPLE_WORKED_EXAMPLE, PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Each shape is labelled with its side lengths and marked with any right angles. Students use these properties, not the shape's position, to name it. Squares and rhombuses appear tilted as well as upright."
    misconceptions: "Thinking a square is not a rectangle."
    misconceptions: "Calling a tilted square a diamond or a rhombus only."
    references: "Common Core Standards Writing Team (2012), Progressions for Geometry, K-6"
  }
}

fragments {
  id: "frag-g5-always-sometimes-never"
  instruction: "Check always, sometimes, or never."
  stage: STAGE_STRETCH
  items { kind { shape_hierarchy { mode: MODE_ALWAYS_SOMETIMES_NEVER } } count: 8 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Reason about which quadrilaterals belong to which categories."
    principles: [PRINCIPLE_SELF_EXPLANATION]
    rationale: "Deciding \"sometimes\" needs one example and one counterexample, which makes students use the properties of each category. The statements avoid trapezoids, whose definition varies between curricula. Statements about sides and angles appear with statements about categories."
    misconceptions: "Thinking a square is not a rectangle."
    misconceptions: "Reading \"a rectangle is sometimes a square\" as false because most rectangles are not squares."
    references: "Common Core Standards Writing Team (2012), Progressions for Geometry, K-6"
  }
}

worksheets {
  id: "ws-g5-coordinate-grid"
