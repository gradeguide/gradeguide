# proto-file: worksheet/proto/v1/worksheet.proto
# proto-message: gradeguide.worksheet.v1.Library
#
# Grade 5 fragments and worksheets. Word problems for grade 5 are in
# grade-5-word-problems.textproto, and alignments in
# alignments-grade-5.textproto.

# ── Operations and algebraic thinking ──────────────────────────────────────

fragments {
  id: "frag-g5-parentheses"
  instruction: "Work out the part in parentheses first."
  stage: STAGE_INTRODUCE
  explainer: "Parentheses show what to do first: (2 + 3) × 4 = 5 × 4 = 20."
  items { kind { numerical_expression {} } count: 10 min_count: 6 }
  max_columns: 2
  design {
    purpose: "Evaluate expressions with parentheses."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    misconceptions: "Working left to right and ignoring the parentheses: 2 × (3 + 4) = 6 + 4."
  }
}

fragments {
  id: "frag-g5-brackets"
  instruction: "Work from the inside out: parentheses, then brackets."
  stage: STAGE_STRETCH
  items { kind { numerical_expression { brackets: true } } count: 6 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Evaluate expressions with parentheses inside brackets."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
  }
}

fragments {
  id: "frag-g5-write-expressions"
  instruction: "Write each calculation as an expression. Do not work it out."
  stage: STAGE_PRACTICE
  explainer: "\"Add 8 and 7, then multiply by 2\" is (8 + 7) × 2. The parentheses show the adding comes first."
  items { kind { expression_in_words {} } count: 10 min_count: 6 }
  max_columns: 2
  design {
    purpose: "Write a calculation described in words as an expression, and read an expression without evaluating it."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    misconceptions: "Leaving out the parentheses: \"add 8 and 7, then multiply by 2\" as 8 + 7 × 2."
  }
}

fragments {
  id: "frag-g5-two-patterns"
  instruction: "Fill in both patterns. Then compare them."
  stage: STAGE_PRACTICE
  explainer: "Both patterns start at 0. Add the rule's number each step."
  items { kind { two_patterns {} } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Make two patterns from two rules and see how their terms are related."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Side by side in a table, the terms show one pattern is always a set number of times the other."
  }
}

fragments {
  id: "frag-g5-graph-a-pattern"
  instruction: "The graph shows a pattern. Answer from the graph."
  stage: STAGE_APPLY
  items { kind { coordinate_points { mode: MODE_PROBLEM } } count: 2 min_count: 1 }
  max_columns: 2
  design {
    purpose: "Read and extend a pattern shown as points on a coordinate grid."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
}

worksheets {
  id: "ws-g5-parentheses"
  title: "Parentheses and brackets"
  seed: 501
  max_pages: 2
  placements { fragment_id: "frag-g5-parentheses" }
  placements { fragment_id: "frag-g5-brackets" }
  design {
    purpose: "Evaluate expressions with parentheses and brackets."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
  }
  home_tip: "Work out 2 + 3 × 4 and (2 + 3) × 4 together and compare."
}

worksheets {
  id: "ws-g5-write-expressions"
  title: "Writing expressions"
  seed: 502
  max_pages: 2
  placements { fragment_id: "frag-g5-parentheses" count: 4 stage: STAGE_REVIEW }
  placements { fragment_id: "frag-g5-write-expressions" }
  design {
    purpose: "Write expressions from words and read them without working them out."
    principles: [PRINCIPLE_PREREQUISITE_REVIEW]
  }
}

worksheets {
  id: "ws-g5-two-patterns"
  title: "Two number patterns"
  seed: 503
  max_pages: 2
  placements { fragment_id: "frag-g5-two-patterns" }
  placements { fragment_id: "frag-g5-graph-a-pattern" }
  design {
    purpose: "Make, compare and graph number patterns."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
  home_tip: "Compare saving $3 a week with saving $6 a week."
}

# ── Place value and decimals ───────────────────────────────────────────────

fragments {
  id: "frag-g5-ten-times"
  instruction: "Write what each digit is worth. Then compare them."
  stage: STAGE_INTRODUCE
  explainer: "Each place is worth 10 times the place to its right. In 0.33, the first 3 is worth 0.3 and the second 0.03."
  items { kind { place_value_ten_times {} } count: 6 min_count: 4 }
  max_columns: 2
  design {
    purpose: "See that a digit is worth 10 times as much as the same digit one place to its right, and 1/10 as much as one place to its left."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    misconceptions: "Thinking places after the point grow to the right, as tens and hundreds do on the left."
  }
}

fragments {
  id: "frag-g5-powers-of-ten"
  instruction: "Multiply or divide by a power of 10."
  stage: STAGE_PRACTICE
  explainer: "10³ means 10 × 10 × 10 = 1,000. The small number says how many 10s to multiply."
  items { kind { powers_of_ten {} } count: 12 min_count: 6 }
  max_columns: 3
  design {
    purpose: "Write powers of 10 with exponents, and multiply and divide whole numbers by them."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    misconceptions: "Reading 10³ as 10 × 3 = 30."
  }
}

fragments {
  id: "frag-g5-powers-of-ten-chart"
  instruction: "Write the answer in the bottom row of the chart."
  stage: STAGE_GUIDED
  explainer: "Times 10 moves every digit one place to the left. Divide by 10 moves every digit one place to the right. The decimal point stays put."
  items { kind { powers_of_ten { decimals: true chart: true } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "See multiplying and dividing by 10, 100 and 1,000 as moving digits between places."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "The chart shows the digits moving while the point stays still, which is what \"moving the decimal point\" really means."
  }
}

fragments {
  id: "frag-g5-powers-of-ten-decimals"
  instruction: "Multiply or divide. Watch where the decimal point goes."
  stage: STAGE_PRACTICE
  explainer: "Times 10 moves each digit one place to the left. Divide by 10 moves each digit one place to the right."
  items { kind { powers_of_ten { decimals: true } } count: 12 min_count: 6 }
  max_columns: 3
  design {
    purpose: "Multiply and divide decimals by 10, 100 and 1,000."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    misconceptions: "Adding a zero to the end of a decimal to multiply by 10: 4.7 × 10 = 4.70."
  }
}

fragments {
  id: "frag-g5-decimal-words"
  instruction: "Write the number."
  stage: STAGE_INTRODUCE
  explainer: "Say the whole number, then \"and\" for the point, then the decimal part with its last place: 4.026 is four and twenty-six thousandths."
  items { kind { decimal_forms { mode: MODE_WORDS } } count: 6 min_count: 4 }
  max_columns: 1
  design {
    purpose: "Write a decimal to thousandths from its name."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    misconceptions: "Writing twenty-six thousandths as 0.26, without the zero to hold the tenths place."
  }
}

fragments {
  id: "frag-g5-decimal-expanded"
  instruction: "Write the number."
  stage: STAGE_PRACTICE
  items { kind { decimal_forms { mode: MODE_EXPANDED } } count: 4 min_count: 2 }
  max_columns: 1
  design {
    purpose: "Write a decimal to thousandths from its expanded form."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
}

fragments {
  id: "frag-g5-decimal-chart"
  instruction: "Read the place-value chart."
  stage: STAGE_GUIDED
  explainer: "The dot is the decimal point. Places to its right are tenths, hundredths and thousandths."
  items { kind { decimal_forms { mode: MODE_CHART } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Read a decimal to thousandths from a place-value chart, and the value of one of its digits."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    misconceptions: "Reading the digit in the tenths place as tens."
  }
}

fragments {
  id: "frag-g5-compare-thousandths"
  instruction: "Write <, > or = in each circle."
  stage: STAGE_PRACTICE
  explainer: "Line up the decimal points. Compare tenths first, then hundredths, then thousandths. 0.4 is the same as 0.400."
  items { kind { decimal_forms { mode: MODE_COMPARE } } count: 15 min_count: 9 }
  max_columns: 3
  design {
    purpose: "Compare two decimals to thousandths."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    misconceptions: "Thinking the decimal with more digits is larger: 0.389 > 0.4."
  }
}

fragments {
  id: "frag-g5-round-decimals-line"
  instruction: "Use the number line to round."
  stage: STAGE_GUIDED
  explainer: "Find which end of the line the number is closer to. A number exactly halfway rounds up."
  items { kind { round_decimal { number_line: true } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Round a decimal using a number line between the two choices."
    principles: [PRINCIPLE_NUMBER_LINE]
  }
}

fragments {
  id: "frag-g5-round-decimals"
  instruction: "Round each number."
  stage: STAGE_PRACTICE
  items { kind { round_decimal {} } count: 9 min_count: 6 }
  max_columns: 3
  design {
    purpose: "Round decimals to the nearest whole number, tenth or hundredth."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    misconceptions: "Rounding 3.46 to the nearest tenth as 3.4 by dropping the last digit."
  }
}

