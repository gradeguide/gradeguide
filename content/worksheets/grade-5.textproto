# ── Geometry ───────────────────────────────────────────────────────────────

fragments {
  id: "frag-g5-read-points"
  instruction: "Write where each point is."
  stage: STAGE_INTRODUCE
  explainer: "(3, 5) means 3 across from 0, then 5 up. Across comes first."
  items { kind { coordinate_points { mode: MODE_READ } } count: 2 min_count: 1 }
  max_columns: 2
  design {
    purpose: "Read the coordinates of points on a grid."
    principles: [PRINCIPLE_NUMBER_LINE]
    misconceptions: "Swapping the numbers: writing (5, 3) for 3 across and 5 up."
  }
}

fragments {
  id: "frag-g5-plot-points"
  instruction: "Plot the points."
  stage: STAGE_PRACTICE
  items { kind { coordinate_points { mode: MODE_PLOT } } count: 2 min_count: 1 }
  max_columns: 2
  design {
    purpose: "Plot points on a grid from their coordinates."
    principles: [PRINCIPLE_NUMBER_LINE]
  }
}

fragments {
  id: "frag-g5-name-quadrilaterals"
  instruction: "Tick the most exact name for each shape."
  stage: STAGE_PRACTICE
  explainer: "A square is also a rectangle and a rhombus, but square is its most exact name."
  items { kind { shape_hierarchy { mode: MODE_NAME } } count: 6 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Classify quadrilaterals by their sides and angles."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    misconceptions: "Thinking a square is not a rectangle."
  }
}

fragments {
  id: "frag-g5-always-sometimes-never"
  instruction: "Tick always, sometimes or never."
  stage: STAGE_STRETCH
  items { kind { shape_hierarchy { mode: MODE_ALWAYS_SOMETIMES_NEVER } } count: 8 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Reason about which shapes belong to which families."
    principles: [PRINCIPLE_SELF_EXPLANATION]
    rationale: "Deciding \"sometimes\" needs one example and one counterexample, which makes the child think about the properties."
  }
}

