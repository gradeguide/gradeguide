    purpose: "Classify quadrilaterals and reason about their categories."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Naming single shapes comes before statements about whole categories."
  }
  home_tip: "Find rectangles, squares and rhombuses around the house and name each one as specifically as possible."
}
