# ── Decimal arithmetic ─────────────────────────────────────────────────────

fragments {
  id: "frag-g5-add-decimals"
  instruction: "Add. Keep the decimal points lined up."
  stage: STAGE_PRACTICE
  items { kind { decimal_arithmetic { op: OP_ADD } } count: 6 min_count: 3 }
  max_columns: 3
  design {
    purpose: "Add decimals to hundredths."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    misconceptions: "Lining up the last digits instead of the decimal points."
  }
}

fragments {
  id: "frag-g5-subtract-decimals"
  instruction: "Subtract. Keep the decimal points lined up."
  stage: STAGE_PRACTICE
  items { kind { decimal_arithmetic { op: OP_SUBTRACT } } count: 6 min_count: 3 }
  max_columns: 3
  design {
    purpose: "Subtract decimals to hundredths."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

fragments {
  id: "frag-g5-multiply-decimals"
  instruction: "Multiply."
  stage: STAGE_PRACTICE
  explainer: "Multiply as if there were no decimal points. Then count the digits after the points in both numbers: the answer has that many."
  items { kind { decimal_arithmetic { op: OP_MULTIPLY } } count: 6 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Multiply decimals to hundredths."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    misconceptions: "Thinking multiplying always makes a number bigger: 0.6 × 0.7 = 4.2."
  }
}

fragments {
  id: "frag-g5-divide-decimals"
  instruction: "Divide."
  stage: STAGE_PRACTICE
  explainer: "To divide by a decimal, think how many of it fit: 3.6 ÷ 0.4 asks how many 4 tenths make 36 tenths."
  items { kind { decimal_arithmetic { op: OP_DIVIDE } } count: 6 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Divide decimals to hundredths by whole numbers and by decimals."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
  }
}

