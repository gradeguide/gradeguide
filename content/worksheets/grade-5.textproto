  }
  home_tip: "Compare half of 12, all of 12 and one and a half times 12."
}

worksheets {
  id: "ws-g5-fraction-multiply-word-problems"
  title: "Fraction word problems: multiplying"
  seed: 555
  max_pages: 2
  placements { fragment_id: "frag-g5-fraction-times-whole" count: 2 stage: STAGE_REVIEW }
  placements { fragment_id: "frag-g5-fraction-multiply-word-problems" }
  design {
    purpose: "Solve word problems that multiply fractions and mixed numbers."
    principles: [PRINCIPLE_PREREQUISITE_REVIEW]
    rationale: "Two calculations recall the procedure before the problems ask students to recognize multiplication in a story."
  }
  home_tip: "Halve or double a recipe and work out the new amount of each ingredient."
}

worksheets {
  id: "ws-g5-divide-unit-fractions"
  title: "Dividing with unit fractions"
  seed: 556
  max_pages: 3
  placements { fragment_id: "frag-g5-unit-fraction-by-whole-model" }
  placements { fragment_id: "frag-g5-unit-fraction-by-whole" }
  placements { fragment_id: "frag-g5-whole-by-unit-fraction" count: 4 }
  placements { fragment_id: "frag-g5-unit-fraction-word-problems" }
  design {
    purpose: "Divide unit fractions by whole numbers and whole numbers by unit fractions, and use both in word problems."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Each kind of division starts with a model. The word problems then mix both kinds, so the story decides which way to divide."
  }
  home_tip: "Find how many 1/4-cup scoops are in 2 cups, then check with a measuring cup."
}

# ── Measurement and data ───────────────────────────────────────────────────

fragments {
  id: "frag-g5-convert-measure"
  instruction: "Convert."
  stage: STAGE_PRACTICE
  figure {
    data_table {
      header: ["Metric", "Customary"]
      rows { cells { text: "1 km = 1,000 m" } cells { text: "1 yd = 3 ft" } }
      rows { cells { text: "1 m = 100 cm" } cells { text: "1 ft = 12 in." } }
      rows { cells { text: "1 cm = 10 mm" } cells { text: "1 gal = 4 qt" } }
      rows { cells { text: "1 kg = 1,000 g" } cells { text: "1 lb = 16 oz" } }
      rows { cells { text: "1 L = 1,000 mL" } cells { text: "1 hr = 60 min" } }
    }
  }
  items { kind { convert_measure {} } count: 12 min_count: 6 }
  max_columns: 2
  design {
    purpose: "Convert between larger and smaller units of one measurement system, including decimals."
    principles: [PRINCIPLE_INTERLEAVING]
    rationale: "Items mix metric and customary units and both directions, so students decide each time whether to multiply or divide. Metric conversions use decimals, which applies multiplying and dividing by powers of 10. Customary conversions to larger units give a whole number and a remainder in the smaller unit."
    misconceptions: "Dividing when converting to a smaller unit: 3 m = 0.03 cm."
    misconceptions: "Using 100 for every conversion, as if every system were metric."
    references: "Common Core Standards Writing Team (2012), Progressions for Geometric Measurement, 3-5"
  }
}

fragments {
  id: "frag-g5-line-plot-share"
  instruction: "Use the line plot to answer the questions."
  stage: STAGE_APPLY
  items { kind { line_plot_share {} } count: 2 min_count: 1 }
  max_columns: 1
  design {
    purpose: "Read a line plot of fractional measurements and use fraction operations to find a total and an equal share."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "The data are in eighths, as the standard specifies. Students read one count, add all the amounts, and then share the total equally. The equal share is the amount each container would hold if the total were redistributed."
    misconceptions: "Counting the X marks instead of adding the amounts they stand for."
    misconceptions: "Dividing by the number of different values instead of the number of X marks."
    references: "Common Core Standards Writing Team (2011), Progressions for K-3 Categorical Data; 2-5 Measurement Data"
  }
}

fragments {
  id: "frag-g5-volume-count"
  instruction: "Find the volume. Each cube is 1 cubic unit."
  stage: STAGE_INTRODUCE
  items { kind { prism_volume { mode: MODE_COUNT } } count: 6 min_count: 3 }
  max_columns: 3
  design {
    purpose: "Find the volume of a rectangular prism by counting unit cubes."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Each prism is drawn with its unit cubes on three faces. The top and side faces are shaded differently so the cubes read as solid. Students must count the cubes that are hidden inside, which leads to counting by layers."
    misconceptions: "Counting only the cube faces that show."
    misconceptions: "Counting the edge cubes twice, once on each face."
    references: "Common Core Standards Writing Team (2012), Progressions for Geometric Measurement, 3-5"
  }
}

fragments {
  id: "frag-g5-volume-layers"
  instruction: "Find the volume. Count the cubes in the bottom layer first."
  stage: STAGE_GUIDED
  items { kind { prism_volume { mode: MODE_LAYERS } } count: 3 min_count: 2 }
  max_columns: 3
  design {
    purpose: "Find volume as the number of cubes in one layer times the number of layers."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "The bottom layer is shaded darker, so students can count one layer. Every layer has the same number of cubes. Multiplying by the number of layers gives the volume, which is the base area times the height."
    misconceptions: "Counting the bottom layer as only the front row of cubes."
    references: "Common Core Standards Writing Team (2012), Progressions for Geometric Measurement, 3-5"
  }
}

fragments {
  id: "frag-g5-volume-formula"
  instruction: "Find the volume."
  stage: STAGE_PRACTICE
  explainer: "V = l × w × h    V = B × h"
  items { kind { prism_volume { mode: MODE_FORMULA } } count: 6 min_count: 3 }
  max_columns: 2
  design {
    purpose: "Find the volume of a rectangular prism from its edge lengths or its base area."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Most prisms give three edge lengths. Some give the area of the base and the height, which uses the second formula. The prisms are drawn in proportion to their edge lengths."
    misconceptions: "Adding the edge lengths instead of multiplying them."
    misconceptions: "Multiplying the base area by another edge of the base instead of the height."
    references: "Common Core Standards Writing Team (2012), Progressions for Geometric Measurement, 3-5"
  }
}

fragments {
  id: "frag-g5-volume-combined"
  instruction: "Find the volume of each figure."
  stage: STAGE_STRETCH
  items { kind { prism_volume { mode: MODE_COMBINED } } count: 3 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Find the volume of a figure made of two rectangular prisms by adding their volumes."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Each figure is two prisms of the same width standing side by side. The answer lines ask for each prism and then the whole figure. Volume is additive, so the two volumes add to the total."
    misconceptions: "Multiplying the total length by the taller height, as if the figure were one prism."
    references: "Common Core Standards Writing Team (2012), Progressions for Geometric Measurement, 3-5"
  }
}

worksheets {
  id: "ws-g5-convert-units"
