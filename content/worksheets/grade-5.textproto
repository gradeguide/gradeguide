# proto-file: worksheet/proto/v1/worksheet.proto
# proto-message: gradeguide.worksheet.v1.Library
#
# Grade 5 fragments and worksheets. Word problems for grade 5 are in
# grade-5-word-problems.textproto, and alignments in
# alignments-grade-5.textproto.

# ── Operations and algebraic thinking ──────────────────────────────────────

fragments {
  id: "frag-g5-parentheses"
  instruction: "Solve. Work inside the parentheses first."
  stage: STAGE_INTRODUCE
  example {
    item { numerical_expression {} }
    seed: 3
    text: "Find the value inside the **parentheses** first. Then do the operation outside."
  }
  items { kind { numerical_expression {} } count: 10 min_count: 6 }
  max_columns: 2
  design {
    purpose: "Evaluate expressions that contain parentheses."
    principles: [PRINCIPLE_WORKED_EXAMPLE, PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Each expression has one pair of parentheses and two operations, so the only decision is which operation comes first. The parentheses sit at the front in some items and at the end in others. Students who always work left to right get some items wrong, which shows them the parentheses matter."
    misconceptions: "Working left to right and ignoring the parentheses: 2 × (3 + 4) worked as 2 × 3 + 4 = 10."
    misconceptions: "Treating parentheses as a sign to multiply only, and adding first in an expression such as 76 − (4 × 4)."
    references: "Common Core Standards Writing Team (2011), Progressions for Operations and Algebraic Thinking, K-5"
  }
}

fragments {
  id: "frag-g5-brackets"
  instruction: "Solve. Work inside the parentheses, then inside the brackets."
  stage: STAGE_STRETCH
  items { kind { numerical_expression { brackets: true } } count: 6 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Evaluate expressions with parentheses nested inside brackets."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Brackets add a second level of grouping, so students must work from the inside out. Each item has three operations, and the space under it holds one line per step. Writing each step keeps the order visible and makes errors easy to find."
    misconceptions: "Working the brackets before the parentheses inside them."
    misconceptions: "Dropping a number while rewriting the expression after each step."
    references: "Common Core Standards Writing Team (2011), Progressions for Operations and Algebraic Thinking, K-5"
  }
}

fragments {
  id: "frag-g5-write-expressions"
  instruction: "Write an expression for each calculation. Do not solve."
  stage: STAGE_PRACTICE
  example {
    item { expression_in_words {} }
    seed: 2
    text: "The **parentheses** show which part to do first."
  }
  items { kind { expression_in_words {} } count: 8 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Write a calculation described in words as a numerical expression."
    principles: [PRINCIPLE_WORKED_EXAMPLE, PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "The words give the order of the steps, and the expression must show the same order with symbols. The four forms take turns, so students meet adding first, multiplying first, subtracting then dividing, and doubling a sum. Leaving the expression unsolved keeps attention on its structure."
    misconceptions: "Leaving out the parentheses: \"add 8 and 7, then multiply by 2\" written as 8 + 7 × 2."
    misconceptions: "Writing the numbers in the order they are read for \"subtract 4 from 10\", giving 4 − 10."
    references: "Common Core Standards Writing Team (2011), Progressions for Operations and Algebraic Thinking, K-5"
  }
}

fragments {
  id: "frag-g5-interpret-expressions"
  instruction: "Fill in the blank. Do not solve."
  stage: STAGE_STRETCH
  items { kind { expression_in_words { compare: true } } count: 3 min_count: 2 }
  max_columns: 1
  design {
    purpose: "Compare an expression with one of its parts without evaluating it."
    principles: [PRINCIPLE_SELF_EXPLANATION]
    rationale: "The numbers in the parentheses are large on purpose, so working out the sum is slow and not needed. Students read 3 × (18,932 + 921) as three times the sum. This is the reading of expressions the standard asks for."
    misconceptions: "Working out the whole expression before answering, and losing the relation in the arithmetic."
    references: "Common Core Standards Writing Team (2011), Progressions for Operations and Algebraic Thinking, K-5"
  }
}

fragments {
  id: "frag-g5-two-patterns"
  instruction: "Complete each table. Then fill in the blank."
  stage: STAGE_PRACTICE
  items { kind { two_patterns {} } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Generate two patterns from two rules and compare corresponding terms."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Both patterns start at 0, and one rule adds a multiple of the other. In the table, each term of the second pattern is the same number of times the term beside it. Students describe that relation in the sentence below the table."
    misconceptions: "Comparing terms down one column instead of across the row."
    misconceptions: "Describing the difference between terms, such as \"4 more\", when the relation is a number of times."
    references: "Common Core Standards Writing Team (2011), Progressions for Operations and Algebraic Thinking, K-5"
  }
}

fragments {
  id: "frag-g5-graph-two-patterns"
  instruction: "Complete the table. Plot each ordered pair on the grid."
  stage: STAGE_APPLY
  items { kind { two_patterns { graph: true } } count: 2 min_count: 1 }
  max_columns: 1
  design {
    purpose: "Form ordered pairs from two patterns and graph them."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Each row of the table becomes an ordered pair, with the first pattern as the x-coordinate. The plotted points lie on a straight line through (0, 0). The question under the graph asks for the same relation the table showed, now seen in the coordinates."
    misconceptions: "Plotting the step number as the x-coordinate instead of the first pattern's term."
    misconceptions: "Reversing the order of the coordinates when plotting."
    references: "Common Core Standards Writing Team (2011), Progressions for Operations and Algebraic Thinking, K-5"
  }
}

fragments {
  id: "frag-g5-graph-a-pattern"
  instruction: "Use the graph to answer the questions."
  stage: STAGE_APPLY
  items { kind { coordinate_points { mode: MODE_PROBLEM } } count: 2 min_count: 1 }
  max_columns: 2
  design {
    purpose: "Read and extend a pattern graphed on a coordinate grid."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "The graph shows the first points of a real situation, such as dollars earned each hour. The first question reads a plotted point. The second asks for a point past the plotted ones, so students extend the pattern by its rule."
    misconceptions: "Reading the y-axis value from the wrong gridline when the axis counts by 2s, 3s or more."
    references: "Common Core Standards Writing Team (2012), Progressions for Geometry, K-6"
  }
}

worksheets {
  id: "ws-g5-parentheses"
  title: "Parentheses and brackets"
  seed: 501
  max_pages: 2
  placements { fragment_id: "frag-g5-parentheses" }
  placements { fragment_id: "frag-g5-brackets" }
  design {
    purpose: "Evaluate expressions with parentheses and brackets."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "One level of grouping comes first, then nested grouping."
  }
  home_tip: "Compare 2 + 3 × 4 with (2 + 3) × 4 and explain why the answers differ."
}

worksheets {
  id: "ws-g5-write-expressions"
  title: "Writing expressions"
  seed: 502
  max_pages: 2
  placements { fragment_id: "frag-g5-parentheses" count: 4 stage: STAGE_REVIEW omit_example: true }
  placements { fragment_id: "frag-g5-write-expressions" }
  placements { fragment_id: "frag-g5-interpret-expressions" }
  design {
    purpose: "Write expressions from words and interpret them without evaluating."
    principles: [PRINCIPLE_PREREQUISITE_REVIEW]
    rationale: "Evaluating a few expressions first recalls what parentheses do before students write their own."
  }
  home_tip: "Describe a two-step calculation in words, such as \"add 5 and 3, then double it\", and write it with parentheses."
}

worksheets {
  id: "ws-g5-two-patterns"
  title: "Two number patterns"
  seed: 503
  max_pages: 2
  placements { fragment_id: "frag-g5-two-patterns" count: 2 }
  placements { fragment_id: "frag-g5-graph-two-patterns" count: 1 }
  design {
    purpose: "Generate, compare and graph two related number patterns."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "The table shows the relation between the patterns first. The graph then shows the same relation as points on a line."
  }
  home_tip: "Compare saving $3 a week with saving $6 a week. List both totals for five weeks."
}

# ── Place value and decimals ───────────────────────────────────────────────

fragments {
  id: "frag-g5-ten-times"
  instruction: "Write the value of each digit. Then compare the values."
  stage: STAGE_INTRODUCE
  example {
    item { place_value_ten_times {} }
    seed: 4
    text: "Each place is worth **10 times** the place to its right, and **1/10** of the place to its left."
  }
  items { kind { place_value_ten_times {} } count: 6 min_count: 3 }
  max_columns: 2
  design {
    purpose: "Recognize that a digit is worth 10 times as much as the same digit one place to its right, and 1/10 as much as the same digit one place to its left."
    principles: [PRINCIPLE_WORKED_EXAMPLE, PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Each number has the same digit twice, so the two values differ only by place. Most pairs are one place apart and some are two, which gives 10 times and 100 times. The comparison is asked both ways, as times as much and as a fraction of, because the standard names both."
    misconceptions: "Thinking places after the decimal point grow to the right, as tens and hundreds do on the left."
    misconceptions: "Thinking the digit further right is worth more because it comes later."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-powers-of-ten"
  instruction: "Multiply or divide."
  stage: STAGE_PRACTICE
  example {
    item { powers_of_ten {} }
    seed: 1
    text: "The exponent tells how many 10s are multiplied: **10³ = 10 × 10 × 10**."
  }
  items { kind { powers_of_ten {} } count: 12 min_count: 6 }
  max_columns: 3
  design {
    purpose: "Write powers of 10 with exponents, and multiply and divide whole numbers by powers of 10."
    principles: [PRINCIPLE_WORKED_EXAMPLE, PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Items mix three forms: a power of 10 alone, a number times a power of 10, and a number divided by one. Each form shows the pattern in the number of zeros. The exponent runs from 2 to 5 so the pattern holds beyond 1,000."
    misconceptions: "Reading 10³ as 10 × 3 = 30."
    misconceptions: "Writing one zero too many or too few when the exponent is large."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-powers-of-ten-chart"
  instruction: "Write the answer in the bottom row of the chart."
  stage: STAGE_GUIDED
  example {
    item { powers_of_ten { decimals: true chart: true } }
    seed: 2
    text: "Each digit moves one place for each 10. The **decimal point stays** in its place."
  }
  items { kind { powers_of_ten { decimals: true chart: true } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Multiply and divide decimals by 10, 100 and 1,000 by moving digits between places."
    principles: [PRINCIPLE_CONCRETENESS_FADING, PRINCIPLE_WORKED_EXAMPLE]
    rationale: "The chart shows the digits moving while the decimal point stays fixed. The column headings show each place as a power of 10 and as its value. Students write each digit in its new place, including zeros that hold a place."
    misconceptions: "Moving the digits the wrong way: to the right to multiply."
    misconceptions: "Leaving out the zero in the ones place, writing .28 for 2.8 ÷ 10 with no 0 before the point."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-powers-of-ten-decimals"
  instruction: "Multiply or divide."
  stage: STAGE_PRACTICE
  items { kind { powers_of_ten { decimals: true } } count: 12 min_count: 6 }
  max_columns: 3
  design {
    purpose: "Multiply and divide decimals by 10, 100 and 1,000 without a chart."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION, PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "These items follow the chart items and use the same numbers and powers. Some divisors are written with exponents, such as 10², so students connect both notations. The answers need zeros added or removed, so a rule of only adding zeros does not work."
    misconceptions: "Adding a zero to the end of a decimal to multiply by 10: 4.7 × 10 written as 4.70."
    misconceptions: "Counting zeros in 1,000 but moving the digits only one place."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-decimal-chart"
  instruction: "Write the number shown. Then write the value of the digit."
  stage: STAGE_GUIDED
  items { kind { decimal_forms { mode: MODE_CHART } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Read a decimal to thousandths from a place-value chart and give the value of one digit."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "The chart names each place, so the value of a digit can be read from its column. Some numbers have a zero in a place, which students must keep when they write the number. The chart comes before names and expanded form because it shows the places directly."
    misconceptions: "Reading the digit in the tenths place as tens."
    misconceptions: "Leaving out a zero that holds a place: 0.024 written as 0.24."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-decimal-expanded"
  instruction: "Write each number in standard form."
  stage: STAGE_PRACTICE
  items { kind { decimal_forms { mode: MODE_EXPANDED } } count: 4 min_count: 2 }
  max_columns: 1
  design {
    purpose: "Write a decimal to thousandths from its expanded form."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Expanded form uses fractions for the decimal places, such as 3 × 1/100, as the standard writes it. Places with a zero digit are left out of the expanded form. Students must notice the missing place and write a zero in it."
    misconceptions: "Writing the digits side by side without zeros for the missing places: 6 × 1/10 + 6 × 1/1000 written as 0.66."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-decimal-words"
  instruction: "Write each number in standard form."
  stage: STAGE_PRACTICE
  example {
    item { decimal_forms { mode: MODE_WORDS } }
    seed: 6
    text: "Read the decimal point as **and**. The last word names the place of the last digit."
  }
  items { kind { decimal_forms { mode: MODE_WORDS } } count: 6 min_count: 4 }
  max_columns: 1
  design {
    purpose: "Write a decimal to thousandths from its number name."
    principles: [PRINCIPLE_WORKED_EXAMPLE, PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Number names come last because they hide the places that the chart and expanded form show. The final word, such as thousandths, tells how many digits follow the point. Some names have no whole-number part, so the answer begins with 0."
    misconceptions: "Writing twenty-six thousandths as 0.26, without the zero that holds the tenths place."
    misconceptions: "Writing \"and\" as a decimal point when it joins hundreds and tens, as in one hundred and five."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-compare-thousandths"
  instruction: "Compare. Write <, >, or =."
  stage: STAGE_PRACTICE
  example {
    item { decimal_forms { mode: MODE_COMPARE } }
    seed: 2
    text: "Line up the decimal points. Compare the digits **place by place**, from the left."
  }
  items { kind { decimal_forms { mode: MODE_COMPARE } } count: 15 min_count: 9 }
  max_columns: 3
  design {
    purpose: "Compare two decimals to thousandths."
    principles: [PRINCIPLE_WORKED_EXAMPLE, PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "One pair in three has the shorter decimal larger, such as 0.4 and 0.389. These pairs catch students who think more digits means a larger number. A few pairs are equal with zeros added, such as 0.4 and 0.400, and the rest differ in one place."
    misconceptions: "Thinking the decimal with more digits is larger: 0.389 > 0.4."
    misconceptions: "Thinking the decimal with fewer digits is larger because tenths are bigger than thousandths."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-round-decimals-line"
  instruction: "Round. Use the number line."
  stage: STAGE_GUIDED
  example {
    item { round_decimal { number_line: true } }
    seed: 3
    text: "The middle mark is **halfway**. A number at the halfway mark or past it rounds up."
  }
  items { kind { round_decimal { number_line: true } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Round a decimal using a number line between the two possible answers."
    principles: [PRINCIPLE_NUMBER_LINE, PRINCIPLE_WORKED_EXAMPLE]
    rationale: "The number line shows the two possible answers at its ends and the halfway point between them. Students see which end the number is closer to before they apply a rule. The arrow marks the number on the line."
    misconceptions: "Rounding by dropping digits, so 3.46 to the nearest tenth becomes 3.4."
    misconceptions: "Labelling the ends of the line with the wrong place, such as tenths when rounding to hundredths."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-round-decimals"
  instruction: "Round each number."
  stage: STAGE_PRACTICE
  items { kind { round_decimal {} } count: 9 min_count: 6 }
  max_columns: 3
  design {
    purpose: "Round decimals to the nearest whole number, tenth or hundredth."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE, PRINCIPLE_INTERLEAVING]
    rationale: "The three places are mixed, so students read which place each item names before rounding. Some numbers have two more digits than the place they round to. Only the digit right after the rounding place decides the answer."
    misconceptions: "Rounding 3.46 to the nearest tenth as 3.4 by dropping the last digit."
    misconceptions: "Rounding in two steps, 2.449 to 2.45 and then to 2.5, instead of once to 2.4."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

worksheets {
  id: "ws-g5-decimal-place-value"
  title: "Place value with decimals"
  seed: 511
  max_pages: 2
  placements { fragment_id: "frag-g5-ten-times" }
  placements { fragment_id: "frag-g5-decimal-chart" }
  design {
    purpose: "Understand that each place is worth 10 times the place to its right."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Comparing two equal digits comes first, because it isolates the 10-times relation. Reading the chart then uses that relation to name each place."
  }
  home_tip: "Use a dollar, a dime and a penny. Each coin is worth 10 of the next smaller one."
}

worksheets {
  id: "ws-g5-powers-of-ten"
  title: "Powers of 10"
  seed: 512
  max_pages: 2
  placements { fragment_id: "frag-g5-powers-of-ten" count: 9 }
  placements { fragment_id: "frag-g5-powers-of-ten-chart" }
  placements { fragment_id: "frag-g5-powers-of-ten-decimals" count: 9 }
  design {
    purpose: "Multiply and divide by powers of 10, and write powers of 10 with exponents."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Whole numbers come first, where the pattern is in the zeros. The chart then shows the same pattern with decimals as digits moving, before the decimal items without the chart."
  }
  home_tip: "Change dollars to cents and cents to dollars, such as $4.25 and 425 cents, and note where the decimal point goes."
}

worksheets {
  id: "ws-g5-read-write-decimals"
  title: "Reading and writing decimals"
  seed: 513
  max_pages: 2
  placements { fragment_id: "frag-g5-decimal-chart" }
  placements { fragment_id: "frag-g5-decimal-expanded" }
  placements { fragment_id: "frag-g5-decimal-words" }
  design {
    purpose: "Read and write decimals to thousandths in standard form, expanded form and words."
    principles: [PRINCIPLE_CONCRETENESS_FADING, PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "The chart shows the places, expanded form names them, and number names hide them. The sections follow that order."
  }
  home_tip: "Read the prices or weights on food labels aloud, saying \"and\" for the decimal point."
}

worksheets {
  id: "ws-g5-compare-decimals"
  title: "Comparing decimals to thousandths"
  seed: 514
  max_pages: 1
  placements { fragment_id: "frag-compare-decimals" count: 6 stage: STAGE_REVIEW }
  placements { fragment_id: "frag-g5-compare-thousandths" count: 12 }
  design {
    purpose: "Compare decimals to thousandths."
    principles: [PRINCIPLE_PREREQUISITE_REVIEW]
    rationale: "Comparing to hundredths, from grade 4, comes first. The thousandths section then adds one more place."
  }
  home_tip: "Read both numbers aloud before choosing the sign, such as \"four tenths\" and \"three hundred eighty-nine thousandths\"."
}

worksheets {
  id: "ws-g5-round-decimals"
  title: "Rounding decimals"
  seed: 515
  max_pages: 2
  placements { fragment_id: "frag-g5-round-decimals-line" }
  placements { fragment_id: "frag-g5-round-decimals" }
  design {
    purpose: "Round decimals to any place."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "The number line shows the two possible answers before students round without it."
  }
  home_tip: "Round prices at the store to the nearest dollar and add them to estimate the total."
}

# ── Multiplying and dividing whole numbers ─────────────────────────────────

fragments {
  id: "frag-g5-multiply-by-2-digits"
  instruction: "Multiply."
  stage: STAGE_GUIDED
  example {
    item { multi_digit_multiply { top_digits: 2 bottom_digits: 2 } }
    seed: 5
    text: "Multiply by the ones. Then multiply by the tens: that row ends in **0**. Add the two rows."
  }
  items { kind { multi_digit_multiply { top_digits: 2 bottom_digits: 2 } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Multiply two-digit numbers with the standard algorithm."
    principles: [PRINCIPLE_WORKED_EXAMPLE, PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Each partial product has its own row, labelled with what it stands for, such as 60 × 59. The labels link the algorithm to the place-value strategies from grade 4. Small boxes above the top number hold the regrouped digits."
    misconceptions: "Forgetting the zero in the tens row: 23 × 14 with 23 written for 10 × 23."
    misconceptions: "Adding a regrouped digit from the ones row into the tens row."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-multiply-3-by-2-digits"
  instruction: "Multiply."
  stage: STAGE_PRACTICE
  items { kind { multi_digit_multiply { top_digits: 3 bottom_digits: 2 } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Multiply a three-digit number by a two-digit number with the standard algorithm."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "The steps are the same as for two-digit numbers, with one more digit in each row. Some top numbers contain a zero, which produces a zero in the partial product. The row labels stay, so a wrong row can be traced to its step."
    misconceptions: "Skipping a zero digit in the top number and shifting the rest of the row left."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-multiply-4-by-2-digits"
  instruction: "Multiply."
  stage: STAGE_STRETCH
  items { kind { multi_digit_multiply { top_digits: 4 bottom_digits: 2 } } count: 2 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Multiply a four-digit number by a two-digit number with the standard algorithm."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Four-digit factors give five- and six-digit products, which tests whether regrouping is tracked across many places. Two items are enough to show fluency. Students who finish the earlier sections accurately are ready for them."
    misconceptions: "Losing track of regrouped digits across four places."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-divide-with-multiples"
  instruction: "Complete the multiples. Use them to divide."
  stage: STAGE_GUIDED
  items { kind { divide_by_two_digits { dividend_digits: 3 multiples: true } } count: 2 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Divide a three-digit number by a two-digit number, estimating each quotient digit from a list of multiples."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Choosing each quotient digit is the hard step with a two-digit divisor. A short list of 1, 2, 5 and 10 times the divisor turns that choice into a comparison. The list is a place-value strategy the standard names, and it is dropped in the next section."
    misconceptions: "Keeping a first estimate that is too big or too small instead of adjusting it."
    misconceptions: "Writing the first quotient digit over the wrong place of the dividend."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-divide-3-digits-by-2"
  instruction: "Divide."
  stage: STAGE_PRACTICE
  items { kind { divide_by_two_digits { dividend_digits: 3 } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Divide a three-digit number by a two-digit number."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "These items have no list of multiples, so students estimate by rounding the divisor. Every quotient has two digits and no remainder, so the answer can be checked by multiplying. The space under each item has a full row for every product and difference."
    misconceptions: "Keeping a first estimate that is too big or too small instead of adjusting it."
    misconceptions: "Forgetting to bring down the next digit before the next step."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-divide-4-digits-by-2"
  instruction: "Divide. Write the remainder."
  stage: STAGE_PRACTICE
  items { kind { divide_by_two_digits { dividend_digits: 4 remainders: true } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Divide a four-digit number by a two-digit number, with remainders."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Four-digit dividends give three-digit quotients, so the estimate-multiply-subtract cycle runs three times. Some items have a remainder of 0, so students decide whether one is left. The remainder must be less than the divisor, which checks the last estimate."
    misconceptions: "Writing a remainder larger than the divisor."
    misconceptions: "Leaving out a zero in the quotient when a partial dividend is smaller than the divisor."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

worksheets {
