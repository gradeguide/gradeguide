# ── Fractions: dividing and multiplying ────────────────────────────────────

fragments {
  id: "frag-g5-fraction-as-division"
  instruction: "Write each division as a fraction, or each fraction as a division."
  stage: STAGE_INTRODUCE
  explainer: "3 ÷ 4 = 3/4. Sharing 3 pizzas among 4 people gives each person 3/4 of a pizza."
  items { kind { fraction_as_division {} } count: 9 min_count: 6 }
  max_columns: 2
  design {
    purpose: "Understand a fraction a/b as a divided by b."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    misconceptions: "Thinking you cannot divide a smaller number by a larger one."
  }
}

fragments {
  id: "frag-g5-fraction-times-whole"
  instruction: "Multiply. Write the answer in simplest form."
  stage: STAGE_INTRODUCE
  explainer: "2/3 × 6 means 2/3 of 6. One third of 6 is 2, so two thirds is 4."
  items { kind { fraction_multiply { mode: MODE_WHOLE } } count: 8 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Multiply a fraction by a whole number as a part of a quantity."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
  }
}

fragments {
  id: "frag-g5-fraction-times-fraction-model"
  instruction: "The grid shows the product. Write it as a fraction."
  stage: STAGE_GUIDED
  explainer: "The columns show the first fraction and the rows show the second. The dark part, where they overlap, is the product."
  items { kind { fraction_multiply { mode: MODE_FRACTION model: true } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "See the product of two fractions as part of a part, on an area model."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Counting dark parts out of all parts shows why the numerators and the denominators multiply."
  }
}

fragments {
  id: "frag-g5-fraction-times-fraction"
  instruction: "Multiply. Write the answer in simplest form."
  stage: STAGE_PRACTICE
  explainer: "Multiply the numerators and the denominators: 2/3 × 4/5 = 8/15."
  items { kind { fraction_multiply { mode: MODE_FRACTION } } count: 8 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Multiply two fractions."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    misconceptions: "Making the denominators the same first, as for adding."
  }
}

fragments {
  id: "frag-g5-fraction-area"
  instruction: "Find the area of each rectangle."
  stage: STAGE_APPLY
  explainer: "Area is length times width, for fraction sides too: 1/2 m by 3/4 m is 3/8 square m."
  items { kind { fraction_multiply { mode: MODE_AREA } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Find the area of a rectangle with fraction side lengths by multiplying."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
}

fragments {
  id: "frag-g5-scaling"
  instruction: "Write <, > or = without multiplying."
  stage: STAGE_PRACTICE
  explainer: "Multiplying by a fraction less than 1 makes a number smaller. Multiplying by a fraction more than 1 makes it bigger."
  items { kind { scaling_compare {} } count: 12 min_count: 6 }
  max_columns: 3
  design {
    purpose: "Predict whether a product is bigger or smaller than a factor from the size of the other factor."
    principles: [PRINCIPLE_SELF_EXPLANATION]
    misconceptions: "Thinking multiplying always makes a number bigger."
  }
}

fragments {
  id: "frag-g5-unit-fraction-by-whole"
  instruction: "Divide. Write the answer as a fraction."
  stage: STAGE_INTRODUCE
  explainer: "1/3 ÷ 4 shares one third into 4 equal parts. Each part is 1/12."
  items { kind { unit_fraction_divide {} } count: 6 min_count: 4 }
  max_columns: 3
  design {
    purpose: "Divide a unit fraction by a whole number."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
  }
}

fragments {
  id: "frag-g5-whole-by-unit-fraction"
  instruction: "Divide. Use the bars when they help."
  stage: STAGE_GUIDED
  explainer: "4 ÷ 1/3 asks how many thirds are in 4 wholes. Each whole has 3 thirds, so 4 × 3 = 12."
  items { kind { unit_fraction_divide { whole_by_unit: true } } count: 6 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Divide a whole number by a unit fraction."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    misconceptions: "Thinking dividing always makes a number smaller."
  }
}

