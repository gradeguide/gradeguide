# ── Fractions: adding and subtracting ──────────────────────────────────────

fragments {
  id: "frag-g5-unlike-fractions-model"
  instruction: "Use the grids to add."
  stage: STAGE_INTRODUCE
  explainer: "Each grid is cut both ways, so both fractions are counted in the same small parts. Count the shaded parts in each grid, then add."
  items { kind { unlike_fractions { model: true denominators: [2, 3, 4, 5] } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "See why fractions with different denominators are added by rewriting them in a common denominator."
    principles: [PRINCIPLE_CONCRETENESS_FADING, PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Cutting the columns of one fraction by the rows of the other gives a common unit the child can count."
    misconceptions: "Adding tops and bottoms: 1/3 + 1/4 = 2/7."
  }
}

fragments {
  id: "frag-g5-add-unlike-fractions"
  instruction: "Add. Write the answer in simplest form."
  stage: STAGE_PRACTICE
  explainer: "Make the denominators the same first. For 1/3 + 1/4, use twelfths: 4/12 + 3/12 = 7/12."
  items { kind { unlike_fractions {} } count: 8 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Add fractions with different denominators by rewriting them with a common denominator."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    misconceptions: "Adding tops and bottoms: 1/3 + 1/4 = 2/7."
  }
}

fragments {
  id: "frag-g5-subtract-unlike-fractions"
  instruction: "Subtract. Write the answer in simplest form."
  stage: STAGE_PRACTICE
  items { kind { unlike_fractions { subtract: true } } count: 8 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Subtract fractions with different denominators."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

fragments {
  id: "frag-g5-add-unlike-mixed"
  instruction: "Add the mixed numbers."
  stage: STAGE_PRACTICE
  explainer: "Add the whole numbers and the fractions. If the fractions make more than 1, trade them for a whole."
  items { kind { unlike_fractions { mixed: true denominators: [2, 3, 4, 5, 6, 8] } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Add mixed numbers with different denominators."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

fragments {
  id: "frag-g5-subtract-unlike-mixed"
  instruction: "Subtract the mixed numbers."
  stage: STAGE_STRETCH
  explainer: "If the fraction you take away is bigger, trade one whole for fraction parts first."
  items { kind { unlike_fractions { mixed: true subtract: true denominators: [2, 3, 4, 5, 6, 8] } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Subtract mixed numbers with different denominators, trading a whole when needed."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
  }
}

