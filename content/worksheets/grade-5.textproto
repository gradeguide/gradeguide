  placements { fragment_id: "frag-g5-round-decimals" }
  design {
    purpose: "Round decimals to any place."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "The number line shows the two choices before the child rounds without it."
  }
