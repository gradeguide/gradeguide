}

# ── Fractions: dividing and multiplying ────────────────────────────────────

fragments {
  id: "frag-g5-fraction-as-division"
  instruction: "Fill in the boxes."
  stage: STAGE_INTRODUCE
  explainer: "Example: 3 ÷ 4 = 3/4. If 4 people share 3 pizzas equally, each gets 3/4 of a pizza."
  items { kind { fraction_as_division {} } count: 9 min_count: 6 }
  max_columns: 2
  design {
    purpose: "Interpret a fraction a/b as a divided by b."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "The items come in three groups: division to fraction, fraction to division, and sharing stories. The stories give the symbols a meaning. Some quotients are more than 1, so students see that a/b works for any whole numbers."
    misconceptions: "Thinking a smaller number cannot be divided by a larger one."
    misconceptions: "Writing the divisor on top: 3 ÷ 4 written as 4/3."
    references: "Common Core Standards Writing Team (2013), Progressions for Number and Operations—Fractions, 3-5"
  }
}

fragments {
  id: "frag-g5-fraction-times-whole"
  instruction: "Multiply. Write the answer in simplest form."
  stage: STAGE_INTRODUCE
  explainer: "Example: 2/3 × 6 = 4. One third of 6 is 2, so two thirds of 6 is 4."
  items { kind { fraction_multiply { mode: MODE_WHOLE } } count: 8 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Multiply a fraction by a whole number as a part of a quantity."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Half of the whole numbers are multiples of the denominator, so the answer is a whole number found by sharing. The rest give fraction answers, which students simplify or write as mixed numbers. Both kinds use the same reading: a/b of q is a parts of q cut into b equal parts."
    misconceptions: "Multiplying the whole number by both numerator and denominator: 2/3 × 6 = 12/18."
    references: "Common Core Standards Writing Team (2013), Progressions for Number and Operations—Fractions, 3-5"
  }
}

fragments {
  id: "frag-g5-fraction-times-fraction-model"
  instruction: "Write the product shown by the grid."
  stage: STAGE_GUIDED
  example {
    item { fraction_multiply { mode: MODE_FRACTION model: true } }
    seed: 2
    text: "The columns show the first fraction and the rows show the second. The **dark** part is the product."
  }
  items { kind { fraction_multiply { mode: MODE_FRACTION model: true } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Find the product of two fractions as a part of a part on an area model."
    principles: [PRINCIPLE_CONCRETENESS_FADING, PRINCIPLE_WORKED_EXAMPLE]
    rationale: "The square is one whole. The dark overlap is the product: its parts are the numerators multiplied, and all the parts are the denominators multiplied. Counting both shows why the rule for multiplying fractions works."
    misconceptions: "Counting the lightly shaded parts as part of the product."
    misconceptions: "Using the number of shaded rows as the denominator."
    references: "Common Core Standards Writing Team (2013), Progressions for Number and Operations—Fractions, 3-5"
  }
}

fragments {
  id: "frag-g5-fraction-times-fraction"
  instruction: "Multiply. Write the answer in simplest form."
  stage: STAGE_PRACTICE
  explainer: "Example: 2/3 × 4/5 = (2 × 4)/(3 × 5) = 8/15"
  items { kind { fraction_multiply { mode: MODE_FRACTION } } count: 8 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Multiply two fractions."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "These items follow the area models and use the rule they showed. Some products can be simplified, so students check the final form. Denominators stay at 6 or less to keep the products small."
    misconceptions: "Making the denominators the same first, as for adding."
    misconceptions: "Multiplying the numerators and keeping one denominator: 2/3 × 4/3 = 8/3."
    references: "Common Core Standards Writing Team (2013), Progressions for Number and Operations—Fractions, 3-5"
  }
}

fragments {
  id: "frag-g5-fraction-area-tiles"
  instruction: "Find the area of the shaded rectangle."
  stage: STAGE_GUIDED
  example {
    item { fraction_multiply { mode: MODE_AREA tiles: true } }
    seed: 3
    text: "The square has sides of **1 unit**. Count the tiles in the rectangle. Then check by multiplying the side lengths."
  }
  items { kind { fraction_multiply { mode: MODE_AREA tiles: true } } count: 2 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Find the area of a rectangle with fraction side lengths by tiling it with unit-fraction tiles."
    principles: [PRINCIPLE_CONCRETENESS_FADING, PRINCIPLE_WORKED_EXAMPLE]
    rationale: "The rectangle sits inside a square of side 1, cut into tiles of side 1/b by 1/d. Students find the area of one tile, count the shaded tiles, and multiply. The standard asks for this tiling so that the area found by counting matches the product of the sides."
    misconceptions: "Treating each tile as 1 square unit."
    misconceptions: "Adding the side lengths instead of multiplying them."
    references: "Common Core Standards Writing Team (2013), Progressions for Number and Operations—Fractions, 3-5"
  }
}

fragments {
  id: "frag-g5-fraction-area"
  instruction: "Find the area of each rectangle."
  stage: STAGE_APPLY
  items { kind { fraction_multiply { mode: MODE_AREA } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Find the area of a rectangle with fraction side lengths by multiplying."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "The rectangles are drawn to scale without tiles, so students multiply the side lengths. Each answer has square units. The drawings keep the sides in proportion, so a longer side looks longer."
    misconceptions: "Writing the area in units instead of square units."
    references: "Common Core Standards Writing Team (2013), Progressions for Number and Operations—Fractions, 3-5"
  }
}

fragments {
  id: "frag-g5-scaling"
  instruction: "Compare. Write <, >, or =. Do not multiply."
  stage: STAGE_PRACTICE
  explainer: "A number times a fraction less than 1 is less than the number."
  items { kind { scaling_compare {} } count: 12 min_count: 6 }
  max_columns: 3
  design {
    purpose: "Predict whether a product is greater or less than a factor from the size of the other factor."
    principles: [PRINCIPLE_SELF_EXPLANATION]
    rationale: "Fractions less than 1 and greater than 1 take turns, and one item multiplies by a fraction equal to 1. The whole numbers are too large to multiply quickly. Students must reason about the size of the fraction instead."
    misconceptions: "Thinking multiplying always makes a number bigger."
    misconceptions: "Comparing the numerators only, without seeing whether the fraction is more or less than 1."
    references: "Common Core Standards Writing Team (2013), Progressions for Number and Operations—Fractions, 3-5"
  }
}

fragments {
  id: "frag-g5-unit-fraction-by-whole-model"
  instruction: "Divide. Use the model."
  stage: STAGE_INTRODUCE
  example {
    item { unit_fraction_divide { model: true } }
    seed: 4
    text: "The shaded column is the unit fraction. The rows cut it into equal shares. The **dark** share is the answer."
  }
  items { kind { unit_fraction_divide { model: true } } count: 3 min_count: 2 }
  max_columns: 3
  design {
    purpose: "Divide a unit fraction by a whole number using an area model."
    principles: [PRINCIPLE_CONCRETENESS_FADING, PRINCIPLE_WORKED_EXAMPLE]
    rationale: "The square is one whole and the shaded column is 1/b of it. The rows cut that column into equal shares, and the dark share is the quotient. Because the rows cross the whole square, the model shows what fraction of the whole one share is."
    misconceptions: "Naming the share by the parts of the column only: 1/3 ÷ 4 = 1/4."
    references: "Common Core Standards Writing Team (2013), Progressions for Number and Operations—Fractions, 3-5"
  }
}

fragments {
  id: "frag-g5-unit-fraction-by-whole"
  instruction: "Divide. Write the answer as a fraction."
  stage: STAGE_PRACTICE
  items { kind { unit_fraction_divide {} } count: 6 min_count: 4 }
  max_columns: 3
  design {
    purpose: "Divide a unit fraction by a whole number."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "These items follow the model and use larger denominators that would be hard to draw. Each answer is a unit fraction with a larger denominator. Students can check by multiplying the answer by the whole number."
    misconceptions: "Multiplying the numerator instead of the denominator: 1/3 ÷ 4 = 4/3."
    references: "Common Core Standards Writing Team (2013), Progressions for Number and Operations—Fractions, 3-5"
  }
}

fragments {
  id: "frag-g5-whole-by-unit-fraction"
  instruction: "Divide."
  stage: STAGE_GUIDED
  explainer: "Example: 4 ÷ 1/3 = 12. Each whole has 3 thirds, so 4 wholes have 12 thirds."
  items { kind { unit_fraction_divide { whole_by_unit: true } } count: 6 min_count: 4 }
  max_columns: 2
  design {
    purpose: "Divide a whole number by a unit fraction."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Dividing by 1/b asks how many b-ths fit in the whole number. Items with up to 4 wholes show one bar per whole, cut into b parts to count. Larger items have no bars, so students use the counting rule."
    misconceptions: "Thinking dividing always makes a number smaller: 4 ÷ 1/3 = 4/3."
    references: "Common Core Standards Writing Team (2013), Progressions for Number and Operations—Fractions, 3-5"
  }
}

worksheets {
  id: "ws-g5-fraction-as-division"
  title: "Fractions as division"
  seed: 551
  max_pages: 1
  placements { fragment_id: "frag-g5-fraction-as-division" }
  design {
    purpose: "Interpret a fraction as division and solve sharing problems."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Symbols in both directions come before the stories that give them meaning."
  }
  home_tip: "Share 3 crackers equally among 4 people. Each person gets 3/4 of a cracker."
}

worksheets {
  id: "ws-g5-multiply-fractions"
  title: "Multiplying fractions"
  seed: 552
  max_pages: 2
  placements { fragment_id: "frag-g5-fraction-times-whole" count: 6 }
  placements { fragment_id: "frag-g5-fraction-times-fraction-model" }
  placements { fragment_id: "frag-g5-fraction-times-fraction" count: 6 }
  design {
    purpose: "Multiply a fraction by a whole number and by a fraction."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "A fraction of a whole number comes first. The area model then shows a fraction of a fraction before the rule."
  }
  home_tip: "Fold a sheet of paper in half, then fold the half into thirds. One small part is 1/3 of 1/2, or 1/6 of the sheet."
}

worksheets {
  id: "ws-g5-area-with-fractions"
  title: "Area with fraction sides"
  seed: 553
  max_pages: 2
  placements { fragment_id: "frag-g5-fraction-times-fraction" count: 2 stage: STAGE_REVIEW }
  placements { fragment_id: "frag-g5-fraction-area-tiles" }
  placements { fragment_id: "frag-g5-fraction-area" count: 2 }
  design {
    purpose: "Find areas of rectangles with fraction side lengths."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Tiled rectangles come before plain ones, so the product is first a count of tiles."
  }
  home_tip: "Measure a small rectangle, such as a sticky note, in feet or meters and find its area as a fraction."
}

worksheets {
  id: "ws-g5-scaling"
  title: "Multiplying as scaling"
