}

# ── Decimal arithmetic ─────────────────────────────────────────────────────

fragments {
  id: "frag-g5-add-decimals"
  instruction: "Add."
  stage: STAGE_PRACTICE
  example {
    item { decimal_arithmetic { op: OP_ADD } }
    seed: 1
    text: "Line up the **decimal points**. Add as with whole numbers."
  }
  items { kind { decimal_arithmetic { op: OP_ADD } } count: 6 min_count: 3 }
  max_columns: 3
  design {
    purpose: "Add decimals to hundredths in columns."
    principles: [PRINCIPLE_WORKED_EXAMPLE, PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "The numbers are already set in columns with the points lined up, so the focus is regrouping across the point. Small boxes above the columns hold regrouped digits. Lining up numbers with different decimal places is practised in the next section."
    misconceptions: "Forgetting to regroup from the tenths into the ones."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-add-decimals-in-a-line"
  instruction: "Add. Write the numbers in columns first."
  stage: STAGE_PRACTICE
  items { kind { decimal_arithmetic { op: OP_ADD in_a_line: true } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Add decimals with different numbers of decimal places."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Each pair has a different number of decimal places, and some include a whole number. Lining up the last digits gives a wrong answer, so students must line up the points. Writing a zero to fill an empty place is shown in the answer key."
    misconceptions: "Lining up the last digits instead of the decimal points: 4.5 + 2.37 worked as 0.45 + 2.37."
    misconceptions: "Not knowing where the decimal point is in a whole number such as 6."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-subtract-decimals"
  instruction: "Subtract."
  stage: STAGE_PRACTICE
  items { kind { decimal_arithmetic { op: OP_SUBTRACT } } count: 6 min_count: 3 }
  max_columns: 3
  design {
    purpose: "Subtract decimals to hundredths in columns."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Subtraction follows addition with the same column layout. Most items need regrouping across the decimal point. The boxes above the columns hold the regrouped digits."
    misconceptions: "Subtracting the smaller digit from the larger in each column, whichever number it is in."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-subtract-decimals-in-a-line"
  instruction: "Subtract. Write the numbers in columns first."
  stage: STAGE_STRETCH
  items { kind { decimal_arithmetic { op: OP_SUBTRACT in_a_line: true } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Subtract decimals with different numbers of decimal places."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "When the first number has fewer decimal places, students write zeros in the empty places before subtracting. Items such as 6 − 2.45 need two zeros and regrouping across them. These are the hardest decimal subtractions at this grade."
    misconceptions: "Bringing down the digits of the second number when the first has no digits above them: 6 − 2.45 = 4.45."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-multiply-decimals"
  instruction: "Multiply."
  stage: STAGE_PRACTICE
  explainer: "Example: 2.4 × 3 = 7.2, because 24 tenths × 3 = 72 tenths."
  items { kind { decimal_arithmetic { op: OP_MULTIPLY second: SECOND_WHOLE } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Multiply a decimal to hundredths by a whole number."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "A decimal times a whole number can be read as tenths or hundredths in groups: 2.4 × 3 is 24 tenths × 3. An estimate from the whole-number parts places the decimal point. Grade 5 relies on these place-value strategies before any rule for counting decimal places."
    misconceptions: "Placing the decimal point by lining it up with the factors, as in addition."
    misconceptions: "Ignoring the decimal point and writing 2.4 × 3 = 72."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-multiply-decimals-by-decimals"
  instruction: "Multiply."
  stage: STAGE_STRETCH
  explainer: "Example: 0.3 × 0.4 = 0.12, because 3 tenths of 4 tenths is 12 hundredths."
  items { kind { decimal_arithmetic { op: OP_MULTIPLY second: SECOND_DECIMAL } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Multiply two decimals in tenths."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "A tenth of a tenth is a hundredth, so the product of two numbers in tenths is in hundredths. Some factors are less than 1, which makes the product smaller than the other factor. That result surprises students who expect multiplying to make numbers larger."
    misconceptions: "Thinking multiplying always makes a number bigger: 0.6 × 0.7 = 4.2."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-divide-decimals"
  instruction: "Divide."
  stage: STAGE_PRACTICE
  explainer: "Example: 7.2 ÷ 3 = 2.4, because 72 tenths ÷ 3 = 24 tenths."
  items { kind { decimal_arithmetic { op: OP_DIVIDE second: SECOND_WHOLE } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Divide a decimal to hundredths by a whole number."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Dividing by a whole number shares tenths or hundredths into equal groups, so the quotient is in the same unit. Every item divides exactly. Students can check each answer by multiplying."
    misconceptions: "Dropping the decimal point in the quotient: 7.2 ÷ 3 = 24."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

fragments {
  id: "frag-g5-divide-by-decimals"
  instruction: "Divide."
  stage: STAGE_STRETCH
  explainer: "Example: 3.6 ÷ 0.4 = 9, because 36 tenths ÷ 4 tenths = 9."
  items { kind { decimal_arithmetic { op: OP_DIVIDE second: SECOND_DECIMAL } } count: 4 min_count: 2 }
  max_columns: 2
  design {
    purpose: "Divide a decimal by a decimal in tenths."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Dividing by a decimal asks how many of it fit, so 3.6 ÷ 0.4 counts groups of 4 tenths in 36 tenths. Every quotient is a whole number. The quotient is larger than the dividend, which corrects the belief that dividing always makes a number smaller."
    misconceptions: "Thinking dividing always makes a number smaller: 3.6 ÷ 0.4 = 0.9."
    references: "Common Core Standards Writing Team (2015), Progressions for Number and Operations in Base Ten, K-5"
  }
}

