# proto-file: worksheet/proto/v1/worksheet.proto
# proto-message: gradeguide.worksheet.v1.Library
#
# Worksheets, each a run of fragments. The same fragment appears on several
# worksheets with different counts, numbers and seeds.

worksheets {
  id: "ws-what-a-fraction-means"
  title: "What a fraction means"
  home_tip: "Fold a paper strip into equal parts and ask what one part is called."
  seed: 101
  placements { fragment_id: "frag-name-the-shaded-fraction" }
  placements { fragment_id: "frag-shade-the-fraction" }
  design {
    purpose: "Read and make fractions of a whole."
    rationale: "A worked example, then reading fractions, then making them: the task turns around once the child has seen it done."
  }
}

worksheets {
  id: "ws-fractions-on-a-number-line"
  max_pages: 2
  title: "Fractions on a number line"
  seed: 102
  placements { fragment_id: "frag-fraction-at-arrow" }
  placements { fragment_id: "frag-label-the-marks" }
  placements { fragment_id: "frag-mistake-counting-marks" }
  placements { fragment_id: "frag-fraction-at-arrow-past-1" }
  design {
    purpose: "Place and read fractions as distances from 0."
    principles: [PRINCIPLE_NUMBER_LINE]
    rationale: "Reading a point comes before labelling every mark. The marks-not-jumps mistake comes once the child has labelled marks correctly, so they can see why it is wrong."
  }
}

worksheets {
  id: "ws-equivalent-fractions-number-line"
  home_tip: "Ask why 2/4 and 1/2 land on the same spot before checking the answer."
  max_pages: 2
  title: "Equivalent fractions on a number line"
  seed: 103
  placements { fragment_id: "frag-fraction-at-arrow" count: 2 omit_example: true stage: STAGE_REVIEW instruction: "Warm up: what fraction is at the arrow?" }
  placements { fragment_id: "frag-equivalent-on-number-lines" }
  placements { fragment_id: "frag-equivalent-missing" count: 6 }
  placements { fragment_id: "frag-mistake-counting-marks" }
  design {
    purpose: "Find equivalent fractions by seeing them at the same point."
    principles: [PRINCIPLE_PREREQUISITE_REVIEW, PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Starts by reading a fraction on a line, the skill everything after it uses. Then two lines show equivalence as position, then the boxes ask for it with no picture. The mistake at the end brings back the one error that breaks number-line reading."
  }
}

worksheets {
  id: "ws-same-amount-different-names"
  title: "Same amount, different names"
  seed: 104
  placements { fragment_id: "frag-equivalent-with-wall" }
  placements { fragment_id: "frag-equivalent-missing" }
  design {
    purpose: "Generate equivalent fractions, first with a fraction wall, then without."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "The same task twice, with the picture taken away the second time."
  }
}

worksheets {
  id: "ws-comparing-fractions"
  title: "Comparing fractions"
  home_tip: "Ask them to say which fraction is bigger, and why, before writing the sign."
  seed: 105
  placements { fragment_id: "frag-compare-same-denominator" }
  placements { fragment_id: "frag-compare-same-numerator" }
  placements { fragment_id: "frag-compare-any" }
  design {
    purpose: "Compare fractions by choosing a strategy."
    principles: [PRINCIPLE_PREREQUISITE_REVIEW, PRINCIPLE_INTERLEAVING]
    rationale: "Two special cases the child can reason about, then a mixed set that asks which case each pair is."
  }
}

worksheets {
  id: "ws-tenths-and-hundredths"
  max_pages: 2
  title: "Tenths and hundredths"
  seed: 106
  placements { fragment_id: "frag-hundredths-grid" }
  placements { fragment_id: "frag-tenths-grid" }
}

worksheets {
  id: "ws-arrays"
  title: "What × and ÷ mean"
  seed: 107
  placements { fragment_id: "frag-array-facts" }
  placements { fragment_id: "frag-division-facts" }
}

worksheets {
  id: "ws-facts-check"
  home_tip: "Circle the facts that took longest and practise just those tomorrow."
  max_pages: 2
  title: "Facts check"
  seed: 108
  numbering { style: STYLE_SECTION_LETTERS }
  placements { fragment_id: "frag-multiplication-facts" count: 30 }
  placements { fragment_id: "frag-division-facts" count: 15 }
  design {
    purpose: "Find which facts are not yet automatic."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

worksheets {
  id: "ws-area-models"
  max_pages: 2
  title: "Multiply with area models"
  seed: 109
  placements { fragment_id: "frag-multiplication-facts" count: 10 instruction: "Warm up: multiply." }
  placements { fragment_id: "frag-area-model-2-by-1" }
  placements { fragment_id: "frag-area-model-2-by-2" }
  design {
    purpose: "Multiply by splitting numbers by place value."
    principles: [PRINCIPLE_PREREQUISITE_REVIEW, PRINCIPLE_WORKED_EXAMPLE]
    rationale: "Every cell of an area model is a basic fact times a power of ten, so the warm-up recalls the facts the cells need."
  }
}

worksheets {
  id: "ws-add-subtract"
  title: "Add and subtract big numbers"
  seed: 110
  placements { fragment_id: "frag-column-add" }
  placements { fragment_id: "frag-column-subtract" }
}

worksheets {
  id: "ws-multiply-in-columns"
  title: "From area models to columns"
  seed: 111
  placements { fragment_id: "frag-area-model-2-by-1" count: 2 omit_example: true stage: STAGE_REVIEW }
  placements { fragment_id: "frag-column-multiply" count: 8 }
  design {
    purpose: "Move from partial products to the standard algorithm."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
  }
}

worksheets {
  id: "ws-times-as-many"
  title: "Times as many"
  seed: 112
  placements { fragment_id: "frag-multiplication-facts" count: 10 instruction: "Warm up: multiply." }
  placements { fragment_id: "frag-times-as-many" }
}

worksheets {
  id: "ws-angles"
  title: "Angles"
  seed: 113
  placements { fragment_id: "frag-classify-angles" }
  placements { fragment_id: "frag-missing-angle" }
}

worksheets {
  id: "ws-rectangles"
  max_pages: 2
  title: "Perimeter and area"
  seed: 114
  placements { fragment_id: "frag-rectangle-perimeter" }
  placements { fragment_id: "frag-rectangle-area" }
  placements { fragment_id: "frag-rectangle-missing-side" }
  design {
    purpose: "Tell area from perimeter, then use area backwards."
    principles: [PRINCIPLE_INTERLEAVING]
  }
}

worksheets {
  id: "ws-mixed-review"
  title: "Mixed review"
  seed: 115
  max_pages: 2
  numbering { style: STYLE_SECTION_LETTERS }
  placements { fragment_id: "frag-fraction-at-arrow" count: 2 omit_example: true }
  placements { fragment_id: "frag-equivalent-missing" count: 3 }
  placements { fragment_id: "frag-area-model-2-by-1" count: 2 omit_example: true }
  placements { fragment_id: "frag-classify-angles" count: 3 }
  placements { fragment_id: "frag-rectangle-area" count: 3 }
  design {
    purpose: "Bring back four units' skills weeks after they were taught."
    principles: [PRINCIPLE_INTERLEAVING, PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Spaced, mixed review keeps skills that blocked units let fade. No worked examples: the point is recall."
    references: "Rohrer and Taylor (2007), Instructional Science 35"
  }
}

worksheets {
  id: "ws-place-value"
  title: "Place value to a hundred thousand"
  seed: 116
  max_pages: 2
  placements { fragment_id: "frag-base-ten-blocks" }
  placements { fragment_id: "frag-place-value-chart" }
  design {
    purpose: "Read big numbers and the value of each digit."
    principles: [PRINCIPLE_PREREQUISITE_REVIEW, PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Blocks, then a chart, then the number alone: each step keeps less of the picture."
  }
}

worksheets {
  id: "ws-rounding"
  title: "Rounding on a number line"
  seed: 117
  placements { fragment_id: "frag-round-on-number-line" count: 6 }
}

worksheets {
  id: "ws-long-division"
  title: "Long division"
  seed: 118
  placements { fragment_id: "frag-division-facts" count: 10 stage: STAGE_REVIEW instruction: "Warm up: divide." }
  placements { fragment_id: "frag-long-division" }
  design {
    purpose: "Divide with remainders."
    principles: [PRINCIPLE_PREREQUISITE_REVIEW]
    rationale: "Every step of long division is a division fact, so the warm-up recalls them first."
  }
}

worksheets {
  id: "ws-time"
  title: "Telling time and elapsed time"
  home_tip: "Ask what time it will be in 15 minutes, using a real clock at home."
  max_pages: 2
  seed: 119
  placements { fragment_id: "frag-read-clock" }
  placements { fragment_id: "frag-elapsed-time" }
}

worksheets {
  id: "ws-measure-and-plot"
  title: "Measure, then plot"
  seed: 120
  max_pages: 2
  placements { fragment_id: "frag-measure-with-ruler" }
  placements { fragment_id: "frag-line-plot" }
}

worksheets {
  id: "ws-protractor"
  title: "Measuring angles"
  seed: 121
  placements { fragment_id: "frag-classify-angles" count: 3 stage: STAGE_REVIEW instruction: "Warm up: tick acute, right or obtuse." }
  placements { fragment_id: "frag-read-protractor" }
}

worksheets {
  id: "ws-lines-and-rays"
  title: "Lines, rays and segments"
  seed: 122
  placements { fragment_id: "frag-name-figures" count: 4 }
  placements { fragment_id: "frag-name-line-pairs" }
}

worksheets {
  id: "ws-factors-and-multiples"
  title: "Factors and multiples"
  seed: 123
  max_pages: 2
  placements { fragment_id: "frag-shade-multiples" }
  placements { fragment_id: "frag-factor-pairs" }
}
