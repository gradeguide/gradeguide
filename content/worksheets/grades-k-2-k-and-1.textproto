# proto-file: worksheet/proto/v1/worksheet.proto
# proto-message: gradeguide.worksheet.v1.Library
#
# Kindergarten and grade 1 sheets. An adult reads the directions aloud;
# the student counts, writes numbers and marks answers.

# Kindergarten: counting and cardinality.

fragments {
  id: "frag-gk-count-dots-to-10"
  instruction: "Count. Write how many."
  stage: STAGE_INTRODUCE
  example { item { count_objects { count { min: 4 max: 4 } picture: PICTURE_GROUPS } } seed: 1 text: "1, 2, 3, 4. There are **4**." }
  items { kind { count_objects { count { min: 1 max: 10 } picture: PICTURE_GROUPS } } count: 5 }
  design {
    purpose: "Count up to 10 objects and write how many."
    principles: [PRINCIPLE_WORKED_EXAMPLE, PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Pictures come in small groups of two to five, so students can keep track of which ones they have counted. Counts stay at 10 or under, the range kindergarten expects for counting objects. Writing the numeral after counting links the count to its written form."
    misconceptions: "Counts one picture twice or skips a picture."
    misconceptions: "Says the numbers faster or slower than the pointing, so the count and the pictures do not match."
    misconceptions: "Counts again from 1 when asked how many, instead of giving the last number said."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
    references: "Gelman and Gallistel (1978), The Child's Understanding of Number, Harvard University Press"
  }
}

fragments {
  id: "frag-gk-count-dots-to-20"
  instruction: "Count the dots. Write how many."
  stage: STAGE_PRACTICE
  items { kind { count_objects { count { min: 11 max: 20 } } } count: 4 }
  design {
    purpose: "Count up to 20 dots in a line or in rows, and write the number."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "The dots appear in a line or in rows, the two arrangements in which kindergarten students count up to 20. A row arrangement lets students count row by row and keep their place. Numbers from 11 to 20 also practise writing the teen numerals."
    misconceptions: "Loses track of the start in a line of dots and counts some twice."
    misconceptions: "Writes a teen number in the order it is said, such as 41 for fourteen."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-gk-ten-frames"
  instruction: "Write how many counters."
  stage: STAGE_PRACTICE
  example { item { count_objects { count { min: 14 max: 14 } picture: PICTURE_TEN_FRAME } } seed: 1 text: "10 and 4 more. There are **14**." }
  items { kind { count_objects { count { min: 3 max: 20 } picture: PICTURE_TEN_FRAME } } count: 4 }
  design {
    purpose: "Read numbers up to 20 from ten frames, seeing 5 and 10 without counting each counter."
    principles: [PRINCIPLE_WORKED_EXAMPLE, PRINCIPLE_CONCRETENESS_FADING, PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "A ten frame shows a number against the benchmarks 5 and 10, because each row holds 5 and a full frame holds 10. The worked example models counting on from a full frame. Numbers above 10 show a teen number as 10 and some more, which prepares for teen place value."
    misconceptions: "Counts every counter from 1 instead of seeing a full frame as 10."
    misconceptions: "Counts the empty squares as well as the counters."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-gk-one-more"
  instruction: "Write how many counters. Then write one more."
  stage: STAGE_PRACTICE
  items { kind { count_objects { count { min: 1 max: 9 } mode: MODE_ONE_MORE picture: PICTURE_TEN_FRAME } } count: 3 }
  design {
    purpose: "Write the number that is one more than a counted number."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Each count is shown in a ten frame with an empty square next in line, so one more counter has a place to go. Students write the count, then the next number. This shows that each number in the counting sequence is one more than the number before it."
    misconceptions: "Writes the same number again for one more."
    misconceptions: "Counts all the counters again from 1 to find one more, instead of saying the next number."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-gk-count-on"
  instruction: "Write the missing numbers."
  stage: STAGE_PRACTICE
  items { kind { count_sequence { start { min: 3 max: 94 } steps: [1] } } count: 4 }
  design {
    purpose: "Count forward by ones from a number other than 1, up to 100."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Each sequence starts partway through the count, so students cannot recite from 1. Some sequences cross a decade, such as 28, 29, 30, where errors are most common. One later number is printed so students can check their place."
    misconceptions: "After a number ending in 9, writes the wrong decade, such as 20 or 210 after 29."
    misconceptions: "Starts again from 1 instead of counting on from the number given."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-gk-hundred-chart"
  instruction: "Write the missing numbers."
  max_columns: 1
  stage: STAGE_PRACTICE
  items { kind { count_sequence { start { min: 1 max: 61 } chart: true } } count: 2 }
  design {
    purpose: "Count to 100 by ones on a hundred chart."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "The missing numbers form a path along a row and down a column. Along a row the numbers go up by one. Down a column the tens digit goes up by one and the ones digit stays the same, which shows the pattern in counting to 100."
    misconceptions: "Writes the number to the left plus one at the start of a row, where the number above plus ten is the easier check."
    misconceptions: "Reverses the digits, such as 31 for 13."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-gk-count-by-tens"
  instruction: "Count by tens. Write the missing numbers."
  stage: STAGE_PRACTICE
  items { kind { count_sequence { start { min: 10 max: 50 } steps: [10] } } count: 2 }
  design {
    purpose: "Count by tens to 100."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Counting by tens is the second counting skill kindergarten asks for, after counting by ones. Starting at different tens keeps students from reciting from 10."
    misconceptions: "Counts by ones after the first ten, such as 10, 20, 21."
    misconceptions: "Writes 100 as 1000 or 010."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-gk-compare-groups"
  instruction: "Mark the row with more dots. Mark same if they are equal."
  stage: STAGE_PRACTICE
  items { kind { count_objects { count { min: 2 max: 10 } mode: MODE_COMPARE_GROUPS } } count: 6 }
  design {
    purpose: "Tell whether one group has more, fewer or the same number as another."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "The two rows of dots start at the same place and are evenly spaced, so students can match the dots one to one or count each row. About one item in five has equal rows, so same is a real answer and not a trick."
    misconceptions: "Judges by how long a row looks rather than by how many dots it has."
    misconceptions: "Thinks two groups cannot be the same and always marks A or B."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-gk-greater-number"
  instruction: "Mark the greater number."
  stage: STAGE_PRACTICE
  items { kind { compare_numbers { numbers { min: 1 max: 10 } } } count: 10 }
  design {
    purpose: "Tell which of two numbers from 1 to 10 is greater."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Students compare written numerals without pictures, after comparing groups of dots in the section before. The greater number is the one said later when counting. Pairs that differ by 1 make students think about the order of the counting sequence."
    misconceptions: "Chooses the number that is written first or looks bigger."
    misconceptions: "Thinks 10 is less than 9 because 1 is less than 9."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

# Kindergarten: operations.

fragments {
  id: "frag-gk-add-pictures"
  instruction: "Count all the pictures. Write how many in all."
  stage: STAGE_INTRODUCE
  example { item { add_subtract_fact { max: 6 op: OP_ADD pictures: true } } seed: 3 text: "5 and 1 make **6**." }
  items { kind { add_subtract_fact { max: 10 op: OP_ADD pictures: true } } count: 4 }
  design {
    purpose: "Add two groups of pictures with a total up to 10."
    principles: [PRINCIPLE_WORKED_EXAMPLE, PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Each group sits in its own frame, so the two addends stay visible as two parts of the whole. The equation under the pictures connects putting groups together with the + sign. Students may count all the pictures or count on from the first group."
    misconceptions: "Counts only one group and writes that number as the total."
    misconceptions: "Writes one of the two numbers in the equation instead of the total."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-gk-subtract-pictures"
  instruction: "Write how many are left."
  stage: STAGE_GUIDED
  items { kind { add_subtract_fact { max: 10 op: OP_SUBTRACT pictures: true } } count: 4 }
  design {
    purpose: "Subtract within 10 by counting the pictures that are not crossed out."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Crossed-out pictures show the amount taken away, while still showing the whole the subtraction starts from. Students count what is left and match it to the equation."
    misconceptions: "Counts the crossed-out pictures instead of the pictures left."
    misconceptions: "Counts every picture, crossed out or not."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-gk-word-problems"
  instruction: "Listen to the story. Draw or write to solve."
  stage: STAGE_APPLY
  max_columns: 1
  design {
    purpose: "Solve adding and taking-away stories within 10."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "An adult reads each story aloud, so reading does not stand in the way of the mathematics. Kindergarten students solve stories by acting them out or drawing, so the working space is blank and an answer may be a drawing or a number. Two stories put together and two take away."
    misconceptions: "Adds both numbers in every story, including take-away stories."
    misconceptions: "Draws the objects in detail and loses track of how many."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
    references: "Carpenter, Fennema, Franke, Levi and Empson (1999), Children's Mathematics: Cognitively Guided Instruction, Heinemann"
  }
  items {
    count: 4
    authored {
      items {
        nodes { text: "Mia has 4 red apples and 3 green apples. How many apples does she have?" }
        nodes { work_space { rows: 4 field { label: "apples Mia has" answer { text: "7" work: "4 + 3" also: "7 apples" } } } }
      }
      items {
        nodes { text: "There are 9 ducks in the pond. 5 ducks swim away. How many ducks are left?" }
        nodes { work_space { rows: 4 field { label: "ducks left" answer { text: "4" work: "9 − 5" also: "4 ducks" } } } }
      }
      items {
        nodes { text: "Ben has 6 toy cars. He gets 2 more. How many cars does Ben have now?" }
        nodes { work_space { rows: 4 field { label: "cars Ben has" answer { text: "8" work: "6 + 2" also: "8 cars" } } } }
      }
      items {
        nodes { text: "There are 10 cookies on a plate. Kai eats 3. How many cookies are left?" }
        nodes { work_space { rows: 4 field { label: "cookies left" answer { text: "7" work: "10 − 3" also: "7 cookies" } } } }
      }
    }
  }
}

fragments {
  id: "frag-gk-facts-within-5"
  instruction: "Add or subtract."
  stage: STAGE_PRACTICE
  items { kind { add_subtract_fact { max: 5 op: OP_MIXED } } count: 12 }
  design {
    purpose: "Add and subtract within 5 fluently."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE, PRINCIPLE_INTERLEAVING]
    rationale: "Facts within 5 are the facts kindergarten expects students to know fluently. Adding and subtracting are mixed, so students read each sign. Facts with 0 are included because they come up in later work."
    misconceptions: "Adds when the sign is minus, because most practice so far has been adding."
    misconceptions: "Thinks subtracting 0 or adding 0 changes the number."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-gk-facts-within-10"
  instruction: "Add or subtract."
  stage: STAGE_PRACTICE
  items { kind { add_subtract_fact { max: 10 op: OP_MIXED } } count: 10 }
  design {
    purpose: "Add and subtract within 10."
    principles: [PRINCIPLE_INTERLEAVING]
    rationale: "These facts extend the within-5 facts above to 10, the range of kindergarten addition and subtraction. Students may count on fingers or use known facts; fluency within 10 is a grade 1 goal."
    misconceptions: "Counts the starting number again when counting on, so 6 + 2 gives 7."
    misconceptions: "Subtracts the larger number from the smaller in the wrong order."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-gk-break-apart"
  instruction: "Write the missing part."
  stage: STAGE_PRACTICE
  items { kind { equation { total { min: 3 max: 10 } mode: MODE_MISSING_PART model: MODEL_BOND } } count: 6 }
  design {
    purpose: "Break a number up to 10 into two parts in more than one way."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "A number bond shows the whole at the top and its two parts below. The same whole appears with different parts, so students see that a number can be split in several ways. The equation under each bond records the split with the whole first, as in 7 = 3 + 4."
    misconceptions: "Adds the whole and the part shown instead of finding the missing part."
    misconceptions: "Reads 7 = 3 + 4 as wrong because the answer is on the left."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-gk-make-ten"
  instruction: "Write how many more make 10."
  stage: STAGE_PRACTICE
  items { kind { equation { total { min: 10 max: 10 } mode: MODE_MISSING_PART model: MODEL_TEN_FRAME } } count: 6 }
  design {
    purpose: "Find the number that makes 10 with a number from 1 to 9."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "In a ten frame, the empty squares are the missing part, so students can count them. Pairs that make 10 are the basis of the make-ten strategy for adding within 20 in grade 1."
    misconceptions: "Writes the number of counters instead of the number of empty squares."
    misconceptions: "Counts all ten squares and writes 10."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-gk-teen-numbers"
  instruction: "Write the missing number."
  stage: STAGE_INTRODUCE
  example { item { place_value_blocks { mode: MODE_TEEN } } seed: 1 text: "10 and 6 make **16**." }
  items { kind { place_value_blocks { mode: MODE_TEEN } } count: 8 }
  design {
    purpose: "Show numbers from 11 to 19 as ten ones and some more ones."
    principles: [PRINCIPLE_WORKED_EXAMPLE, PRINCIPLE_CONCRETENESS_FADING, PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Each teen number appears as a rod of ten cubes and some single cubes, with an equation such as 14 = 10 + 4. In kindergarten the rod is ten ones joined together, not yet a unit called a ten. Half the equations give the parts and half give the whole, so students work in both directions."
    misconceptions: "Reads 14 as 1 and 4 instead of ten and 4."
    misconceptions: "Writes the teen number in the order it is said, such as 41 for fourteen."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

# Kindergarten: measurement, data and shapes.

fragments {
  id: "frag-gk-longer"
  instruction: "Mark the longer pencil."
  stage: STAGE_PRACTICE
  items { kind { length_measure { mode: MODE_LONGER } } count: 6 }
  design {
    purpose: "Compare two lengths that start at the same place."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "The pencils start at the same line, so the one that reaches further is longer. The pencils carry no unit marks, because kindergarten compares lengths directly before measuring them."
    misconceptions: "Looks only at where the pencils end and ignores where they start."
    misconceptions: "Calls the thicker or darker object longer."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
  }
}

fragments {
  id: "frag-gk-sort-shapes"
  instruction: "Count each kind of shape. Write how many."
  stage: STAGE_PRACTICE
  items { kind { shape_attributes { mode: MODE_SORT } } count: 2 }
  design {
    purpose: "Sort shapes into groups and count each group."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Each count sits beside a small picture of its shape, so students who cannot read the shape names can still do the task. Triangles appear in different turns, so students sort by shape and not by direction."
    misconceptions: "Counts a turned triangle as a different kind of shape."
    misconceptions: "Counts every shape in the row for each kind."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K–3, Categorical Data; Grades 2–5, Measurement Data"
  }
}

fragments {
  id: "frag-gk-name-shapes"
  instruction: "Circle the shapes. Write how many."
  stage: STAGE_PRACTICE
  items { kind { shape_attributes { mode: MODE_FIND } } count: 3 }
  design {
    purpose: "Find circles, triangles, squares, rectangles and hexagons of any size or turn."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "The adult reads the shape name, and a small picture of the shape appears beside it. The row mixes the target shape with others in different sizes and turns, so students must recognise the shape whatever its size or direction. Rectangles that are not squares and triangles with unequal sides are included."
    misconceptions: "Thinks a turned square is no longer a square."
    misconceptions: "Recognises a triangle only when it is equal-sided and points up."
    misconceptions: "Calls a long rectangle a square."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–6, Geometry"
  }
}

fragments {
  id: "frag-gk-sides-corners"
  instruction: "Count the sides and corners. Write how many."
  stage: STAGE_PRACTICE
  items { kind { shape_attributes { mode: MODE_SIDES_CORNERS no_names: true } } count: 4 }
  design {
    purpose: "Describe shapes by the number of sides and corners."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Counting sides and corners gives students words for comparing shapes. Every shape has as many corners as sides, which students may notice. Shape names are left out because kindergarten students are not expected to read them."
    misconceptions: "Counts the same side twice by going round the shape more than once."
    misconceptions: "Counts corners and sides as one total."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–6, Geometry"
  }
}

fragments {
  id: "frag-gk-draw-shapes"
  instruction: "Draw the shape."
  stage: STAGE_APPLY
  items { kind { shape_attributes { mode: MODE_DRAW } } count: 4 }
  design {
    purpose: "Draw triangles, squares, rectangles and hexagons."
    principles: [PRINCIPLE_SELF_EXPLANATION]
    rationale: "Drawing a shape requires attention to its sides and corners, as in the section before. A shape counts as correct when it has the right number of straight sides and is closed, even if the lines are not straight."
    misconceptions: "Leaves a gap so the shape is not closed."
    misconceptions: "Draws a square for a rectangle, or the reverse."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–6, Geometry"
  }
}

worksheets {
  id: "ws-gk-count-to-20"
  title: "Counting to 20"
  seed: 401
  max_pages: 4
  placements { fragment_id: "frag-gk-count-dots-to-10" }
  placements { fragment_id: "frag-gk-count-dots-to-20" }
  placements { fragment_id: "frag-gk-ten-frames" }
  placements { fragment_id: "frag-gk-one-more" }
  design {
    purpose: "Count up to 20 objects, write how many, and find one more."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
  }
  home_tip: "Count small objects such as spoons or buttons together, touching each one. Ask how many there are, and accept the last number counted as the answer."
}

worksheets {
  id: "ws-gk-count-on"
  title: "Counting on to 100"
  seed: 402
  max_pages: 2
  placements { fragment_id: "frag-gk-hundred-chart" }
  placements { fragment_id: "frag-gk-count-on" }
  placements { fragment_id: "frag-gk-count-by-tens" }
  design {
    purpose: "Count on by ones from any number, and count by tens."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
  home_tip: "Start counting aloud from a number other than 1, such as 27, and continue together past the next ten."
}

worksheets {
  id: "ws-gk-more-and-less"
  title: "More, fewer and the same"
  seed: 403
  max_pages: 2
  placements { fragment_id: "frag-gk-compare-groups" }
  placements { fragment_id: "frag-gk-greater-number" }
  design {
    purpose: "Compare groups of dots, then compare written numbers."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
  }
  home_tip: "Put out two small groups of objects and ask which has more. Line the objects up in pairs to check."
}

worksheets {
  id: "ws-gk-add-and-take-away"
  title: "Adding and taking away"
  seed: 404
  max_pages: 2
  placements { fragment_id: "frag-gk-add-pictures" }
  placements { fragment_id: "frag-gk-subtract-pictures" }
  placements { fragment_id: "frag-gk-word-problems" }
  design {
    purpose: "Add and take away with pictures, then in stories."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
  }
  home_tip: "Read each story aloud. A drawing of the objects in the story is a complete answer at this age."
}

worksheets {
  id: "ws-gk-facts-within-10"
  title: "Facts within 10"
  seed: 405
  max_pages: 1
  placements { fragment_id: "frag-gk-facts-within-5" }
  placements { fragment_id: "frag-gk-facts-within-10" }
  design {
    purpose: "Add and subtract within 5 fluently, then within 10."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
  home_tip: "Fingers are a sound tool for these facts. Practise the facts within 5 a few at a time until they come without counting."
}

worksheets {
  id: "ws-gk-number-partners"
  title: "Number partners and making 10"
  seed: 406
  max_pages: 1
  placements { fragment_id: "frag-gk-break-apart" }
  placements { fragment_id: "frag-gk-make-ten" }
  design {
    purpose: "Break numbers into two parts, and find the partner that makes 10."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
  }
  home_tip: "Hold up some fingers on two hands and ask how many more make 10."
}

worksheets {
  id: "ws-gk-teen-numbers"
  title: "Teen numbers"
  seed: 407
  max_pages: 2
  placements { fragment_id: "frag-gk-teen-numbers" }
  design {
    purpose: "Show each teen number as ten ones and some more ones."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
  }
  home_tip: "Make teen numbers with ten fingers and some objects, saying for example: ten and four make fourteen."
}

worksheets {
  id: "ws-gk-shapes"
  title: "Shapes"
  seed: 408
  max_pages: 3
  placements { fragment_id: "frag-gk-name-shapes" }
  placements { fragment_id: "frag-gk-sides-corners" }
  placements { fragment_id: "frag-gk-draw-shapes" }
  design {
    purpose: "Find shapes of any size or turn, count their sides and corners, and draw them."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
  }
  home_tip: "Look for circles, triangles, squares and rectangles around the home, including ones that are tilted or very small."
}

worksheets {
  id: "ws-gk-compare-and-sort"
  title: "Comparing and sorting"
  seed: 409
  max_pages: 2
  placements { fragment_id: "frag-gk-longer" }
  placements { fragment_id: "frag-gk-sort-shapes" }
  design {
    purpose: "Compare two lengths, and sort and count shapes."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
  }
  home_tip: "Line up two objects, such as a spoon and a fork, at one end and ask which is longer."
}

# Grade 1: operations and algebraic thinking.

fragments {
  id: "frag-g1-word-problems-within-20"
  instruction: "Solve. Show your work."
  stage: STAGE_APPLY
  max_columns: 1
  design {
    purpose: "Solve adding and subtracting stories within 20, with the unknown in any position."
    principles: [PRINCIPLE_INTERLEAVING]
    rationale: "The stories cover adding to, taking from, putting together and comparing, with the unknown as the result, the change or the start. Mixing the types means students must decide what each story asks rather than apply one operation to all. The working space is blank so students can draw, use a number line or write an equation."
    misconceptions: "Adds whenever a story says more, including in comparing stories."
    misconceptions: "In a start-unknown story, adds or subtracts the two numbers in the order they appear."
    misconceptions: "Answers how many in all when the story asks how many more."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
    references: "Carpenter, Fennema, Franke, Levi and Empson (1999), Children's Mathematics: Cognitively Guided Instruction, Heinemann"
  }
  items {
    count: 5
    authored {
      items {
        nodes { text: "Ana has 8 shells. She finds some more. Now she has 13 shells. How many shells did she find?" }
        nodes { work_space { field { label: "shells Ana found" answer { text: "5" work: "13 − 8" also: "5 shells" } } } }
      }
      items {
        nodes { text: "Omar has 15 stickers. Zoe has 9 stickers. How many more stickers does Omar have than Zoe?" }
        nodes { work_space { field { label: "how many more stickers Omar has" answer { text: "6" work: "15 − 9" also: "6 stickers" } } } }
      }
      items {
        nodes { text: "Some birds sat on a fence. 6 flew away. Then 7 birds were left. How many birds were on the fence at first?" }
        nodes { work_space { field { label: "birds at first" answer { text: "13" work: "7 + 6" also: "13 birds" } } } }
      }
      items {
        nodes { text: "There are 12 children on the bus. 7 are girls. The rest are boys. How many boys are on the bus?" }
        nodes { work_space { field { label: "boys on the bus" answer { text: "5" work: "12 − 7" also: "5 boys" } } } }
      }
      items {
        nodes { text: "Raj has 9 marbles. Lena has 4 more marbles than Raj. How many marbles does Lena have?" }
        nodes { work_space { field { label: "marbles Lena has" answer { text: "13" work: "9 + 4" also: "13 marbles" } } } }
      }
    }
  }
}

fragments {
  id: "frag-g1-three-addend-word-problems"
  instruction: "Solve. Show your work."
  stage: STAGE_APPLY
  max_columns: 1
  design {
    purpose: "Solve stories that add three numbers with a total up to 20."
    principles: [PRINCIPLE_INTERLEAVING]
    rationale: "Each story has three numbers to add, and two of them make 10 in two of the stories. Students can add in any order, so they may find the ten first. The contexts are familiar ones: flowers, books and pets."
    misconceptions: "Adds only the first two numbers in the story."
    misconceptions: "Loses one number when adding in a different order."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
  items {
    count: 3
    authored {
      items {
        nodes { text: "Mia picks 5 red flowers, 4 yellow flowers and 6 white flowers. How many flowers does she pick?" }
        nodes { work_space { field { label: "flowers Mia picks" answer { text: "15" work: "5 + 4 + 6" also: "15 flowers" } } } }
      }
      items {
        nodes { text: "Ben reads 3 books on Monday, 7 books on Tuesday and 2 books on Wednesday. How many books does he read?" }
        nodes { work_space { field { label: "books Ben reads" answer { text: "12" work: "3 + 7 + 2" also: "12 books" } } } }
      }
      items {
        nodes { text: "A pet shop has 8 cats, 2 dogs and 5 rabbits. How many animals does it have?" }
        nodes { work_space { field { label: "animals in the shop" answer { text: "15" work: "8 + 2 + 5" also: "15 animals" } } } }
      }
    }
  }
}

fragments {
  id: "frag-g1-add-three-numbers"
  instruction: "Add. Make a ten first."
  stage: STAGE_PRACTICE
  items { kind { add_subtract_fact { max: 20 three_addends: true } } count: 8 }
  design {
    purpose: "Add three numbers by first adding two that make 10."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Every item contains two numbers that make 10, and the pair is not always side by side. Students choose which two to add first, which uses the associative and commutative properties without naming them. Adding 10 and a one-digit number is easier than adding the numbers in order."
    misconceptions: "Adds only from left to right and misses the ten."
    misconceptions: "Adds one of the numbers twice after reordering."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-g1-turn-around"
  instruction: "Write the missing number."
  stage: STAGE_PRACTICE
  items { kind { equation { total { min: 5 max: 18 } mode: MODE_TURN_AROUND } } count: 8 }
  design {
    purpose: "Use the fact that adding in either order gives the same sum."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Each equation shows the same two numbers on both sides in a different order, with one number missing. Students can answer without computing the sum, which draws attention to the property. Doubles are left out because both orders look the same."
    misconceptions: "Writes the sum in the box instead of the missing addend."
    misconceptions: "Thinks the = sign must be followed by the answer, so an equation with sums on both sides seems wrong."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-g1-count-on-number-line"
  instruction: "Count the jumps. Write the sum."
  stage: STAGE_GUIDED
  items { kind { number_line_jumps { step: 1 end: 20 } } count: 3 }
  design {
    purpose: "Add by counting on along a number line."
    principles: [PRINCIPLE_NUMBER_LINE]
    rationale: "Each jump of 1 is drawn from the starting number, so the sum is where the jumps land. Students write the landing number on the line and in the equation, which links counting on to addition."
    misconceptions: "Counts the starting number as the first jump, giving one less than the sum."
    misconceptions: "Counts the tick marks instead of the jumps."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-g1-count-back-number-line"
  instruction: "Count the jumps back. Write the difference."
  stage: STAGE_GUIDED
  items { kind { number_line_jumps { step: 1 end: 20 subtract: true } } count: 2 }
  design {
    purpose: "Subtract by counting back along a number line."
    principles: [PRINCIPLE_NUMBER_LINE]
    rationale: "The jumps go to the left from the starting number, so subtraction is shown as counting back. This follows the counting-on items, so students see both operations on the same line."
    misconceptions: "Counts the starting number as the first jump back, giving one more than the difference."
    misconceptions: "Jumps to the right because jumps have gone right in the section before."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-g1-facts-within-20"
  instruction: "Add or subtract."
  stage: STAGE_PRACTICE
  items { kind { add_subtract_fact { max: 20 op: OP_MIXED } } count: 12 }
  design {
    purpose: "Add and subtract within 20."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE, PRINCIPLE_INTERLEAVING]
    rationale: "Facts within 20 are mixed with facts within 10, and addition with subtraction. Students may use strategies such as making ten, doubles or a related addition fact. Fluency is expected within 10 in grade 1 and within 20 in grade 2."
    misconceptions: "Counts back one too many when subtracting."
    misconceptions: "Adds when the sign is minus."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-g1-think-addition"
  instruction: "Subtract. Complete the addition fact."
  stage: STAGE_PRACTICE
  items { kind { equation { total { min: 6 max: 18 } mode: MODE_THINK_ADDITION } } count: 6 }
  design {
    purpose: "Solve a subtraction by finding the missing addend in a related addition."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Each subtraction is paired with the addition that answers it, so 13 − 8 becomes 8 + ? = 13. Students who know addition facts can use them to subtract instead of counting back. The two boxes hold the same number."
    misconceptions: "Writes the whole in the addition box instead of the missing part."
    misconceptions: "Does not see that the two answers must be equal."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

fragments {
  id: "frag-g1-true-or-false"
  instruction: "Mark true or false."
  stage: STAGE_PRACTICE
  items { kind { equation { total { min: 4 max: 15 } mode: MODE_TRUE_FALSE } } count: 8 }
  design {
    purpose: "Decide whether an equation is true by working out both sides."
    principles: [PRINCIPLE_ERROR_ANALYSIS]
    rationale: "Equations put a number or a sum on either side of the = sign, and half are false by one. Students must compare the value of both sides, which builds the meaning of = as the same as. Equations such as 9 = 4 + 5 are included because many students first read = as the answer comes next."
    misconceptions: "Reads = as the answer comes next, so 9 = 4 + 5 seems false."
    misconceptions: "Marks 2 + 9 = 1 + 11 false because 11 is not the sum of 2 and 9."
    references: "McNeil and Alibali (2005), Child Development 76"
    references: "Knuth, Stephens, McNeil and Alibali (2006), Journal for Research in Mathematics Education 37"
  }
}

fragments {
  id: "frag-g1-missing-number"
  instruction: "Write the missing number."
  stage: STAGE_PRACTICE
  items { kind { equation { total { min: 5 max: 20 } mode: MODE_MISSING_ANY } } count: 10 }
  design {
    purpose: "Find the missing number in an addition or subtraction equation."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "The missing number moves to every position, and the equation sometimes starts with the total. Students must think about how the three numbers are related rather than compute from left to right."
    misconceptions: "Adds the two numbers shown, whatever the position of the box."
    misconceptions: "In ? − 4 = 4, writes 0 instead of 8."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K, Counting and Cardinality; K–5, Operations and Algebraic Thinking"
  }
}

worksheets {
  id: "ws-g1-word-problems"
