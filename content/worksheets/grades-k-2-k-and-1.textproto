# Grade 1: operations and algebraic thinking.

fragments {
  id: "frag-g1-word-problems-within-20"
  instruction: "Solve. Show your work."
  stage: STAGE_APPLY
  max_columns: 1
  design {
    purpose: "Solve adding and subtracting stories within 20, with the unknown in any place."
    principles: [PRINCIPLE_INTERLEAVING]
    rationale: "The stories mix adding to, taking from, putting together and comparing, and the unknown is the result, the change or the start."
    misconceptions: "Adding whenever a story says \"more\"."
  }
  items {
    count: 5
    authored {
      items {
        nodes { text: "Ana has 8 shells. She finds some more. Now she has 13 shells. How many shells did she find?" }
        nodes { work_space { field { label: "shells Ana found" answer { text: "5" work: "13 − 8" also: "5 shells" } } } }
      }
      items {
        nodes { text: "Omar has 15 stickers. Zoe has 9 stickers. How many more stickers does Omar have than Zoe?" }
        nodes { work_space { field { label: "how many more stickers Omar has" answer { text: "6" work: "15 − 9" also: "6 stickers" } } } }
      }
      items {
        nodes { text: "Some birds sat on a fence. 6 flew away. Then 7 birds were left. How many birds were on the fence at first?" }
        nodes { work_space { field { label: "birds at first" answer { text: "13" work: "7 + 6" also: "13 birds" } } } }
      }
      items {
        nodes { text: "There are 12 children on the bus. 7 are girls. The rest are boys. How many boys are on the bus?" }
        nodes { work_space { field { label: "boys on the bus" answer { text: "5" work: "12 − 7" also: "5 boys" } } } }
      }
      items {
        nodes { text: "Raj has 9 marbles. Lena has 4 more marbles than Raj. How many marbles does Lena have?" }
        nodes { work_space { field { label: "marbles Lena has" answer { text: "13" work: "9 + 4" also: "13 marbles" } } } }
      }
    }
  }
}

fragments {
  id: "frag-g1-three-addend-word-problems"
  instruction: "Solve. Show your work."
  stage: STAGE_APPLY
  max_columns: 1
  design {
    purpose: "Solve stories that add three numbers with a total up to 20."
    principles: [PRINCIPLE_INTERLEAVING]
  }
  items {
    count: 3
    authored {
      items {
        nodes { text: "Mia picks 5 red flowers, 4 yellow flowers and 6 white flowers. How many flowers does she pick?" }
        nodes { work_space { field { label: "flowers Mia picks" answer { text: "15" work: "5 + 4 + 6" also: "15 flowers" } } } }
      }
      items {
        nodes { text: "Ben reads 3 books on Monday, 7 books on Tuesday and 2 books on Wednesday. How many books does he read?" }
        nodes { work_space { field { label: "books Ben reads" answer { text: "12" work: "3 + 7 + 2" also: "12 books" } } } }
      }
      items {
        nodes { text: "A pet shop has 8 cats, 2 dogs and 5 rabbits. How many animals does it have?" }
        nodes { work_space { field { label: "animals in the shop" answer { text: "15" work: "8 + 2 + 5" also: "15 animals" } } } }
      }
    }
  }
}

fragments {
  id: "frag-g1-add-three-numbers"
  instruction: "Add. Look for two numbers that make 10."
  stage: STAGE_PRACTICE
  items { kind { add_subtract_fact { max: 20 three_addends: true } } count: 8 }
  design {
    purpose: "Add three numbers with a total up to 20."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

fragments {
  id: "frag-g1-turn-around"
  instruction: "Fill in the missing number."
  stage: STAGE_PRACTICE
  explainer: "You can add in any order: 3 + 8 is the same as 8 + 3."
  items { kind { equation { total { min: 5 max: 18 } mode: MODE_TURN_AROUND } } count: 8 }
  design {
    purpose: "Use adding in any order to make adding easier."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
  }
}

fragments {
  id: "frag-g1-count-on-number-line"
  instruction: "Count the jumps. Write the answer."
  stage: STAGE_GUIDED
  explainer: "Start at the arrow. Each jump is 1."
  items { kind { number_line_jumps { step: 1 end: 20 } } count: 3 }
  design {
    purpose: "Add by counting on along a number line."
    principles: [PRINCIPLE_NUMBER_LINE]
    misconceptions: "Counting the starting number as the first jump."
  }
}

fragments {
  id: "frag-g1-count-back-number-line"
  instruction: "Count the jumps back. Write the answer."
  stage: STAGE_GUIDED
  items { kind { number_line_jumps { step: 1 end: 20 subtract: true } } count: 2 }
  design {
    purpose: "Subtract by counting back along a number line."
    principles: [PRINCIPLE_NUMBER_LINE]
  }
}

fragments {
  id: "frag-g1-facts-within-20"
  instruction: "Add or subtract."
  stage: STAGE_PRACTICE
  items { kind { add_subtract_fact { max: 20 op: OP_MIXED } } count: 12 }
  design {
    purpose: "Add and subtract within 20, and know the facts within 10."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE, PRINCIPLE_INTERLEAVING]
  }
}

fragments {
  id: "frag-g1-think-addition"
  instruction: "Use an addition fact to subtract."
  stage: STAGE_PRACTICE
  items { kind { equation { total { min: 6 max: 18 } mode: MODE_THINK_ADDITION } } count: 6 }
  design {
    purpose: "Solve a subtraction by finding the missing number in an addition."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
}

fragments {
  id: "frag-g1-true-or-false"
  instruction: "Is it true or false? Tick one."
  stage: STAGE_PRACTICE
  explainer: "The = sign means both sides are worth the same."
  items { kind { equation { total { min: 4 max: 15 } mode: MODE_TRUE_FALSE } } count: 8 }
  design {
    purpose: "Decide whether an equation is true by working out both sides."
    principles: [PRINCIPLE_ERROR_ANALYSIS]
    misconceptions: "Reading = as \"the answer comes next\", so 7 = 7 or 9 = 4 + 5 looks wrong."
  }
}

fragments {
  id: "frag-g1-missing-number"
  instruction: "Fill in the missing number."
  stage: STAGE_PRACTICE
  items { kind { equation { total { min: 5 max: 20 } mode: MODE_MISSING_ANY } } count: 10 }
  design {
    purpose: "Find the missing number in an addition or subtraction equation."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
  }
}

