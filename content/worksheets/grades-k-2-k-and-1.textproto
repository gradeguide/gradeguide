    principles: [PRINCIPLE_CONCRETENESS_FADING]
  }
}

worksheets {
  id: "ws-g1-tally-charts"
  title: "Tally charts"
  seed: 421
  max_pages: 1
  placements { fragment_id: "frag-g1-tally" }
  design {
    purpose: "Answer questions from data in three groups."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
}

worksheets {
  id: "ws-g1-shapes-and-shares"
  title: "Shapes, halves and fourths"
  seed: 422
  max_pages: 2
  placements { fragment_id: "frag-g1-shape-features" }
  placements { fragment_id: "frag-g1-equal-or-not" }
  placements { fragment_id: "frag-g1-halves-fourths" }
