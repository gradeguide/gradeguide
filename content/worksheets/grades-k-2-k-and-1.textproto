    principles: [PRINCIPLE_CONCRETENESS_FADING]
  }
  home_tip: "Bundle sticks or straws in tens, then count a pile as tens and ones."
}

worksheets {
  id: "ws-g1-compare-two-digit"
  title: "Comparing two-digit numbers"
  seed: 417
  max_pages: 1
  placements { fragment_id: "frag-g1-compare-two-digit" }
  design {
    purpose: "Compare two-digit numbers by their tens, then their ones."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
  home_tip: "Compare two numbers by asking which has more tens. Compare the ones only when the tens are the same."
}

worksheets {
  id: "ws-g1-add-subtract-tens"
  title: "Adding and subtracting with tens"
  seed: 418
  max_pages: 2
  placements { fragment_id: "frag-g1-plus-ones" }
  placements { fragment_id: "frag-g1-plus-tens" }
  placements { fragment_id: "frag-g1-chart-ten-more-less" }
  placements { fragment_id: "frag-g1-ten-more-less" }
  placements { fragment_id: "frag-g1-subtract-tens" }
  design {
    purpose: "Add within 100, find 10 more and 10 less, and subtract tens."
    principles: [PRINCIPLE_INTERLEAVING]
  }
  home_tip: "Name a number such as 46 and ask for 10 more and 10 less. Only the tens digit changes."
}

# Grade 1: measurement, data and shapes.

fragments {
  id: "frag-g1-order-three"
  instruction: "Mark the longest pencil. Mark the shortest pencil."
  stage: STAGE_PRACTICE
  items { kind { length_measure { mode: MODE_ORDER_THREE } } count: 4 }
  design {
    purpose: "Order three lengths from longest to shortest."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "The three pencils start at the same line and carry no unit marks, so students compare them directly. Finding both the longest and the shortest places all three in order."
    misconceptions: "Marks the same pencil as longest and shortest."
    misconceptions: "Compares where the pencils end without checking that they start together."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
  }
}

fragments {
  id: "frag-g1-count-units"
  instruction: "Write how many cubes long."
  stage: STAGE_PRACTICE
  items { kind { length_measure { mode: MODE_COUNT_UNITS } } count: 3 }
  design {
    purpose: "Measure a length by counting equal units laid end to end."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "A row of cubes lies under each pencil, starting where the pencil starts, with no gaps and no overlaps. Students count the cubes to give the length in units. This is the model of measuring that rulers build on in grade 2."
    misconceptions: "Counts the lines between cubes instead of the cubes."
    misconceptions: "Thinks units may have gaps or overlap and still give the length."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
  }
}

fragments {
  id: "frag-g1-clock-hour"
  instruction: "Write the time."
  stage: STAGE_INTRODUCE
  items { kind { clock_nearest { step: 60 } } count: 4 }
  design {
    purpose: "Tell time to the hour on an analog clock."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "On the hour, the long hand points to 12 and the short hand points to the hour. Twelve o'clock is left out because the hands lie on top of each other. Students may write 5:00 or 5 o'clock."
    misconceptions: "Reads the long hand as the hour."
    misconceptions: "Writes 12:5 for 5 o'clock, reading both hands as numbers."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
  }
}

fragments {
  id: "frag-g1-clock-half-hour"
  instruction: "Write the time."
  stage: STAGE_PRACTICE
  items { kind { clock_nearest { step: 30 } } count: 4 }
  design {
    purpose: "Tell time to the hour and half hour."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "Half-hour times are mixed with times on the hour. At half past, the short hand is halfway between two numbers, and students must read the earlier one."
    misconceptions: "At half past, reads the hour from the number after the short hand."
    misconceptions: "Writes 3:6 for half past 3, reading the number the long hand points to."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–5, Geometric Measurement"
  }
}

fragments {
  id: "frag-g1-tally"
  instruction: "Use the tally chart. Answer the questions."
  stage: STAGE_PRACTICE
  items { kind { data_chart { mode: MODE_TALLY } } count: 2 }
  design {
    purpose: "Read a tally chart with three groups: how many in one group, how many more, and how many in all."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Tally marks are drawn in groups of five, four strokes crossed by a fifth, so students can count by fives and then ones. The three questions ask for a count, a comparison and a total, which are the questions grade 1 asks of data with up to three categories."
    misconceptions: "Counts a group of five as four, missing the crossing stroke."
    misconceptions: "Answers how many more with the larger count instead of the difference."
    references: "Common Core Standards Writing Team (2011), Progressions for the Common Core State Standards in Mathematics, K–3, Categorical Data; Grades 2–5, Measurement Data"
  }
}

fragments {
  id: "frag-g1-shape-features"
  instruction: "Count the sides and corners. Mark the name."
  stage: STAGE_PRACTICE
  items { kind { shape_attributes { mode: MODE_SIDES_CORNERS } } count: 4 }
  design {
    purpose: "Name a shape by its sides and corners, not its color, size or turn."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "The shapes include regular and irregular ones in different turns. The name follows from the number of sides, which are defining attributes, and not from how the shape looks at a glance."
    misconceptions: "Names a shape only when it looks like the usual picture, so an irregular hexagon is not a hexagon."
    misconceptions: "Counts a corner that points inward as not a corner."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–6, Geometry"
  }
}

fragments {
  id: "frag-g1-halves-fourths"
  instruction: "Mark the name of the shaded part."
  stage: STAGE_PRACTICE
  items { kind { equal_shares { denominators: [2, 4] } } count: 4 }
  design {
    purpose: "Name one of two equal shares as one half and one of four as one fourth."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Each bar is cut into two or four equal shares with one shaded. Halves and fourths of the same bar appear side by side, so students can see that a fourth is smaller than a half."
    misconceptions: "Thinks one fourth is bigger than one half because 4 is bigger than 2."
    misconceptions: "Names the share by the number of parts left unshaded."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–6, Geometry"
  }
}

fragments {
  id: "frag-g1-equal-or-not"
  instruction: "Mark equal shares or not equal shares."
  stage: STAGE_PRACTICE
  items { kind { equal_shares { denominators: [2, 4] unequal: true } } count: 4 }
  design {
    purpose: "Tell equal shares from parts that are not equal."
    principles: [PRINCIPLE_ERROR_ANALYSIS]
    rationale: "Some bars are cut into equal parts and some are not, with the same number of parts. Students must check the sizes of the parts, not only count them, before naming halves or fourths."
    misconceptions: "Calls any cut into two parts halves."
    misconceptions: "Calls parts unequal because one is shaded and the others are not."
    references: "Common Core Standards Writing Team (2012), Progressions for the Common Core State Standards in Mathematics, K–6, Geometry"
  }
}

worksheets {
