# proto-file: worksheet/proto/v1/worksheet.proto
# proto-message: gradeguide.worksheet.v1.Library
#
# Kindergarten and grade 1 sheets. A grown-up reads the instructions aloud;
# the child counts, writes numbers and ticks answers.

# Kindergarten: counting and cardinality.

fragments {
  id: "frag-gk-count-dots-to-10"
  instruction: "Count the pictures. Write how many."
  stage: STAGE_INTRODUCE
  explainer: "Touch each picture once as you count. The last number you say tells how many."
  example { item { count_objects { count { min: 4 max: 4 } picture: PICTURE_GROUPS } } seed: 1 text: "Touch and count: 1, 2, 3, 4. There are **4**." }
  items { kind { count_objects { count { min: 1 max: 10 } picture: PICTURE_GROUPS } } count: 6 }
  design {
    purpose: "Count up to 10 things in small groups, one number for each, and write how many."
    principles: [PRINCIPLE_WORKED_EXAMPLE, PRINCIPLE_CONCRETENESS_FADING]
    misconceptions: "Counting a picture twice or skipping one."
    misconceptions: "Recounting from 1 when asked how many, instead of using the last number said."
  }
}

fragments {
  id: "frag-gk-count-dots-to-20"
  instruction: "Count the dots. Write how many."
  stage: STAGE_PRACTICE
  items { kind { count_objects { count { min: 11 max: 20 } } } count: 4 }
  design {
    purpose: "Count up to 20 dots in a line or in rows, and write the number."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    rationale: "The dots come in a line and in rows, so the child keeps track of what has been counted in more than one arrangement."
  }
}

fragments {
  id: "frag-gk-ten-frames"
  instruction: "How many counters? Write the number."
  stage: STAGE_PRACTICE
  explainer: "A full ten frame is 10. Count on from 10 for the second frame."
  items { kind { count_objects { count { min: 3 max: 20 } picture: PICTURE_TEN_FRAME } } count: 6 }
  design {
    purpose: "Read numbers up to 20 from ten frames, seeing 5 and 10 at a glance."
    principles: [PRINCIPLE_CONCRETENESS_FADING, PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    misconceptions: "Counting every counter from 1 instead of seeing a full frame as 10."
  }
}

fragments {
  id: "frag-gk-one-more"
  instruction: "Count the dots. Then write the number that is one more."
  stage: STAGE_PRACTICE
  items { kind { count_objects { count { min: 1 max: 9 } mode: MODE_ONE_MORE picture: PICTURE_TEN_FRAME } } count: 4 }
  design {
    purpose: "See that the next counting number is one more."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
  }
}

fragments {
  id: "frag-gk-count-on"
  instruction: "Count on. Write the missing numbers."
  stage: STAGE_PRACTICE
  explainer: "Start at the first number and keep counting by ones."
  items { kind { count_sequence { start { min: 3 max: 94 } steps: [1] } } count: 4 }
  design {
    purpose: "Count forward by ones from any number up to 100."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    misconceptions: "Going from 29 to 20 or 210 instead of 30."
  }
}

fragments {
  id: "frag-gk-hundred-chart"
  instruction: "Fill in the missing numbers on the hundred chart."
  max_columns: 1
  stage: STAGE_PRACTICE
  explainer: "Moving right is one more. Moving down is ten more."
  items { kind { count_sequence { start { min: 1 max: 61 } chart: true } } count: 2 }
  design {
    purpose: "Count to 100 by ones and see the tens on a hundred chart."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
}

fragments {
  id: "frag-gk-count-by-tens"
  instruction: "Count by tens. Write the missing numbers."
  stage: STAGE_PRACTICE
  items { kind { count_sequence { start { min: 10 max: 50 } steps: [10] } } count: 2 }
  design {
    purpose: "Count by tens to 100."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

fragments {
  id: "frag-gk-compare-groups"
  instruction: "Which row has more dots? Tick A, B or same."
  stage: STAGE_PRACTICE
  explainer: "Match the dots in the two rows. The row with dots left over has more."
  items { kind { count_objects { count { min: 2 max: 10 } mode: MODE_COMPARE_GROUPS } } count: 6 }
  design {
    purpose: "Tell whether one group has more, fewer or the same number as another."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    misconceptions: "Thinking the longer-looking row has more."
  }
}

fragments {
  id: "frag-gk-greater-number"
  instruction: "Tick the greater number."
  stage: STAGE_PRACTICE
  items { kind { compare_numbers { numbers { min: 1 max: 10 } } } count: 10 }
  design {
    purpose: "Tell which of two numbers from 1 to 10 is greater."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
}

# Kindergarten: operations.

fragments {
  id: "frag-gk-add-pictures"
  instruction: "Count both groups. Write the total."
  stage: STAGE_INTRODUCE
  example { item { add_subtract_fact { max: 6 op: OP_ADD pictures: true } } seed: 3 text: "Count all of them together." }
  items { kind { add_subtract_fact { max: 10 op: OP_ADD pictures: true } } count: 6 }
  design {
    purpose: "Show adding as putting two groups together."
    principles: [PRINCIPLE_WORKED_EXAMPLE, PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
}

fragments {
  id: "frag-gk-subtract-pictures"
  instruction: "Some are crossed out. Write how many are left."
  stage: STAGE_GUIDED
  items { kind { add_subtract_fact { max: 10 op: OP_SUBTRACT pictures: true } } count: 6 }
  design {
    purpose: "Show taking away by crossing out pictures."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
}

fragments {
  id: "frag-gk-word-problems"
  instruction: "Listen to the story. Draw or write to solve."
  stage: STAGE_APPLY
  max_columns: 1
  design {
    purpose: "Solve adding and taking-away stories within 10."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "A grown-up reads each story aloud. Drawing the things in the story is a good way to solve it."
  }
  items {
    count: 4
    authored {
      items {
        nodes { text: "Mia has 4 red apples and 3 green apples. How many apples does she have?" }
        nodes { work_space { rows: 4 field { label: "apples Mia has" answer { text: "7" work: "4 + 3" also: "7 apples" } } } }
      }
      items {
        nodes { text: "There are 9 ducks in the pond. 5 ducks swim away. How many ducks are left?" }
        nodes { work_space { rows: 4 field { label: "ducks left" answer { text: "4" work: "9 − 5" also: "4 ducks" } } } }
      }
      items {
        nodes { text: "Ben has 6 toy cars. He gets 2 more. How many cars does Ben have now?" }
        nodes { work_space { rows: 4 field { label: "cars Ben has" answer { text: "8" work: "6 + 2" also: "8 cars" } } } }
      }
      items {
        nodes { text: "There are 10 cookies on a plate. Kai eats 3. How many cookies are left?" }
        nodes { work_space { rows: 4 field { label: "cookies left" answer { text: "7" work: "10 − 3" also: "7 cookies" } } } }
      }
    }
  }
}

fragments {
  id: "frag-gk-facts-within-5"
  instruction: "Add or subtract."
  stage: STAGE_PRACTICE
  items { kind { add_subtract_fact { max: 5 op: OP_MIXED } } count: 12 }
  design {
    purpose: "Add and subtract within 5 quickly."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE, PRINCIPLE_INTERLEAVING]
  }
}

fragments {
  id: "frag-gk-facts-within-10"
  instruction: "Add or subtract."
  stage: STAGE_PRACTICE
  items { kind { add_subtract_fact { max: 10 op: OP_MIXED } } count: 10 }
  design {
    purpose: "Add and subtract within 10."
    principles: [PRINCIPLE_INTERLEAVING]
  }
}

fragments {
  id: "frag-gk-break-apart"
  instruction: "Fill in the missing number."
  stage: STAGE_PRACTICE
  explainer: "The top circle is the whole. The two circles under it are its parts: 5 is 2 and 3, or 4 and 1."
  items { kind { equation { total { min: 3 max: 10 } mode: MODE_MISSING_PART model: MODEL_BOND } } count: 6 }
  design {
    purpose: "Split numbers up to 10 into two parts in more than one way."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
  }
}

fragments {
  id: "frag-gk-make-ten"
  instruction: "How many more make 10?"
  stage: STAGE_PRACTICE
  items { kind { equation { total { min: 10 max: 10 } mode: MODE_MISSING_PART model: MODEL_TEN_FRAME } } count: 6 }
  design {
    purpose: "Find the number that makes 10 with a number from 1 to 9."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "The empty squares in the ten frame are the missing part."
  }
}

fragments {
  id: "frag-gk-teen-numbers"
  instruction: "Write the missing number."
  stage: STAGE_INTRODUCE
  explainer: "A long block is a ten. Each small block is a one. 14 is a ten and 4 ones."
  items { kind { place_value_blocks { mode: MODE_TEEN } } count: 8 }
  design {
    purpose: "See numbers from 11 to 19 as ten ones and some more ones."
    principles: [PRINCIPLE_CONCRETENESS_FADING, PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    misconceptions: "Reading 14 as 1 and 4 instead of a ten and 4 ones."
  }
}

# Kindergarten: measurement, data and shapes.

fragments {
  id: "frag-gk-longer"
  instruction: "Which strip is longer? Tick A or B."
  stage: STAGE_PRACTICE
  items { kind { length_measure { mode: MODE_LONGER } } count: 6 }
  design {
    purpose: "Compare two lengths that start at the same place."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
  }
}

fragments {
  id: "frag-gk-sort-shapes"
  instruction: "Sort the shapes. Count each kind."
  stage: STAGE_PRACTICE
  items { kind { shape_attributes { mode: MODE_SORT } } count: 2 }
  design {
    purpose: "Sort shapes into groups and count each group."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
  }
}

fragments {
  id: "frag-gk-name-shapes"
  instruction: "Tick the name of the shape."
  stage: STAGE_PRACTICE
  explainer: "A shape keeps its name when it is bigger, smaller or turned."
  items { kind { shape_attributes { mode: MODE_NAME } } count: 6 }
  design {
    purpose: "Name circles, triangles, squares, rectangles and hexagons of any size or turn."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    misconceptions: "Thinking a turned square is no longer a square."
  }
}

fragments {
  id: "frag-gk-sides-corners"
  instruction: "Count the sides and corners."
  stage: STAGE_PRACTICE
  items { kind { shape_attributes { mode: MODE_SIDES_CORNERS } } count: 4 }
  design {
    purpose: "Describe shapes by their sides and corners."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
  }
}

fragments {
  id: "frag-gk-draw-shapes"
  instruction: "Draw the shape."
  stage: STAGE_APPLY
  items { kind { shape_attributes { mode: MODE_DRAW } } count: 4 }
  design {
    purpose: "Draw triangles, squares, rectangles and hexagons."
    principles: [PRINCIPLE_SELF_EXPLANATION]
  }
}

