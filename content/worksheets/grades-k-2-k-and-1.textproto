    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
  home_tip: "Practise the pairs that make 10, such as 3 and 7 or 6 and 4, until they are quick."
}

worksheets {
  id: "ws-g1-facts-within-20"
  title: "Adding and subtracting within 20"
  seed: 413
