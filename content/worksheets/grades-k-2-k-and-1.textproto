# Grade 1: measurement, data and shapes.

fragments {
  id: "frag-g1-order-three"
  instruction: "Tick the longest and the shortest strip."
  stage: STAGE_PRACTICE
  items { kind { length_measure { mode: MODE_ORDER_THREE } } count: 4 }
  design {
    purpose: "Put three lengths in order."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
  }
}

fragments {
  id: "frag-g1-count-units"
  instruction: "How many units long is the strip?"
  stage: STAGE_PRACTICE
  explainer: "Each box is one unit. The units touch, with no gaps and no overlaps."
  items { kind { length_measure { mode: MODE_COUNT_UNITS } } count: 3 }
  design {
    purpose: "Measure a length by counting equal units laid end to end."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
  }
}

fragments {
  id: "frag-g1-clock-hour"
  instruction: "Write the time."
  stage: STAGE_INTRODUCE
  explainer: "The short hand shows the hour. When the long hand points to 12, it is o'clock."
  items { kind { clock_nearest { step: 60 } } count: 4 }
  design {
    purpose: "Tell time to the hour."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
  }
}

fragments {
  id: "frag-g1-clock-half-hour"
  instruction: "Write the time."
  stage: STAGE_PRACTICE
  explainer: "When the long hand points to 6, it is half past: 3:30. The short hand is halfway between two numbers."
  items { kind { clock_nearest { step: 30 } } count: 4 }
  design {
    purpose: "Tell time to the hour and half hour."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
    misconceptions: "Reading the hour from the number after the short hand at half past."
  }
}

fragments {
  id: "frag-g1-tally"
  instruction: "Use the tally chart to answer."
  stage: STAGE_PRACTICE
  explainer: "Each | is one. ||||/ is a group of 5."
  items { kind { data_chart { mode: MODE_TALLY } } count: 2 }
  design {
    purpose: "Read a chart in three groups: how many in each, how many more, how many in all."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
  }
}

fragments {
  id: "frag-g1-shape-features"
  instruction: "Count the sides and corners. Tick the name."
  stage: STAGE_PRACTICE
  items { kind { shape_attributes { mode: MODE_SIDES_CORNERS } } count: 4 }
  design {
    purpose: "Name a shape by its sides and corners, not its color, size or turn."
    principles: [PRINCIPLE_SYSTEMATIC_VARIATION]
  }
}

fragments {
  id: "frag-g1-halves-fourths"
  instruction: "What share is shaded? Tick one."
  stage: STAGE_PRACTICE
  items { kind { equal_shares { denominators: [2, 4] } } count: 4 }
  design {
    purpose: "Name one of two equal shares as one half and one of four as one fourth."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    misconceptions: "Thinking one fourth is bigger than one half because 4 is bigger than 2."
  }
}

fragments {
  id: "frag-g1-equal-or-not"
  instruction: "Are the parts equal shares? Tick one."
  stage: STAGE_PRACTICE
  items { kind { equal_shares { denominators: [2, 4] unequal: true } } count: 4 }
  design {
    purpose: "Tell equal shares from parts that are not equal."
    principles: [PRINCIPLE_ERROR_ANALYSIS]
    misconceptions: "Calling any cut into two parts halves."
  }
}

