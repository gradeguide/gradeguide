worksheets {
  id: "ws-g1-equal-sign"
  title: "The equal sign"
  seed: 414
  max_pages: 2
  placements { fragment_id: "frag-g1-true-or-false" }
  placements { fragment_id: "frag-g1-missing-number" }
  design {
    purpose: "Read = as the same as, and find missing numbers."
    principles: [PRINCIPLE_ERROR_ANALYSIS]
  }
  home_tip: "Read the = sign aloud as \"is the same as\". Equations such as 9 = 4 + 5 are true."
}

# Grade 1: number and place value.

fragments {
  id: "frag-g1-count-to-120"
  instruction: "Write the missing numbers."
  stage: STAGE_PRACTICE
  items { kind { count_sequence { start { min: 40 max: 114 } steps: [1] } } count: 8 }
  design {
    purpose: "Count and write numbers up to 120 from any starting number."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Starting numbers run from 40 to 114, so many sequences cross a decade or cross 100. Writing numbers past 100 is new in grade 1 and is where most errors occur."
    misconceptions: "Writes 101 as 1001 or 1001 as the number after 100."
    misconceptions: "After 109, writes 200 or 1010 instead of 110."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g1-chart-to-120"
  instruction: "Write the missing numbers."
  max_columns: 1
  stage: STAGE_PRACTICE
  items { kind { count_sequence { start { min: 71 max: 81 } chart: true } } count: 2 }
  design {
    purpose: "Read and write numbers up to 120 on a chart, across 100."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Each chart piece runs to 110 or 120, so the path of missing numbers crosses 100. The chart shows that the pattern of ones and tens continues past 100."
    misconceptions: "Writes 1001, 1002 for the numbers after 100."
    misconceptions: "Changes the ones digit when moving down a column."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g1-tens-units"
  instruction: "Write the missing number."
  stage: STAGE_INTRODUCE
  items { kind { place_value_blocks { number { min: 10 max: 99 } mode: MODE_UNITS } } count: 8 }
  design {
    purpose: "Understand 10 ones as one ten, and 10, 20 up to 90 as that many tens."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "The equations move between ones, tens and numbers, such as 10 ones = 1 ten and 60 = 6 tens. Treating a ten as a single unit is the central idea of grade 1 place value. The item that names 10 ones as a ten appears only once."
    misconceptions: "Writes 60 tens for 60."
    misconceptions: "Thinks a ten and ten ones are different amounts."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g1-teen-blocks"
  instruction: "Write the missing number."
  stage: STAGE_PRACTICE
  items { kind { place_value_blocks { mode: MODE_TEEN } } count: 4 }
  design {
    purpose: "Show numbers from 11 to 19 as a ten and some ones."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "These items repeat the kindergarten model, a ten rod and single cubes, now read as one ten and some ones. They connect the tens-and-ones section before to the teen numbers."
    misconceptions: "Reads 17 as 1 and 7 instead of a ten and 7 ones."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g1-read-tens-ones"
  instruction: "Write the tens, the ones and the number."
  stage: STAGE_PRACTICE
  items { kind { place_value_blocks { number { min: 21 max: 99 } mode: MODE_READ_BLOCKS } } count: 4 }
  design {
    purpose: "Read a two-digit number from its tens and ones."
    principles: [PRINCIPLE_CONCRETENESS_FADING]
    rationale: "Students count the rods and the cubes separately, then write the number. Recording the tens and ones before the number shows how each digit comes from the blocks."
    misconceptions: "Writes 3 tens and 5 ones as 305 or 8."
    misconceptions: "Counts each rod as 1 when finding the number."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g1-compare-two-digit"
  instruction: "Compare. Write <, > or =."
  stage: STAGE_PRACTICE
  items { kind { compare_numbers { numbers { min: 10 max: 99 } symbols: true } } count: 12 }
  design {
    purpose: "Compare two-digit numbers with <, > and =."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Students compare the tens first, and the ones only when the tens are equal. Some pairs have a larger ones digit in the smaller number, such as 69 and 71, which tests whether students compare by place."
    misconceptions: "Thinks 29 is greater than 31 because 9 is greater than 1."
    misconceptions: "Reverses the symbols, reading > as less than."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g1-plus-ones"
  instruction: "Add."
  max_columns: 3
  stage: STAGE_PRACTICE
  items { kind { mental_math { mode: MODE_PLUS_ONES } } count: 6 }
  design {
    purpose: "Add a one-digit number to a two-digit number, making a new ten when needed."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Some sums stay within the same ten and some make a new ten, as in 47 + 8. Students add ones to ones and, when the ones make 10 or more, add one more ten."
    misconceptions: "Writes 47 + 8 as 415 by writing the ones sum after the tens."
    misconceptions: "Adds the one-digit number to the tens digit."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g1-plus-tens"
  instruction: "Add."
  stage: STAGE_PRACTICE
  items { kind { mental_math { mode: MODE_PLUS_TENS } } count: 6 }
  design {
    purpose: "Add a multiple of 10 to a two-digit number by adding tens to tens."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Adding a multiple of 10 changes only the tens digit. Students who see this can add without counting."
    misconceptions: "Adds the tens to the ones digit, so 36 + 50 gives 41."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g1-ten-more-less"
  instruction: "Write the number."
  stage: STAGE_PRACTICE
  items { kind { mental_math { mode: MODE_TEN_MORE_LESS } } count: 6 }
  design {
    purpose: "Find 10 more or 10 less than a two-digit number without counting."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "These items follow the hundred-chart pieces, which show 10 more as the number below. Students now find 10 more or 10 less without the chart."
    misconceptions: "Changes the ones digit instead of the tens digit."
    misconceptions: "Counts on by ones ten times and loses count."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g1-chart-ten-more-less"
  instruction: "Complete the hundred chart."
  stage: STAGE_INTRODUCE
  items { kind { mental_math { mode: MODE_TEN_MORE_LESS chart: true } } count: 4 }
  design {
    purpose: "Find 1 more, 1 less, 10 more and 10 less on a piece of a hundred chart."
    principles: [PRINCIPLE_MULTIPLE_REPRESENTATIONS]
    rationale: "Each piece of the chart shows a number with the four numbers around it missing. Moving across changes the ones digit and moving up or down changes the tens digit, which prepares students to find 10 more and 10 less mentally."
    misconceptions: "Writes the number below as 1 more."
    misconceptions: "Changes the ones digit when moving up or down."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

fragments {
  id: "frag-g1-subtract-tens"
  instruction: "Subtract."
  stage: STAGE_PRACTICE
  items { kind { mental_math { mode: MODE_SUBTRACT_TENS } } count: 6 }
  design {
    purpose: "Subtract a multiple of 10 from a larger multiple of 10."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
    rationale: "Every number is a multiple of 10 from 10 to 90, so 70 − 40 can be thought of as 7 tens − 4 tens. This uses known facts within 10."
    misconceptions: "Subtracts 4 instead of 40 from 70."
    misconceptions: "Writes 3 instead of 30 for 7 tens − 4 tens."
    references: "Common Core Standards Writing Team (2015), Progressions for the Common Core State Standards in Mathematics, K–5, Number and Operations in Base Ten"
  }
}

worksheets {
  id: "ws-g1-count-to-120"
  title: "Counting to 120"
  seed: 415
  max_pages: 2
  placements { fragment_id: "frag-g1-chart-to-120" }
  placements { fragment_id: "frag-g1-count-to-120" }
  design {
    purpose: "Count on and write numbers up to 120."
    principles: [PRINCIPLE_RETRIEVAL_PRACTICE]
  }
  home_tip: "Count aloud past 100 together, from about 95 to 120, and write a few of the numbers."
}

worksheets {
