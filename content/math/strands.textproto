# proto-file: proto/graph/v1/curated.proto
# proto-message: gradeguide.graph.v1.CuratedLayer
#
# The strands and topics that group K-8 math across grades. A strand follows
# Common Core domains from grade to grade. A topic is a thread inside a
# strand, made of whole clusters. Every K-8 cluster is in exactly one topic.

strands {
  strand: STRAND_COUNTING
  name: "Counting"
  description: "Saying numbers in order, counting things, and comparing small numbers. "
    "Kindergarten."
  review { status: STATUS_DRAFT }
}
strands {
  strand: STRAND_OPERATIONS_AND_ALGEBRA
  name: "Operations and algebra"
  description: "Adding, subtracting, multiplying and dividing, then expressions, "
    "equations and functions. Kindergarten to grade 8."
  review { status: STATUS_DRAFT }
}
strands {
  strand: STRAND_NUMBER
  name: "Place value and numbers"
  description: "Place value and written methods for whole numbers and decimals, then "
    "negative and irrational numbers. Kindergarten to grade 8."
  review { status: STATUS_DRAFT }
}
strands {
  strand: STRAND_FRACTIONS_AND_RATIOS
  name: "Fractions and ratios"
  description: "What a fraction is and how to calculate with fractions, then ratios, "
    "rates, percentages and proportional relationships. Grades 3 to 7."
  review { status: STATUS_DRAFT }
}
strands {
  strand: STRAND_MEASUREMENT_AND_DATA
  name: "Measurement and data"
  description: "Length, time, money, area, angles and volume, and reading and making "
    "graphs, then statistics and probability. Kindergarten to grade 8."
  review { status: STATUS_DRAFT }
}
strands {
  strand: STRAND_GEOMETRY
  name: "Shapes and geometry"
  description: "Naming and sorting shapes, then the coordinate plane, area and volume "
    "formulas, transformations and the Pythagorean theorem. Kindergarten to grade 8."
  review { status: STATUS_DRAFT }
}
strands {
  strand: STRAND_PRACTICES
  name: "Ways of thinking"
  description: "Habits used in every grade, such as making sense of a problem and "
    "explaining an answer."
  review { status: STATUS_DRAFT }
}

