module(name = "gradeguide")

bazel_dep(name = "rules_go", version = "0.62.0")
bazel_dep(name = "gazelle", version = "0.52.2")
bazel_dep(name = "protobuf", version = "34.0.bcr.1")
bazel_dep(name = "rules_proto", version = "7.1.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.4")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_chromedp_cdproto", "com_github_chromedp_chromedp", "org_golang_google_protobuf")

# The Learning Commons Knowledge Graph export, pinned by release and content
# hash. Each release of github.com/learning-commons-org/knowledge-graph
# publishes the export at a versioned address. To move to a new release,
# change the version in both URLs and both hashes. The export is about 1 GB and
# is downloaded once into the repository cache.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

KNOWLEDGE_GRAPH_VERSION = "v1.17.0"

http_file(
    name = "knowledge_graph_nodes",
    downloaded_file_path = "nodes.jsonl",
    sha256 = "8ae4e62a17659116eebaf40d12d9f28d46be1487dfe357bd42a6c77368ed71f0",
    urls = ["https://cdn.learningcommons.org/knowledge-graph/%s/exports/nodes.jsonl" % KNOWLEDGE_GRAPH_VERSION],
)

http_file(
    name = "knowledge_graph_relationships",
    downloaded_file_path = "relationships.jsonl",
    sha256 = "e8ce6bc06d1befff9cd77bb705fd6fd4a02afd5adf20b34c50430c138a54435b",
    urls = ["https://cdn.learningcommons.org/knowledge-graph/%s/exports/relationships.jsonl" % KNOWLEDGE_GRAPH_VERSION],
)

# JavaScript and TypeScript, for the Angular website.
bazel_dep(name = "rules_nodejs", version = "6.7.7")
bazel_dep(name = "aspect_rules_js", version = "3.1.2")
bazel_dep(name = "aspect_rules_ts", version = "3.1.0")
bazel_dep(name = "aspect_rules_esbuild", version = "0.26.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

# A headless Chromium and the shared libraries it loads, so the worksheet
# PDFs and thumbnails render the same on any machine; see worksheet/chromium.
bazel_dep(name = "rules_playwright", version = "0.5.3")
bazel_dep(name = "rules_distroless", version = "0.9.4")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.23.4")
use_repo(node, "nodejs_toolchains")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", dev_dependency = True)
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm", dev_dependency = True)
use_repo(pnpm, "pnpm")

rules_ts = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext", dev_dependency = True)
rules_ts.deps(
    # rules_ts 3.1.0 has no mirror entry for TypeScript 6, so pin its hash.
    ts_integrity = "sha512-y2TvuxSZPDyQakkFRPZHKFm+KKVqIisdg9/CZwm9ftvKXLP8NRWj38/ODjNbr43SsoXqNuAisEf1GdCxqWcdBw==",
    ts_version_from = "//:package.json",
)
use_repo(rules_ts, "npm_typescript")

playwright = use_extension("@rules_playwright//playwright:extensions.bzl", "playwright")
playwright.repo(
    name = "playwright",
    playwright_version = "1.45.0",
)
use_repo(playwright, "playwright")

# The libraries Chromium links against, except glibc. rules_playwright fetches
# the browser but none of these, and without them Chromium loads the host's
# copies or fails to start. The archives are snapshots pinned to an instant,
# so the resolved packages never change under a build.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["bookworm"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian/20250801T000000Z"],
)
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["bookworm-security"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20250801T030259Z"],
)
apt.install(
    dependency_set = "chrome_deps",
    packages = [
        "libasound2",
        "libatk-bridge2.0-0",
        "libatk1.0-0",
        "libatspi2.0-0",
        "libcups2",
        "libdbus-1-3",
        "libudev1",
        "libva-drm2",
        "libva2",
        "libwayland-client0",
        "libdrm2",
        "libgbm1",
        "libexpat1",
        "libglib2.0-0",
        "libnspr4",
        "libnss3",
        "libcairo2",
        "libpango-1.0-0",
        "libx11-6",
        "libxcb1",
        "libxcomposite1",
        "libxdamage1",
        "libxext6",
        "libxfixes3",
        "libxi6",
        "libxkbcommon0",
        "libxrandr2",
    ],
    suites = [
        "bookworm",
        "bookworm-security",
    ],
)
use_repo(apt, "chrome_deps")

# Andika, the worksheets' typeface: SIL's face for early readers, whose a and
# g are drawn the way children write them. Bundled with the worksheet pages so
# screen, print and the rendered PDFs use the same font. SIL Open Font
# License; see worksheet/fonts/OFL.txt.
ANDIKA = "https://github.com/google/fonts/raw/35e77c3854970a550d9894a85aba21420813a019/ofl/andika/"

http_file(
    name = "andika_regular",
    downloaded_file_path = "Andika-Regular.ttf",
    sha256 = "202b96b1f174a4a43baefe885b40dacacb81786755efd08ed4b7704e79c45515",
    urls = [ANDIKA + "Andika-Regular.ttf"],
)

http_file(
    name = "andika_bold",
    downloaded_file_path = "Andika-Bold.ttf",
    sha256 = "4361126189a2d0e0da66999352db58aaf1b4ca940faf8a8239d725f8303d890d",
    urls = [ANDIKA + "Andika-Bold.ttf"],
)
