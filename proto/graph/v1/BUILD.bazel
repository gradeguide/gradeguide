load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "v1_proto",
    srcs = [
        "curated.proto",
        "graph.proto",
    ],
)

go_proto_library(
    name = "v1_go_proto",
    importpath = "github.com/gradeguide/gradeguide/proto/graph/v1",
    proto = ":v1_proto",
)

go_library(
    name = "v1",
    embed = [":v1_go_proto"],
    importpath = "github.com/gradeguide/gradeguide/proto/graph/v1",
)
